# =============================================================================
# Object build statements for EXECUTABLE target cplang_cpkg


#############################################
# Order-only phony target for cplang_cpkg

build cmake_object_order_depends_target_cplang_cpkg: phony || .

build CMakeFiles\cplang_cpkg.dir\src\cpkg\cpkg.cpp.obj: CXX_COMPILER__cplang_cpkg_unscanned_Release C$:\CPLANG\src\cpkg\cpkg.cpp || cmake_object_order_depends_target_cplang_cpkg
  DEFINES = -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH=1 -D_CRT_SECURE_NO_WARNINGS
  FLAGS = /DWIN32 /D_WINDOWS /EHsc /O2 /Ob2 /DNDEBUG -std:c++17 -MD /W4 /permissive- /utf-8
  INCLUDES = -IC:\CPLANG\include
  OBJECT_DIR = CMakeFiles\cplang_cpkg.dir
  OBJECT_FILE_DIR = CMakeFiles\cplang_cpkg.dir\src\cpkg
  TARGET_COMPILE_PDB = CMakeFiles\cplang_cpkg.dir\
  TARGET_PDB = bin\cpkg.pdb


# =============================================================================
# Link build statements for EXECUTABLE target cplang_cpkg


#############################################
# Link the executable bin\cpkg.exe

