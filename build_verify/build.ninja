  restat = 1

build install\local: phony CMakeFiles\install\local.util


#############################################
# Phony custom command for CMakeFiles\cplang_aot_utils

build CMakeFiles\cplang_aot_utils | ${cmake_ninja_workdir}CMakeFiles\cplang_aot_utils: phony bin\aot_vm_bridge.obj bin\jit_runtime.lib


#############################################
# Custom command for bin\aot_vm_bridge.obj

build bin\aot_vm_bridge.obj | ${cmake_ninja_workdir}bin\aot_vm_bridge.obj: CUSTOM_COMMAND C$:\CPLANG\src\aot\aot_vm_bridge.cpp C$:\CPLANG\include\aot\aot_vm_bridge.hpp
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D C:\CPLANG\build_verify && cl /c /EHsc /std:c++17 /O2 /nologo /utf-8 /MD /I"C:/CPLANG/include" /DCPLANG_AOT_NO_RAYLIB=1 /Fo"C:/CPLANG/build_verify/bin/aot_vm_bridge.obj" C:/CPLANG/src/aot/aot_vm_bridge.cpp"
  DESC = Building aot_vm_bridge.obj for AOT linker (no-RAYLIB)
  restat = 1


#############################################
# Custom command for bin\jit_runtime.lib

build bin\jit_runtime.lib | ${cmake_ninja_workdir}bin\jit_runtime.lib: CUSTOM_COMMAND bin\jit_runtime_standalone.obj
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D C:\CPLANG\build_verify && lib /OUT:"C:/CPLANG/build_verify/bin/jit_runtime.lib" C:/CPLANG/build_verify/bin/jit_runtime_standalone.obj"
  DESC = Building jit_runtime.lib for AOT linker
  restat = 1


#############################################
# Custom command for bin\jit_runtime_standalone.obj

build bin\jit_runtime_standalone.obj | ${cmake_ninja_workdir}bin\jit_runtime_standalone.obj: CUSTOM_COMMAND C$:\CPLANG\src\jit\jit_runtime_standalone.cpp
  COMMAND = C:\windows\system32\cmd.exe /C "cd /D C:\CPLANG\build_verify && cl /c /EHsc /std:c++17 /O2 /nologo /utf-8 /MD /I"C:/CPLANG/include" /Fo"C:/CPLANG/build_verify/bin/jit_runtime_standalone.obj" C:/CPLANG/src/jit/jit_runtime_standalone.cpp"
  DESC = Building jit_runtime_standalone.obj for AOT linker
  restat = 1

