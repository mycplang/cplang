build CMakeFiles\cplang_stdlib.dir\src\stdlib\stdlib.cpp.obj: CXX_COMPILER__cplang_stdlib_unscanned_Release C$:\CPLANG\src\stdlib\stdlib.cpp || cmake_object_order_depends_target_cplang_stdlib
  DEFINES = -DGRAPHICS_API_OPENGL_21 -DNO_FONT_AWESOME -DPLATFORM_DESKTOP -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH=1 -D_CRT_SECURE_NO_WARNINGS
  FLAGS = /DWIN32 /D_WINDOWS /EHsc /O2 /Ob2 /DNDEBUG -std:c++17 -MD /W4 /permissive- /utf-8
  INCLUDES = -IC:\CPLANG\include -IC:\CPLANG\third_party\raylib\src -IC:\CPLANG\third_party\raylib\src\external\glfw\include -IC:\CPLANG\third_party\imgui
  OBJECT_DIR = CMakeFiles\cplang_stdlib.dir
  OBJECT_FILE_DIR = CMakeFiles\cplang_stdlib.dir\src\stdlib
  TARGET_COMPILE_PDB = CMakeFiles\cplang_stdlib.dir\cplang_stdlib.pdb
  TARGET_PDB = cplang_stdlib.pdb

