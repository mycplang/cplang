// @名称 打方块
// @描述 打砖块消除 | 3层关卡 4种道具 粒子特效

// ═══════════════════════════════════════════════════════════════════
//  打方块 增强版 — 全栈中文
//  特性: 多层关卡 | 四种道具 | 粒子特效 | 最高分存档 | 坚固/爆炸砖块
// ═══════════════════════════════════════════════════════════════════

// ── 全局参数 ──
变量 屏宽 = 800;
变量 屏高 = 600;

变量 挡宽 = 120;
变量 挡高 = 16;
变量 挡横 = 屏宽 / 2;
变量 挡纵 = 屏高 - 50;
变量 挡速 = 10;
变量 加宽剩 = 0;

// 球体
变量 球数 = 1;
变量 球横 = [屏宽 / 2];
变量 球纵 = [屏高 / 2];
变量 球速横 = [4];
变量 球速纵 = [-5];
变量 球半 = 8;
变量 减速剩 = 0;
变量 基础球速 = 5;

// 砖块
变量 砖数 = 0;
变量 砖横 = [];
变量 砖纵 = [];
变量 砖血 = [];
变量 砖活 = [];
变量 砖色 = [];
变量 砖类 = [];  // 0=普通 1=坚固 2=爆炸
变量 待引爆 = [];

// 关卡砖块参数
变量 砖列 = 10;
变量 砖行 = 6;
变量 砖体宽 = 72;
变量 砖体高 = 20;
变量 砖距 = 3;
变量 砖起横 = 0;
变量 砖起纵 = 80;

// 道具
变量 道数 = 0;
变量 道横 = [];
变量 道纵 = [];
变量 道类 = [];   // 0=加宽 1=减速 2=双球 3=加命
变量 道宽 = 22;
变量 道高 = 22;
变量 道速 = 2;

// 粒子
变量 粒数 = 0;
变量 粒横 = [];
变量 粒纵 = [];
变量 粒速横 = [];
变量 粒速纵 = [];
变量 粒命 = [];
变量 粒色 = [];

// 游戏状态
变量 分 = 0;
变量 高分 = 0;
变量 命 = 3;
变量 关 = 1;
变量 总关 = 3;
变量 赢 = 0;
变量 输 = 0;
变量 停 = 0;
变量 运 = 1;

// ── 颜色 ──
变量 黑 = {r: 0, g: 0, b: 0, a: 255};
变量 白 = {r: 255, g: 255, b: 255, a: 255};
变量 灰 = {r: 60, g: 60, b: 60, a: 255};
变量 红 = {r: 255, g: 60, b: 60, a: 255};
变量 暗红 = {r: 180, g: 30, b: 30, a: 255};
变量 橙 = {r: 255, g: 160, b: 50, a: 255};
变量 暗橙 = {r: 180, g: 110, b: 30, a: 255};
变量 金 = {r: 255, g: 210, b: 50, a: 255};
变量 暗金 = {r: 180, g: 150, b: 30, a: 255};
变量 绿 = {r: 80, g: 220, b: 80, a: 255};
变量 暗绿 = {r: 50, g: 150, b: 50, a: 255};
变量 青 = {r: 80, g: 200, b: 255, a: 255};
变量 暗青 = {r: 40, g: 120, b: 180, a: 255};
变量 紫 = {r: 180, g: 100, b: 255, a: 255};
变量 暗紫 = {r: 120, g: 60, b: 180, a: 255};
变量 粉 = {r: 255, g: 120, b: 180, a: 255};
变量 行色 = [红, 橙, 金, 绿, 青, 紫];
变量 行暗色 = [暗红, 暗橙, 暗金, 暗绿, 暗青, 暗紫];
变量 炸色 = {r: 255, g: 40, b: 40, a: 255};

变量 板色 = {r: 80, g: 80, b: 100, a: 255};
变量 背色 = {r: 20, g: 20, b: 35, a: 255};
变量 罩色 = {r: 0, g: 0, b: 0, a: 200};

// ── 道具色 ──
变量 道色加宽 = {r: 80, g: 200, b: 255, a: 255};
变量 道色减速 = {r: 255, g: 200, b: 80, a: 255};
变量 道色双球 = {r: 80, g: 255, b: 150, a: 255};
变量 道色加命 = {r: 255, g: 80, b: 80, a: 255};
变量 道色表 = [道色加宽, 道色减速, 道色双球, 道色加命];
变量 道符表 = ["W", "S", "M", "L"];
变量 道名表 = ["加宽", "减速", "双球", "加命"];

// ═══════════════════════════════════════════════════════════════════
//  工具函数
// ═══════════════════════════════════════════════════════════════════

函数 制色(r, g, b) {
    返回 {r: r, g: g, b: b, a: 255};
}

函数 读高分() {
    变量 内 = readFile("方块高分.txt");
    如果 (!是空(内)) {
        变量 n = toInt(内);
        如果 (!是空(n) && n > 0) { 返回 n; }
    }
    返回 0;
}

函数 写高分() {
    变量 内 = toString(高分);
    writeFile("方块高分.txt", 内);
}

// ═══════════════════════════════════════════════════════════════════
//  砖块管理
// ═══════════════════════════════════════════════════════════════════

函数 添砖(格横, 格纵, hp, 砖类型, 色) {
    push(砖横, 砖起横 + 格横 * (砖体宽 + 砖距));
    push(砖纵, 砖起纵 + 格纵 * (砖体高 + 砖距));
    push(砖血, hp);
    push(砖活, 1);
    push(砖色, 色);
    push(砖类, 砖类型);
    砖数 = 砖数 + 1;
}

函数 清砖() {
    砖横 = []; 砖纵 = []; 砖血 = []; 砖活 = []; 砖色 = []; 砖类 = [];
    砖数 = 0;
}

// ═══════════════════════════════════════════════════════════════════
//  三层关卡布局
// ═══════════════════════════════════════════════════════════════════

函数 建关(关号) {
    清砖();
    砖列 = 10;
    砖体宽 = 72;
    砖体高 = 20;
    砖距 = 3;
    砖起横 = (屏宽 - 砖列 * (砖体宽 + 砖距)) / 2;
    砖起纵 = 80;

    如果 (关号 == 1) {
        砖行 = 6;
        变量 纵 = 0;
        当 (纵 < 砖行) {
            变量 横 = 0;
            当 (横 < 砖列) {
                变量 色 = 行色[纵];
                变量 砖类型 = 0;
                变量 hp = 1;
                如果 (纵 == 2 && 横 % 2 == 0) { 砖类型 = 2; 色 = 炸色; }
                如果 (纵 == 3 && 横 % 2 == 1) { 砖类型 = 1; hp = 2; 色 = 行暗色[纵]; }
                添砖(横, 纵, hp, 砖类型, 色);
                横 = 横 + 1;
            }
            纵 = 纵 + 1;
        }
    } 否则 如果 (关号 == 2) {
        砖行 = 7;
        变量 纵 = 0;
        当 (纵 < 砖行) {
            变量 横 = 0;
            当 (横 < 砖列) {
                变量 色 = 行色[纵 % 6];
                变量 砖类型 = 0;
                变量 hp = 1;
                如果 (横 % 2 == 纵 % 2) {
                    如果 (纵 >= 4) { 砖类型 = 2; 色 = 炸色; }
                    否则 如果 (纵 >= 2) { 砖类型 = 1; hp = 2; 色 = 行暗色[纵 % 6]; }
                    添砖(横, 纵, hp, 砖类型, 色);
                }
                横 = 横 + 1;
            }
            纵 = 纵 + 1;
        }
    } 否则 {
        // 关号 == 3: 菱形布局
        砖行 = 7;
        变量 中 = 5;
        变量 纵 = 0;
        当 (纵 < 砖行) {
            变量 横 = 0;
            变量 偏 = 纵 - 3;
            如果 (偏 < 0) { 偏 = -偏; }
            变量 起 = 中 - 3 + 偏;
            变量 止 = 中 + 3 - 偏;
            当 (横 < 砖列) {
                如果 (横 >= 起 && 横 <= 止) {
                    变量 色 = 行色[纵 % 6];
                    变量 砖类型 = 0;
                    变量 hp = 1;
                    如果 (横 == 中) { 砖类型 = 2; 色 = 炸色; }
                    如果 (纵 == 0 || 纵 == 砖行 - 1) { 砖类型 = 1; hp = 2; 色 = 行暗色[纵 % 6]; }
                    添砖(横, 纵, hp, 砖类型, 色);
                }
                横 = 横 + 1;
            }
            纵 = 纵 + 1;
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
//  粒子系统
// ═══════════════════════════════════════════════════════════════════

函数 生粒(横, 纵, 色) {
    变量 i = 0;
    当 (i < 8) {
        变量 速横 = getRandomValue(0, 100) - 50;
        变量 速纵 = getRandomValue(0, 100) - 50;
        速横 = 速横 / 25.0;
        速纵 = 速纵 / 25.0;
        push(粒横, 横);
        push(粒纵, 纵);
        push(粒速横, 速横);
        push(粒速纵, 速纵);
        push(粒命, 20 + getRandomValue(0, 10));
        push(粒色, 色);
        粒数 = 粒数 + 1;
        i = i + 1;
    }
}

函数 更粒() {
    变量 i = 粒数 - 1;
    当 (i >= 0) {
        粒横[i] = 粒横[i] + 粒速横[i];
        粒纵[i] = 粒纵[i] + 粒速纵[i];
        粒速纵[i] = 粒速纵[i] + 0.15;
        粒命[i] = 粒命[i] - 1;
        如果 (粒命[i] <= 0) {
            移除(粒横, i); 移除(粒纵, i);
            移除(粒速横, i); 移除(粒速纵, i);
            移除(粒命, i); 移除(粒色, i);
            粒数 = 粒数 - 1;
        }
        i = i - 1;
    }
}

函数 绘粒() {
    变量 i = 0;
    当 (i < 粒数) {
        变量 色 = 粒色[i];
        变量 透明 = 粒命[i];
        如果 (透明 > 20) { 透明 = 20; }
        色 = {r: 色.r, g: 色.g, b: 色.b, a: 透明 * 10};
        drawRectangle(粒横[i], 粒纵[i], 3, 3, 色);
        i = i + 1;
    }
}

// ═══════════════════════════════════════════════════════════════════
//  道具系统
// ═══════════════════════════════════════════════════════════════════

函数 出道(横, 纵) {
    // 25% 概率掉落道具
    如果 (getRandomValue(0, 99) < 25) {
        push(道横, 横);
        push(道纵, 纵);
        push(道类, getRandomValue(0, 3));
        道数 = 道数 + 1;
    }
}

函数 更道() {
    变量 i = 道数 - 1;
    当 (i >= 0) {
        道纵[i] = 道纵[i] + 道速;
        如果 (道纵[i] > 屏高) {
            移除(道横, i); 移除(道纵, i); 移除(道类, i);
            道数 = 道数 - 1;
        } 否则 {
            // 碰挡板
            变量 实挡宽 = 挡宽;
            如果 (加宽剩 > 0) { 实挡宽 = 挡宽 * 1.5; }
            变量 左 = 挡横 - 实挡宽 / 2;
            如果 (道纵[i] + 道高 >= 挡纵 &&
                道纵[i] <= 挡纵 + 挡高 &&
                道横[i] + 道宽 >= 左 &&
                道横[i] <= 左 + 实挡宽) {
                // 拾取
                变量 砖类型 = 道类[i];
                如果 (砖类型 == 0) { 加宽剩 = 720; }
                否则 如果 (砖类型 == 1) { 减速剩 = 720; }
                否则 如果 (砖类型 == 2) {
                    如果 (球数 < 5) {
                        push(球横, 道横[i]);
                        push(球纵, 道纵[i]);
                        push(球速横, -球速横[0]);
                        push(球速纵, 球速纵[0]);
                        球数 = 球数 + 1;
                    }
                } 否则 { 命 = 命 + 1; }
                // 拾取特效
                生粒(道横[i] + 道宽 / 2, 道纵[i] + 道高 / 2, 道色表[砖类型]);
                移除(道横, i); 移除(道纵, i); 移除(道类, i);
                道数 = 道数 - 1;
            }
        }
        i = i - 1;
    }
}

函数 绘道() {
    变量 i = 0;
    当 (i < 道数) {
        变量 砖类型 = 道类[i];
        变量 色 = 道色表[砖类型];
        drawRectangle(道横[i], 道纵[i], 道宽, 道高, 色);
        drawText(道符表[砖类型], 道横[i] + 3, 道纵[i] + 2, 14, 白);
        i = i + 1;
    }
}

// ═══════════════════════════════════════════════════════════════════
//  球体逻辑
// ═══════════════════════════════════════════════════════════════════

函数 重置球(初始横, 初始纵) {
    球横 = [初始横];
    球纵 = [初始纵];
    球速横 = [基础球速 * 0.7];
    球速纵 = [-基础球速];
    球数 = 1;
}

函数 球速比() {
    如果 (减速剩 > 0) { 返回 0.5; }
    返回 1.0;
}

函数 移球() {
    变量 比 = 球速比();
    变量 i = 球数 - 1;
    当 (i >= 0) {
        球横[i] = 球横[i] + 球速横[i] * 比;
        球纵[i] = 球纵[i] + 球速纵[i] * 比;

        // 撞墙
        如果 (球横[i] - 球半 <= 0) { 球横[i] = 球半; 球速横[i] = -球速横[i]; }
        如果 (球横[i] + 球半 >= 屏宽) { 球横[i] = 屏宽 - 球半; 球速横[i] = -球速横[i]; }
        如果 (球纵[i] - 球半 <= 0) { 球纵[i] = 球半; 球速纵[i] = -球速纵[i]; }

        // 掉底
        如果 (球纵[i] + 球半 > 屏高) {
            移除(球横, i); 移除(球纵, i);
            移除(球速横, i); 移除(球速纵, i);
            球数 = 球数 - 1;
            如果 (球数 == 0) {
                命 = 命 - 1;
                如果 (命 <= 0) { 输 = 1; }
                否则 { 重置球(屏宽 / 2, 屏高 / 2); }
            }
        }
        i = i - 1;
    }
}

函数 球碰挡() {
    变量 实宽 = 挡宽;
    如果 (加宽剩 > 0) { 实宽 = 挡宽 * 1.5; }
    变量 左 = 挡横 - 实宽 / 2;
    变量 ii = 0;
    当 (ii < 球数) {
        变量 bx = 球横[ii];
        变量 by = 球纵[ii];
        如果 (by + 球半 >= 挡纵 &&
            by - 球半 <= 挡纵 + 挡高 &&
            bx >= 左 - 球半 &&
            bx <= 左 + 实宽 + 球半) {
            球纵[ii] = 挡纵 - 球半;
            球速纵[ii] = -球速纵[ii];
            如果 (球速纵[ii] > 0) { 球速纵[ii] = -球速纵[ii]; }
            如果 (球速纵[ii] > -3) { 球速纵[ii] = -基础球速; }
            变量 hit = (bx - 左) / 实宽;
            球速横[ii] = (hit - 0.5) * 12;
        }
        ii = ii + 1;
    }
}

// ═══════════════════════════════════════════════════════════════════
//  碰撞检测
// ═══════════════════════════════════════════════════════════════════

函数 球碰砖() {
    变量 引爆 = 0;
    变量 碰了 = 0;
    变量 bi = 0;
    当 (bi < 球数) {
        变量 bx = 球横[bi];
        变量 by = 球纵[bi];
        变量 已碰 = 0;

        变量 ni = 0;
        当 (ni < 砖数 && 已碰 == 0) {
            如果 (砖活[ni]) {
                变量 左 = 砖横[ni];
                变量 上 = 砖纵[ni];
                变量 右 = 左 + 砖体宽;
                变量 下 = 上 + 砖体高;

                变量 cp横 = bx;
                变量 cp纵 = by;
                如果 (cp横 < 左) { cp横 = 左; }
                如果 (cp横 > 右) { cp横 = 右; }
                如果 (cp纵 < 上) { cp纵 = 上; }
                如果 (cp纵 > 下) { cp纵 = 下; }
                变量 dx = bx - cp横;
                变量 dy = by - cp纵;
                变量 dist2 = dx * dx + dy * dy;

                如果 (dist2 < 球半 * 球半) {

                    已碰 = 1; 碰了 = 1;
                    砖血[ni] = 砖血[ni] - 1;

                    如果 (砖血[ni] <= 0) {
                        砖活[ni] = 0;
                        分 = 分 + 10;
                        变量 砖类型 = 砖类[ni];
                        变量 原色 = 砖色[ni];
                        生粒(左 + 砖体宽 / 2, 上 + 砖体高 / 2, 原色);
                        出道(左 + 砖体宽 / 2 - 道宽 / 2, 上 + 砖体高 / 2);
                        如果 (砖类型 == 2) {
                            push(待引爆, ni);
                            引爆 = 1;
                        }
                    } 否则 {
                        砖色[ni] = 行暗色[ni % 6];
                    }

                    如果 (cp横 == 左) {
                        球速横[bi] = -球速横[bi];
                        如果 (球速横[bi] > 0) { 球速横[bi] = -球速横[bi]; }
                        球横[bi] = 左 - 球半;
                    } 否则 如果 (cp横 == 右) {
                        球速横[bi] = -球速横[bi];
                        如果 (球速横[bi] < 0) { 球速横[bi] = -球速横[bi]; }
                        球横[bi] = 右 + 球半;
                    } 否则 如果 (cp纵 == 上) {
                        球速纵[bi] = -球速纵[bi];
                        如果 (球速纵[bi] > 0) { 球速纵[bi] = -球速纵[bi]; }
                        如果 (球速纵[bi] > -基础球速) { 球速纵[bi] = -基础球速; }
                        球纵[bi] = 上 - 球半;
                    } 否则 如果 (cp纵 == 下) {
                        球速纵[bi] = -球速纵[bi];
                        如果 (球速纵[bi] < 0) { 球速纵[bi] = -球速纵[bi]; }
                        如果 (球速纵[bi] < 基础球速) { 球速纵[bi] = 基础球速; }
                        球纵[bi] = 下 + 球半;
                    } 否则 {
                        如果 (dx < 0) { dx = -dx; }
                        如果 (dy < 0) { dy = -dy; }
                        如果 (dx > dy) {
                            球速横[bi] = -球速横[bi];
                            如果 (bx < cp横) { 球横[bi] = 左 - 球半; }
                            否则 { 球横[bi] = 右 + 球半; }
                        } 否则 {
                            球速纵[bi] = -球速纵[bi];
                            如果 (by < cp纵) { 球纵[bi] = 上 - 球半; }
                            否则 { 球纵[bi] = 下 + 球半; }
                        }
                    }
                }
            }
            ni = ni + 1;
        }
        bi = bi + 1;
    }

    如果 (引爆) {
        变量 ei = 0;
        当 (ei < arrlen(待引爆)) {
            变量 炸i = 待引爆[ei];
            变量 ex = 砖横[炸i]; 变量 ey = 砖纵[炸i];
            变量 nx = ex - 砖体宽 - 砖距; 变量 px = ex + 砖体宽 + 砖距;
            变量 ny = ey - 砖体高 - 砖距; 变量 py = ey + 砖体高 + 砖距;
            变量 ji = 0;
            当 (ji < 砖数) {
                如果 (砖活[ji] && ji != 炸i) {
                    变量 jx = 砖横[ji]; 变量 jy = 砖纵[ji];
                    如果 (jx >= nx && jx <= px && jy >= ny && jy <= py) {
                        砖活[ji] = 0;
                        砖血[ji] = 0;
                        分 = 分 + 10;
                        生粒(jx + 砖体宽 / 2, jy + 砖体高 / 2, 砖色[ji]);
                        出道(jx + 砖体宽 / 2 - 道宽 / 2, jy + 砖体高 / 2);
                    }
                }
                ji = ji + 1;
            }
            ei = ei + 1;
        }
        待引爆 = [];
    }

    返回 碰了;
}

// ═══════════════════════════════════════════════════════════════════
//  游戏流程
// ═══════════════════════════════════════════════════════════════════

函数 关胜利() {
    变量 i = 0;
    当 (i < 砖数) {
        如果 (砖活[i]) { 返回 0; }
        i = i + 1;
    }
    返回 1;
}

函数 下一关() {
    关 = 关 + 1;
    如果 (关 > 总关) { 赢 = 1; 返回; }
    建关(关);
    重置球(屏宽 / 2, 屏高 * 0.7);
    待引爆 = [];
    道横 = []; 道纵 = []; 道类 = []; 道数 = 0;
    粒横 = []; 粒纵 = []; 粒速横 = []; 粒速纵 = []; 粒命 = []; 粒色 = []; 粒数 = 0;
    加宽剩 = 0; 减速剩 = 0;
}

函数 初始() {
    分 = 0; 命 = 3; 关 = 1;
    赢 = 0; 输 = 0; 停 = 0;
    加宽剩 = 0; 减速剩 = 0;
    待引爆 = [];
    道横 = []; 道纵 = []; 道类 = []; 道数 = 0;
    粒横 = []; 粒纵 = []; 粒速横 = []; 粒速纵 = []; 粒命 = []; 粒色 = []; 粒数 = 0;
    建关(1);
    重置球(屏宽 / 2, 屏高 * 0.7);
}

// ═══════════════════════════════════════════════════════════════════
//  渲染
// ═══════════════════════════════════════════════════════════════════

函数 绘挡() {
    变量 实宽 = 挡宽;
    如果 (加宽剩 > 0) {
        实宽 = 挡宽 * 1.5;
        // 加宽高亮
        变量 亮板色 = {r: 120, g: 180, b: 255, a: 255};
        drawRectangle(挡横 - 实宽 / 2, 挡纵, 实宽, 挡高, 亮板色);
    } 否则 {
        drawRectangle(挡横 - 实宽 / 2, 挡纵, 实宽, 挡高, 板色);
    }
}

函数 绘砖() {
    变量 i = 0;
    当 (i < 砖数) {
        如果 (砖活[i]) {
            drawRectangle(砖横[i], 砖纵[i], 砖体宽, 砖体高, 砖色[i]);
        }
        i = i + 1;
    }
}

函数 绘球() {
    变量 i = 0;
    当 (i < 球数) {
        drawCircle(球横[i], 球纵[i], 球半, 白);
        i = i + 1;
    }
}

函数 绘状态栏() {
    drawText("分数: " + toString(分), 20, 12, 22, 白);
    drawText("关卡: " + toString(关) + "/" + toString(总关), 200, 12, 22, 青);
    drawText("生命: " + toString(命), 380, 12, 22, 粉);
    drawText("最高: " + toString(高分), 530, 12, 22, 金);

    // 道具状态
    变量 ty = 42;
    如果 (加宽剩 > 0) {
        drawText("加宽 " + toString(加宽剩 / 60) + "s", 20, ty, 16, 道色加宽);
    }
    如果 (减速剩 > 0) {
        drawText("减速 " + toString(减速剩 / 60) + "s", 140, ty, 16, 道色减速);
    }
    如果 (停) {
        drawText("暂停中 … 按空格继续", 屏宽 / 2 - 100, 屏高 / 2 - 10, 24, 金);
    }
}

函数 绘遮(题, 副) {
    drawRectangle(0, 0, 屏宽, 屏高, 罩色);
    drawText(题, 屏宽 / 2 - 130, 屏高 / 2 - 40, 36, 金);
    drawText(副, 屏宽 / 2 - 150, 屏高 / 2 + 10, 20, 白);
}

// ═══════════════════════════════════════════════════════════════════
//  程序入口
// ═══════════════════════════════════════════════════════════════════

初始();
高分 = 读高分();
initWindow(屏宽, 屏高, "打方块 增强版");
setTargetFPS(60);

当 (运) {
    如果 (windowShouldClose()) { 运 = 0; }

    // 暂停
    如果 (isKeyPressed(键_空格)) { 停 = !停; }

    如果 (!赢 && !输 && !停) {
        // 移动挡板
        如果 (isKeyDown(键_左)) { 挡横 = 挡横 - 挡速; }
        如果 (isKeyDown(键_右)) { 挡横 = 挡横 + 挡速; }
        变量 实宽2 = 挡宽; 如果 (加宽剩 > 0) { 实宽2 = 挡宽 * 1.5; } 如果 (挡横 < 实宽2 / 2) { 挡横 = 实宽2 / 2; }
        如果 (挡横 > 屏宽 - 实宽2 / 2) { 挡横 = 屏宽 - 实宽2 / 2; }

        // 道具计时器
        如果 (加宽剩 > 0) { 加宽剩 = 加宽剩 - 1; }
        如果 (减速剩 > 0) { 减速剩 = 减速剩 - 1; }

        移球();
        球碰挡();
        球碰砖();
        更粒();
        更道();

        如果 (分 > 高分) {
            高分 = 分;
            写高分();
        }

        如果 (关胜利()) { 下一关(); }
    }

    如果 (isKeyPressed(键_R)) { 初始(); 高分 = 读高分(); }

    // 渲染
    beginDrawing();
    clearBackground(背色);
    绘砖();
    绘挡();
    绘球();
    绘粒();
    绘道();
    绘状态栏();
    如果 (赢) { 绘遮("全部通关！", "按 R 重新开始"); }
    如果 (输) { 绘遮("游戏结束", "最终分数: " + toString(分) + "  — 按 R 重来"); }
    endDrawing();
}

closeWindow();
