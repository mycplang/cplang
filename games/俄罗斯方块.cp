// @名称 俄罗斯方块
// @描述 经典下落消除 | 7种方块 旋转硬降消行加速

导入 "图形";
变量 屏宽 = 800;
变量 屏高 = 600;

变量 亮蓝 = {r:80,g:140,b:255,a:255};
变量 深蓝 = {r:15,g:15,b:35,a:255};
变量 白色 = {r:255,g:255,b:255,a:255};
变量 金色 = {r:255,g:215,b:0,a:255};
变量 灰色 = {r:150,g:150,b:160,a:255};
变量 红色 = {r:255,g:60,b:60,a:255};
变量 黑色 = {r:0,g:0,b:0,a:255};
变量 绿色 = {r:80,g:220,b:80,a:255};
变量 酸橙色 = {r:0,g:255,b:0,a:255};

函数 俄方初始化() {
    变量 g = 表();
    表设(g, "宽", 10);
    表设(g, "高", 20);
        // 初始化格子数组为0
    变量 gridArr = [];
    变量 gi = 0;
    当 (gi < 200) { push(gridArr, 0); gi = gi + 1; }
    表设(g, "格子", gridArr);
    返回 g;
}

函数 俄方取格子(g, x, y) {
    变量 idx = 整除(y, 1) * 10 + 整除(x, 1);
    变量 arr = 表取(g, "格子");
    返回 arr[idx];
}

函数 俄方设格子(g, x, y, v) {
    变量 idx = y * 10 + x;
    变量 arr = 表取(g, "格子");
    arr[idx] = v;
}

函数 俄方生成方块() {
    变量 shapes = [
        [[0,0],[1,0],[0,1],[1,1]],       // O
        [[0,0],[0,1],[0,2],[0,3]],       // I
        [[0,0],[1,0],[2,0],[2,1]],       // L
        [[0,0],[1,0],[2,0],[0,1]],       // J
        [[0,0],[1,0],[2,0],[1,1]],       // T
        [[0,0],[1,0],[1,1],[2,1]],       // S
        [[0,0],[1,0],[0,1],[1,2]]        // Z (rotated)
    ];
    变量 idx = 随机整数(0, 6);
    变量 cols = [
        {r:60,g:180,b:240,a:255},
        {r:60,g:240,b:180,a:255},
        {r:240,g:180,b:60,a:255},
        {r:60,g:120,b:240,a:255},
        {r:180,g:60,b:240,a:255},
        {r:60,g:240,b:60,a:255},
        {r:240,g:60,b:60,a:255}
    ];
    变量 t = 表();
    表设(t, "shape", shapes[idx]);
    表设(t, "x", 4);
    表设(t, "y", 0);
    表设(t, "color", cols[idx]);
    返回 t;
}

函数 俄方碰撞(g, piece, dx, dy) {
    变量 px = 表取(piece, "x") + dx;
    变量 py = 表取(piece, "y") + dy;
    变量 shape = 表取(piece, "shape");
    变量 i = 0;
    当 (i < 4) {
        变量 cell = shape[i];
        变量 cx = px + cell[0];
        变量 cy = py + cell[1];
        如果 (cx < 0 || cx >= 10 || cy >= 20) { 返回 真; }
        如果 (cy >= 0 && 俄方取格子(g, cx, cy) != 0) { 返回 真; }
        i = i + 1;
    }
    返回 假;
}

函数 俄方锁定(g, piece) {
    变量 px = 表取(piece, "x");
    变量 py = 表取(piece, "y");
    变量 shape = 表取(piece, "shape");
    变量 i = 0;
    当 (i < 4) {
        变量 cell = shape[i];
        俄方设格子(g, px + cell[0], py + cell[1], 1);
        i = i + 1;
    }
}

函数 俄方消行(g) {
    变量 score = 0;
    变量 y = 19;
    当 (y >= 0) {
        变量 full = 真;
        变量 x = 0;
        当 (x < 10) {
            如果 (俄方取格子(g, x, y) == 0) { full = 假; }
            x = x + 1;
        }
        如果 (full) {
            // 下移所有行
            变量 yy = y;
            当 (yy > 0) {
                变量 xx = 0;
                当 (xx < 10) {
                    俄方设格子(g, xx, yy, 俄方取格子(g, xx, yy - 1));
                    xx = xx + 1;
                }
                yy = yy - 1;
            }
            // 清空顶行
            变量 xx2 = 0;
            当 (xx2 < 10) {
                俄方设格子(g, xx2, 0, 0);
                xx2 = xx2 + 1;
            }
            score = score + 100;
        } 否则 {
            y = y - 1;
        }
    }
    返回 score;
}

函数 俄方旋转(piece) {
    变量 shape = 表取(piece, "shape");
    变量 newShape = [];
    变量 i = 0;
    当 (i < 4) {
        variables cell = shape[i];
        push(newShape, [-cell[1] + 2, cell[0]]);
        i = i + 1;
    }
    表设(piece, "shape", newShape);
}

// ─── 测试方块是否可以旋转 ───
函数 俄方可旋转(g, piece) {
    变量 shape = 表取(piece, "shape");
    变量 newShape = [];
    变量 i = 0;
    当 (i < 4) {
        变量 cell = shape[i];
        push(newShape, [-cell[1] + 2, cell[0]]);
        i = i + 1;
    }
    变量 px = 表取(piece, "x");
    变量 py = 表取(piece, "y");
    i = 0;
    当 (i < 4) {
        变量 cell = newShape[i];
        变量 cx = px + cell[0];
        变量 cy = py + cell[1];
        如果 (cx < 0 || cx >= 10 || cy >= 20) { 返回 假; }
        如果 (cy >= 0 && 俄方取格子(g, cx, cy) != 0) { 返回 假; }
        i = i + 1;
    }
    返回 真;
}

函数 俄方绘制游戏(g, piece, next, px, py, 格子尺寸, frame) {
    // 绘制网格
    变量 y = 0;
    当 (y < 20) {
        变量 x = 0;
        当 (x < 10) {
            变量 v = 俄方取格子(g, x, y);
            如果 (v != 0) {
                绘制矩形(px + x * 格子尺寸, py + y * 格子尺寸, 格子尺寸 - 1, 格子尺寸 - 1, 亮蓝);
            } 否则 {
                绘制矩形(px + x * 格子尺寸, py + y * 格子尺寸, 格子尺寸 - 1, 格子尺寸 - 1, {r:40,g:40,b:60,a:255});
            }
            x = x + 1;
        }
        y = y + 1;
    }
    
    // 绘制当前方块
    变量 shape = 表取(piece, "shape");
    变量 col = 表取(piece, "color");
    变量 i = 0;
    当 (i < 4) {
        变量 cell = shape[i];
        变量 cx = 表取(piece, "x") + cell[0];
        变量 cy = 表取(piece, "y") + cell[1];
        如果 (cy >= 0) {
            绘制矩形(px + cx * 格子尺寸, py + cy * 格子尺寸, 格子尺寸 - 1, 格子尺寸 - 1, col);
        }
        i = i + 1;
    }
    
    // 绘制预览
    绘制文本("下一个:", px + 11 * 格子尺寸, py, 18, 白色);
    变量 nshape = 表取(next, "shape");
    变量 ncol = 表取(next, "color");
    i = 0;
    当 (i < 4) {
        变量 cell = nshape[i];
        绘制矩形(px + 11 * 格子尺寸 + cell[0] * 格子尺寸, py + 30 + cell[1] * 格子尺寸, 格子尺寸 - 1, 格子尺寸 - 1, ncol);
        i = i + 1;
    }
}

// ─── 俄罗斯方块主函数 ───

函数 俄罗斯方块() {
    变量 格子尺寸 = 25;
    变量 棋盘宽 = 10 * 格子尺寸;
    变量 棋盘高 = 20 * 格子尺寸;
    变量 px = (屏宽 - 棋盘宽 - 160) / 2;
    变量 py = (屏高 - 棋盘高) / 2;
    
    变量 g = 俄方初始化();
    变量 piece = 俄方生成方块();
    变量 next = 俄方生成方块();
    变量 分数 = 0;
    变量 速度 = 60;
    变量 帧计数 = 0;
    
    变量 游戏结束 = 假;
    变量 暂停中 = 假;
    
    变量 gameW = 棋盘宽 + 180;
    变量 gameH = 棋盘高;
    
    变量 gw = 俄方初始化();
    
    当 (窗口应关闭() == 假 && 游戏结束 == 假) {
        开始绘制();
        清除背景(深蓝);
        
        // ESC 返回
        如果 (键盘刚按下(键_退出)) { 返回 分数; }
        
        如果 (键盘刚按下(键_P)) { 暂停中 = 暂停中 == 假; }
        
        如果 (暂停中 == 假) {
            // 控制
            如果 (键盘刚按下(键_左)) {
                如果 (俄方碰撞(g, piece, -1, 0) == 假) {
                    表设(piece, "x", 表取(piece, "x") - 1);
                }
            }
            如果 (键盘刚按下(键_右)) {
                如果 (俄方碰撞(g, piece, 1, 0) == 假) {
                    表设(piece, "x", 表取(piece, "x") + 1);
                }
            }
            如果 (键盘刚按下(键_下)) {
                如果 (俄方碰撞(g, piece, 0, 1) == 假) {
                    表设(piece, "y", 表取(piece, "y") + 1);
                }
            }
            如果 (键盘刚按下(键_上)) {
                如果 (俄方可旋转(g, piece)) {
                    俄方旋转(piece);
                }
            }
            如果 (键盘刚按下(键_空格)) {
                // 硬降
                当 (俄方碰撞(g, piece, 0, 1) == 假) {
                    表设(piece, "y", 表取(piece, "y") + 1);
                }
            }
            
            // 下落
            帧计数 = 帧计数 + 1;
            如果 (帧计数 >= 速度) {
                帧计数 = 0;
                如果 (俄方碰撞(g, piece, 0, 1)) {
                    // 锁定并检查游戏结束
                    如果 (表取(piece, "y") <= 0) {
                        游戏结束 = 真;
                    } 否则 {
                        俄方锁定(g, piece);
                        分数 = 分数 + 俄方消行(g);
                        piece = next;
                        next = 俄方生成方块();
                        速度 = 60 - 整除(分数, 500) * 5;
                        如果 (速度 < 5) { 速度 = 5; }
                    }
                } 否则 {
                    表设(piece, "y", 表取(piece, "y") + 1);
                }
            }
        }
        
        // 绘制
        俄方绘制游戏(g, piece, next, px, py, 格子尺寸, 帧计数);
        
        // 分数
        绘制文本("分数: " + toString(分数), px + 10 * 格子尺寸 + 20, py + 150, 20, 金色);
        
        如果 (暂停中) {
            绘制文本("暂停中", px + 棋盘宽 / 2 - 30, py + 棋盘高 / 2, 30, 金色);
        }
        
        如果 (游戏结束) {
            绘制文本("游戏结束!", px + 棋盘宽 / 2 - 50, py + 棋盘高 / 2, 30, 金色);
            绘制文本("分数: " + toString(分数), px + 棋盘宽 / 2 - 40, py + 棋盘高 / 2 + 35, 20, 白色);
            绘制文本("按 R 重来  ESC 返回", px + 棋盘宽 / 2 - 80, py + 棋盘高 / 2 + 65, 16, 灰色);
            如果 (键盘刚按下(键_R)) { 俄罗斯方块(); 返回 分数; }
        }
        
        结束绘制();
    }
    
    返回 分数;
}

// ═══════════════════════════════════════════════════════════════
//  主入口
// ═══════════════════════════════════════════════════════════════

初始化窗口(800, 600, "俄罗斯方块");
设置目标帧率(60);

俄罗斯方块();

关闭窗口();

