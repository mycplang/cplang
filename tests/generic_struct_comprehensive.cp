// 泛型结构体综合测试

结构体 盒子<T> {
    T 内容;
    字符串 标签;
}

结构体 对<A, B> {
    A 左;
    B 右;
}

结构体 容器<T> {
    T 数据;
    布尔 激活;
}

// 测试1: 基础泛型结构体字段访问
函数 测试基础() {
    变量 b = 盒子<整数>{ 内容: 42, 标签: "答案" };
    打印(b.内容);
    打印(b.标签);
    返回 0;
}

// 测试2: 多参数泛型
函数 测试多参数() {
    变量 p = 对<整数, 字符串>{ 左: 10, 右: "hello" };
    打印(p.左);
    打印(p.右);
    返回 0;
}

// 测试3: 字符串类型参数
函数 测试字符串参数() {
    变量 b = 盒子<字符串>{ 内容: "世界", 标签: "测试" };
    打印(b.内容);
    打印(b.标签);
    返回 0;
}

// 测试4: 布尔类型参数
函数 测试布尔参数() {
    变量 c = 容器<布尔>{ 数据: 真, 激活: 真 };
    如果 (c.数据) {
        打印("数据为真");
    }
    返回 0;
}

// 测试5: 嵌套泛型
函数 测试嵌套() {
    变量 nested = 盒子<对<整数, 字符串>>{
        内容: 对<整数, 字符串>{左: 100, 右: "嵌套"},
        标签: "嵌套测试"
    };
    打印(nested.内容.左);
    打印(nested.内容.右);
    打印(nested.标签);
    返回 0;
}

// 测试6: 泛型结构体作为函数参数
函数 处理盒子(b: 盒子<整数>) {
    打印(b.内容);
}

函数 测试传参() {
    变量 b = 盒子<整数>{ 内容: 99, 标签: "参数测试" };
    处理盒子(b);
    返回 0;
}

// 测试7: 泛型结构体字段修改
函数 测试修改() {
    变量 b = 盒子<整数>{ 内容: 1, 标签: "原始" };
    b.内容 = 999;
    打印(b.内容);
    返回 0;
}

// 测试8: 泛型结构体从函数返回
函数 创建盒子(x: 整数): 盒子<整数> {
    返回 盒子<整数>{ 内容: x, 标签: "返回" };
}

函数 测试返回() {
    变量 b = 创建盒子(777);
    打印(b.内容);
    返回 0;
}

函数 main() {
    测试基础();
    测试多参数();
    测试字符串参数();
    测试布尔参数();
    测试嵌套();
    测试传参();
    测试修改();
    测试返回();
    返回 0;
}
