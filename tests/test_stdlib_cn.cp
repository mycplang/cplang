// CP语言中文标准库测试

// 数学函数
打印("绝对值(-10) = ", 绝对值(-10));
打印("平方根(16) = ", 平方根(16));
打印("幂(2, 10) = ", 幂(2, 10));

// 字符串函数
变量 s = "Hello";
打印("长度(s) = ", 长度(s));
打印("小写(s) = ", 小写(s));
打印("大写(s) = ", 大写(s));

// 数组函数
变量 arr = [10, 20, 30];
打印("长度(arr) = ", 长度(arr));
追加(arr, 40);
打印("弹出(arr) = ", 弹出(arr));
打印("切片(arr, 0, 2) = ", 切片(arr, 0, 2));
