// 泛型约束 - 多种违反约束测试
函数 比较<T: 可比较>(a: T, b: T): 布尔 {
    返回 a == b;
}

函数 相加<T: 可相加>(a: T, b: T): T {
    返回 a + b;
}

函数 转字符串<T: 可字符串化>(x: T): 字符串 {
    返回 "" + x;
}

函数 main() {
    // 以下调用应该通过
    变量 ok1 = 比较<整数>(1, 2);
    变量 ok2 = 比较<字符串>("a", "b");
    变量 ok3 = 相加<整数>(1, 2);
    变量 ok4 = 转字符串<整数>(42);
    
    // 以下调用应该失败
    // bool 不满足"可相加"
    // 变量 bad = 相加<布尔>(true, false);
    
    返回 0;
}
