打印("=== 基本 try-catch ===");
变量 r = 0;
尝试 {
    抛出(123);
} 捕获(e) {
    r = e;
}
打印(r);

打印("=== 嵌套 ===");
尝试 {
    尝试 {
        抛出(1);
    } 捕获(e) {
        r = e + 100;
        抛出(r);
    }
} 捕获(e) {
    r = e;
}
打印(r);

打印("=== 正常路径 ===");
尝试 {
    r = 999;
} 捕获(e) {
    r = 0;
}
打印(r);

打印("=== 三层 ===");
尝试 {
    尝试 {
        尝试 {
            抛出(3);
        } 捕获(x) {
            r = x * 10;
            抛出(r);
        }
    } 捕获(y) {
        r = y * 10;
        抛出(r);
    }
} 捕获(z) {
    r = z;
}
打印(r);

打印("EXCEPTION OK");
