// Echo 服务器 - 最小诊断测试

函数 主() {
    变量 s = TCP监听(8080);
    打印("监听 OK, socket=" + toString(s));
    
    当 (1 > 0) {
        打印("等待连接...");
        变量 c = TCP接受(s);
        打印("已连接, client=" + toString(c));
        
        变量 数据 = TCP接收(c, 256);
        打印("收到: " + 数据);
        
        TCP发送(c, "你好!\n");
        TCP关闭(c);
     }
 }

主();
