// 嵌套泛型测试
// 定义基础泛型结构体
结构体 对<A, B> {
    A 第一;
    B 第二;
}

// 使用嵌套泛型的结构体
结构体 盒子<T> {
    T 内容;
    字符串 标签;
}

// 带约束的嵌套泛型
函数 打印对<T: 可字符串化, U: 可字符串化>(p: 对<T, U>) {
    打印("(", p.第一, ", ", p.第二, ")");
}

函数 main() {
    // 嵌套泛型: 盒子<对<整数, 字符串>>
    变量 nested = 盒子<对<整数, 字符串>>{
        内容: 对<整数, 字符串>{第一: 42, 第二: "hello"},
        标签: "嵌套测试"
    };
    打印(nested.标签, ": ", nested.内容.第一, " -> ", nested.内容.第二);
    
    // 泛型函数调用嵌套泛型参数
    打印对<整数, 字符串>(对<整数, 字符串>{第一: 1, 第二: "world"});
    
    返回 0;
}
