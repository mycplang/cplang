// CP语言 defer 测试
打印("=== defer 测试 ===")
打印("")

// 测试1: 基本 defer
打印("--- 测试1: 基本 defer ---")
{
    推迟 { 打印("  [defer] 离开作用域1") }
    打印("  在作用域内")
}
打印("")

// 测试2: 多个 defer（逆序执行）
打印("--- 测试2: 多个 defer（应逆序输出 C B A）---")
{
    推迟 { 打印("  [defer] A") }
    推迟 { 打印("  [defer] B") }
    推迟 { 打印("  [defer] C") }
    打印("  在作用域内")
}
打印("")

// 测试3: defer 在函数中
打印("--- 测试3: defer 在函数中 ---")
函数 测试函数() {
    推迟 { 打印("  [defer] 函数清理") }
    打印("  函数执行")
}
测试函数()
打印("")

// 测试4: defer 嵌套
打印("--- 测试4: defer 嵌套作用域 ---")
{
    推迟 { 打印("  [defer] 外层") }
    {
        推迟 { 打印("  [defer] 内层") }
        打印("  内层作用域")
    }
    打印("  外层作用域")
}
打印("")

打印("=== 测试完成 ===")
