变量 大小 = 4;
变量 格宽 = 100;
变量 边距 = 12;
变量 W = 大小 * 格宽 + 边距 * (大小 + 1);
变量 H = W + 100;
变量 格子 = [2,4,8,16, 32,64,128,256, 512,1024,2048,0, 0,0,0,0];
变量 分数 = 100;
变量 最高 = 0;
变量 赢了 = 0;
变量 输了 = 0;
变量 背景色 = {r: 187, g: 173, b: 160, a: 255};
变量 空格色 = {r: 205, g: 193, b: 180, a: 255};
变量 深字色 = {r: 119, g: 110, b: 101, a: 255};
变量 浅字色 = {r: 249, g: 246, b: 242, a: 255};
变量 遮罩色 = {r: 0, g: 0, b: 0, a: 180};
变量 hx = 边距;
变量 hy = 边距;
变量 y0 = 90;
initWindow(W, H, "2048");
setTargetFPS(60);
当 (windowShouldClose() == 0) {
    beginDrawing();
    clearBackground(背景色);
    drawRectangle(hx, hy, W - 边距*2, 56, 空格色);
    drawRectangle(0, y0 - 边距, W, W, 背景色);
    变量 idx = 0;
    当 (idx < 16) {
        变量 val = 格子[idx];
        变量 tx = 边距 + ((idx % 4) * (格宽 + 边距));
        变量 ty = y0 + (整除(idx, 4) * (格宽 + 边距));
        变量 块色 = 空格色;
        如果 (val == 2)    { 块色 = {r: 238, g: 228, b: 218, a: 255}; }
        否则 如果 (val == 4)    { 块色 = {r: 237, g: 224, b: 200, a: 255}; }
        否则 如果 (val == 8)    { 块色 = {r: 242, g: 177, b: 121, a: 255}; }
        否则 如果 (val == 16)   { 块色 = {r: 245, g: 149, b: 99, a: 255};  }
        否则 如果 (val == 32)   { 块色 = {r: 246, g: 124, b: 95, a: 255};  }
        否则 如果 (val == 64)   { 块色 = {r: 246, g: 94, b: 59, a: 255};   }
        否则 如果 (val == 128)  { 块色 = {r: 237, g: 207, b: 114, a: 255}; }
        否则 如果 (val == 256)  { 块色 = {r: 237, g: 204, b: 97, a: 255};  }
        否则 如果 (val == 512)  { 块色 = {r: 237, g: 200, b: 80, a: 255};  }
        否则 如果 (val == 1024) { 块色 = {r: 237, g: 197, b: 63, a: 255};  }
        否则 如果 (val >= 2048) { 块色 = {r: 237, g: 194, b: 46, a: 255};  }
        drawRectangle(tx, ty, 格宽, 格宽, 块色);
        idx = idx + 1;
    }
    drawText("2048", hx + 18, hy + 6, 36, 深字色);
    drawText("Score: " + 分数, W/2 + 30, hy + 10, 28, 深字色);
    idx = 0;
    当 (idx < 16) {
        变量 val = 格子[idx];
        如果 (val > 0) {
            变量 tx = 边距 + ((idx % 4) * (格宽 + 边距));
            变量 ty = y0 + (整除(idx, 4) * (格宽 + 边距));
            变量 数字 = toString(val);
            变量 位数 = len(数字);
            变量 字色 = 深字色;
            变量 tsz = 36;
            变量 tox = 42;
            变量 toy = 28;
            如果 (val >= 8) { 字色 = 浅字色; }
            如果 (位数 == 2) { tsz = 36; tox = 34; toy = 28; }
            如果 (位数 == 3) { tsz = 28; tox = 24; toy = 34; }
            如果 (位数 >= 4) { tsz = 22; tox = 14; toy = 38; }
            drawText(数字, tx + tox, ty + toy, tsz, 字色);
        }
        idx = idx + 1;
    }
    drawFPS(300, 10);
    endDrawing();
}
closeWindow();
