// 最小 ImGui 测试
初始化窗口(400, 300, "Minimal ImGui Test");
界面初始化(真);
设置目标帧率(60);

变量 计数器 = 0;
当 (窗口应关闭() == 假) {
    开始绘制();
    清除背景(30, 30, 40, 255);
    界面开始绘制();

    窗口开始("测试");
    文本("Hello ImGui!");
    如果 (按钮("点我")) { 计数器 = 计数器 + 1; }
    文本("点击: " + toString(计数器));
    窗口结束();

    界面结束绘制();
    结束绘制();
}
关闭窗口();
