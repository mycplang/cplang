打印("A");
初始化窗口(400, 300, "Render Test");
打印("B");
设置目标帧率(60);
打印("C");

变量 应关闭 = 假;
变量 帧 = 0;
当 (帧 < 120 && 应关闭 == 假) {
    开始绘图();
    清空背景(红);
    绘制圆形(200, 150, 50, 绿);
    绘制文本("RED + GREEN + WHITE", 90, 260, 16, 白);
    绘制文本("Frame: " + 帧, 10, 10, 14, 白);
    结束绘图();
    应关闭 = 窗口应关闭();
    帧 = 帧 + 1;
}
打印("D - frames: " + 帧);
关闭窗口();
打印("E - done");
