// 控制流测试

函数 最大值(a, b) {
    如果 (a > b) {
        返回 a;
    } 否则 {
        返回 b;
    }
}

函数 阶乘(n) {
    如果 (n <= 1) {
        返回 1;
    }
    返回 n * 阶乘(n - 1);
}

函数 求和(n) {
    变量 sum = 0;
    变量 i = 1;
    当 (i <= n) {
        sum = sum + i;
        i = i + 1;
    }
    返回 sum;
}

函数 主() {
    变量 a = 10;
    变量 b = 20;
    变量 max = 最大值(a, b);
    变量 fact = 阶乘(5);
    变量 sum = 求和(10);
    返回 sum;
}
