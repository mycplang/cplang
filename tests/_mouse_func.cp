// 模拟 gamehub: 主循环调函数, 函数内调鼠标
初始化窗口(640, 480, "Func Mouse Test");
设置目标帧率(60);

变量 格宽 = 40; 变量 格高 = 40;
变量 px = 100; 变量 py = 50;
变量 格 = [];
变量 i = 0; 当 (i < 100) { push(格, 0); i = i + 1; }
变量 函数内点击 = 0;
变量 直接点击 = 0;

// 模拟 gamehub: 通过函数调鼠标
函数 步进() {
    直接点击 = 鼠标刚按下();
    函数内点击 = 直接点击;
    如果 (直接点击) {
        变量 mx = 鼠标X();
        变量 my = 鼠标Y();
        如果 (mx >= px && mx < px + 格宽 * 10 && my >= py && my < py + 格高 * 10) {
            变量 gx = 整除((mx - px), 格宽);
            变量 gy = 整除((my - py), 格高);
            变量 idx = gy * 10 + gx;
            格[idx] = 1 - 格[idx];
        }
    }
}

当 (窗口应关闭() == 假) {
    开始绘制();
    清除背景({r:20,g:20,b:30,a:255});

    // 主循环先调鼠标（模拟大厅 tab bar 的行为）
    变量 大厅点击 = 鼠标刚按下();

    // 调用游戏步进
    步进();

    // 画网格
    变量 y = 0;
    当 (y < 10) {
        变量 x = 0;
        当 (x < 10) {
            变量 rx = px + x * 格宽;
            变量 ry = py + y * 格高;
            变量 idx = y * 10 + x;
            如果 (格[idx]) { drawRectangle(rx, ry, 格宽 - 1, 格高 - 1, {r:255,g:100,b:100,a:255}); }
            否则 { drawRectangle(rx, ry, 格宽 - 1, 格高 - 1, {r:180,g:180,b:200,a:255}); }
            x = x + 1;
        }
        y = y + 1;
    }

    // 诊断（大字，确保可见）
    drawRectangle(0, 0, 350, 100, {r:0,g:0,b:0,a:220});
    drawText("主循环 大厅点击: " + toString(大厅点击), 10, 10, 16, {r:0,g:255,b:0,a:255});
    drawText("步进() 直接点击: " + toString(直接点击), 10, 35, 16, {r:255,g:255,b:0,a:255});
    drawText("步进() 函数内: " + toString(函数内点击), 10, 60, 16, {r:0,g:200,b:255,a:255});

    结束绘制();
}
关闭窗口();
