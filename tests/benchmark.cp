// 性能基准测试

// 1. 斐波那契（递归）
函数 fib(n) {
    如果 n <= 1 则 {
        返回 n;
    }
    返回 fib(n - 1) + fib(n - 2);
}

// 2. 数组求和
函数 arraySum(n) {
    变量 sum = 0;
    变量 i = 0;
    当 i < n 时 {
        sum = sum + i;
        i = i + 1;
    }
    返回 sum;
}

// 3. 阶乘
函数 factorial(n) {
    如果 n <= 1 则 {
        返回 1;
    }
    返回 n * factorial(n - 1);
}

// 4. 质数检测
函数 isPrime(n) {
    如果 n < 2 则 {
        返回 0;
    }
    变量 i = 2;
    当 i * i <= n 时 {
        如果 n % i == 0 则 {
            返回 0;
        }
        i = i + 1;
    }
    返回 1;
}

// 5. 质数计数
函数 primeCount(n) {
    变量 count = 0;
    变量 i = 2;
    当 i <= n 时 {
        如果 isPrime(i) == 1 则 {
            count = count + 1;
        }
        i = i + 1;
    }
    返回 count;
}

// 主函数
函数 main() {
    打印("=== CPLANG 性能测试 ===");
    打印("");
    
    打印("1. 斐波那契 fib(30):");
    打印(fib(30));
    
    打印("2. 数组求和 (100000):");
    打印(arraySum(100000));
    
    打印("3. 阶乘(15):");
    打印(factorial(15));
    
    打印("4. 质数计数(1000):");
    打印(primeCount(1000));
    
    打印("");
    打印("=== 测试完成 ===");
}
