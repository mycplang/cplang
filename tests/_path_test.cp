// 测试路径解析
函数 提取路径(请求) {
    打印("提取中...");
    变量 p1 = 查找(请求, " ");
    打印("p1=" + toString(p1));
    如果 (p1 == -1) {
        返回 "/";
     }
    变量 after = 子串(请求, p1 + 1);
    打印("after=" + after);
    变量 p2 = 查找(after, " ");
    打印("p2=" + toString(p2));
    如果 (p2 == -1) {
        返回 after;
     }
    变量 结果 = 子串(after, 0, p2);
    打印("结果=" + 结果);
    返回 结果;
 }

函数 主() {
    变量 test = "GET /hello HTTP/1.1";
    变量 path = 提取路径(test);
    打印("路径: " + path);
 }
主();
