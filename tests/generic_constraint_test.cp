// 泛型约束测试
// 测试1: 带约束的泛型函数 - 约束满足
函数 最小值<T: 可比较>(a: T, b: T): T {
    如果 (a < b) {
        返回 a;
    }
    返回 b;
}

// 测试2: 泛型函数使用 - 整数满足"可比较"
函数 main() {
    变量 x = 最小值<整数>(10, 20);
    打印("最小值(10, 20) = ", x);  // 应打印 10
    
    变量 y = 最小值<浮点>(3.14, 2.71);
    打印("最小值(3.14, 2.71) = ", y);  // 应打印 2.71
    
    变量 z = 最小值<字符串>("apple", "banana");
    打印("最小值('apple', 'banana') = ", z);  // 应打印 "apple"
    
    返回 0;
}
