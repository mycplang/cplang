// ═══════════════════════════════════════════════════════════════
// v0.5.0: 泛型 + Trait 端到端测试
// ═══════════════════════════════════════════════════════════════

// ── 测试1: 泛型函数 + 内置 trait ──
函数 最大值<T: 可比较>(a: T, b: T): T {
    如果 (a > b) { 返回 a; }
    返回 b;
}

函数 找最大<T: 可比较>(arr: T[]): T {
    如果 (长度(arr) == 0) { 返回 空; }
    变量 max = arr[0];
    变量 i = 1;
    当 (i < 长度(arr)) {
        max = 最大值(max, arr[i]);
        i = i + 1;
    }
    返回 max;
}

// ── 测试2: 泛型结构体 ──
结构体 对<A, B> {
    第一个: A;
    第二个: B;
}

函数 测试对() {
    变量 p1: 对<整数, 字符串> = { 第一个: 42, 第二个: "答案" };
    打印(p1.第一个);
    打印(p1.第二个);
}

// ── 测试3: 泛型类 + 接口约束 ──
接口 容器<T> {
    函数 添加(item: T): 空;
    函数 获取(index: 整数): T;
    函数 大小(): 整数;
}

类 列表<T> 实现 容器<T> {
    变量 items: T[];
    
    函数 添加(item: T): 空 {
        追加(this.items, item);
    }
    
    函数 获取(index: 整数): T {
        返回 this.items[index];
    }
    
    函数 大小(): 整数 {
        返回 长度(this.items);
    }
}

// ── 测试4: 多约束泛型 ──
函数 查找索引<T: 可比较>(arr: T[], target: T): 整数 {
    变量 i = 0;
    当 (i < 长度(arr)) {
        如果 (arr[i] == target) {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// ── 测试5: 泛型函数类型推断 ──
函数 交换<T>(a: T, b: T): 对<T, T> {
    变量 result: 对<T, T>;
    result.第一个 = b;
    result.第二个 = a;
    返回 result;
}

// ── 主测试入口 ──
函数 main() {
    打印("=== v0.5.0 泛型 + Trait 测试 ===");
    
    // 测试1: 泛型函数
    变量 m1 = 最大值(10, 20);
    打印("最大值(10,20) = " + 转字符串(m1));
    断言(m1 == 20, "最大值整数测试");
    
    变量 m2 = 最大值(3.14, 2.71);
    打印("最大值(3.14,2.71) = " + 转字符串(m2));
    断言(m2 == 3.14, "最大值浮点测试");
    
    变量 nums = [5, 2, 9, 1, 7];
    变量 max = 找最大(nums);
    打印("找最大([5,2,9,1,7]) = " + 转字符串(max));
    断言(max == 9, "找最大数组测试");
    
    // 测试2: 泛型结构体
    测试对();
    
    // 测试3: 泛型类
    变量 lst = 新建 列表<整数>();
    lst.添加(10);
    lst.添加(20);
    lst.添加(30);
    断言(lst.大小() == 3, "列表大小");
    断言(lst.获取(0) == 10, "列表获取");
    打印("列表大小: " + 转字符串(lst.大小()));
    
    // 测试4: 查找
    变量 idx = 查找索引([10, 20, 30, 40], 30);
    断言(idx == 2, "查找索引");
    
    // 测试5: 类型推断
    变量 swapped = 交换(1, 2);
    打印("交换(1,2) = (" + 转字符串(swapped.第一个) + "," + 转字符串(swapped.第二个) + ")");
    
    打印("");
    打印("=== 所有泛型测试通过 ===");
}