// TCP echo 服务器测试
函数 启动服务器(端口) {
    变量 监听器 = TCP监听("0.0.0.0", 端口);
    如果 (监听器 == -1) {
        打印("监听失败");
        返回 假;
    }
    打印("服务器启动，端口: " + 转字符串(端口));
    
    变量 客户端 = TCP接受(监听器);
    如果 (客户端 == -1) {
        打印("接受失败");
        TCP关闭(监听器);
        返回 假;
    }
    打印("客户端已连接");
    
    // Echo 循环
    变量 数据;
    当 (真) {
        数据 = TCP接收(客户端, 1024);
        如果 (数据 == "" 或 数据 == 空值) {
            跳出;
        }
        打印("收到: " + 数据);
        TCP发送(客户端, "ECHO: " + 数据);
    }
    
    TCP关闭(客户端);
    TCP关闭(监听器);
    打印("服务器关闭");
    返回 真;
}

启动服务器(8080);