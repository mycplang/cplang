// 优化测试 - 展示常量折叠和死代码消除

// 1. 常量折叠测试
常量 a = 3 + 4 * 2;      // 应折叠为 11
常量 b = 100 / 5;        // 应折叠为 20
常量 c = a + b;          // 应折叠为 31
常量 d = 2 * 3 + 4 * 5;  // 应折叠为 26

打印("常量折叠测试:");
打印(a);  // 11
打印(b);  // 20
打印(c);  // 31
打印(d);  // 26

// 2. 死代码消除测试
打印("死代码消除测试:");

如果 真 则 {
    打印(1);  // 保留
}

如果 假 则 {
    打印(2);  // 应被删除
}

如果 1 + 1 == 2 则 {
    打印(3);  // 应被保留（条件折叠为真）
}

// 3. 嵌套优化
常量 x = (2 + 3) * (4 - 1);  // 应折叠为 15
打印(x);

// 4. 复杂表达式
常量 y = 1 + 2 + 3 + 4 + 5;  // 应折叠为 15
打印(y);

打印("优化测试完成");
