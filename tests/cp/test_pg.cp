// ═══════════════════════════════════════════════════
//  PostgreSQL 数据库集成测试
//  测试: 连接、CRUD、错误处理、表查询
// ═══════════════════════════════════════════════════

变量 通过 = 0;
变量 失败 = 0;

函数 断言(条件, 名称) {
    如果 (条件) {
        通过 = 通过 + 1;
        打印("  [通过] " + 名称);
    } 否则 {
        失败 = 失败 + 1;
        打印("  [失败] " + 名称);
    }
}

函数 断言非空(值, 名称) {
    断言(值 != nil, 名称 + " (非空)");
}

函数 断言相等(实际, 期望, 名称) {
    断言(实际 == 期望, 名称 + " (期望=" + 期望 + " 实际=" + 实际 + ")");
}

打印("═══════════════════════════════════════════");
打印("  PostgreSQL 数据库集成测试");
打印("═══════════════════════════════════════════");

// ─── 1. 连接测试 ─────────────────────────────────
变量 连接串 = "host=120.48.128.250 port=5432 dbname=claw_mall user=claw_mall password=ClawMall_2026!";
变量 conn = PG连接(连接串);
断言非空(conn, "1.1 PG连接");

如果 (conn == nil) {
    打印("  [跳过] 无法连接 PostgreSQL，终止测试");
    变量 错误信息 = PG错误(conn);
    打印("  错误: " + 错误信息);
    返回;
}

// ─── 2. 连接状态检查 ──────────────────────────────
断言(PG是否打开(conn), "2.1 连接是否打开");

// ─── 3. 列出数据库 ──────────────────────────────
变量 库列表 = PG列出库(conn);
断言非空(库列表, "3.1 列出数据库");
断言(长度(库列表) > 0, "3.2 数据库列表非空");
打印("    数据库数量=" + 长度(库列表));

// ─── 4. 创建测试表 ──────────────────────────────
打印("");
打印("  --- CRUD 测试 ---");

// 先清理旧表
PG执行(conn, "DROP TABLE IF EXISTS cp_test_users");

变量 建表结果 = PG执行(conn,
    "CREATE TABLE cp_test_users (" +
    "  id SERIAL PRIMARY KEY," +
    "  name VARCHAR(100) NOT NULL," +
    "  age INTEGER DEFAULT 0," +
    "  email VARCHAR(200)" +
    ")"
);
打印("    建表影响行数=" + 建表结果);
// CREATE TABLE 成功时 PG 返回 -1(PGRES_COMMAND_OK 但无元组计数) 或 0
// 只要 != -1 (错误) 就算通过
断言(建表结果 != -1, "4.1 创建测试表");

// ─── 5. INSERT 测试 ─────────────────────────────
变量 插入结果 = PG执行(conn,
    "INSERT INTO cp_test_users (name, age, email) VALUES " +
    "('张三', 25, 'zhangsan@test.com')," +
    "('李四', 30, 'lisi@test.com')," +
    "('王五', 28, 'wangwu@test.com')"
);
打印("    插入影响行数=" + 插入结果);
断言(插入结果 == 3, "5.1 批量插入 3 条记录 (影响行数=3)");

// ─── 6. SELECT 查询测试 ─────────────────────────
变量 查询结果 = PG查询(conn, "SELECT * FROM cp_test_users ORDER BY id");
断言非空(查询结果, "6.1 查询所有用户");
断言(长度(查询结果) == 3, "6.2 返回 3 行");

如果 (长度(查询结果) >= 1) {
    变量 第一行 = 查询结果[0];
    打印("    姓名=" + 第一行["name"] + " 年龄=" + 第一行["age"] + " 邮箱=" + 第一行["email"]);
    断言(第一行["name"] == "张三", "6.3 第一行 name=张三");
}

// 条件查询
变量 条件结果 = PG查询(conn, "SELECT * FROM cp_test_users WHERE age > 26 ORDER BY age");
断言(长度(条件结果) == 2, "6.4 年龄>26 返回 2 行");

// 聚合查询
变量 聚合结果 = PG查询(conn, "SELECT COUNT(*) AS cnt, AVG(age)::int AS avg_age FROM cp_test_users");
如果 (长度(聚合结果) >= 1) {
    打印("    总数=" + 聚合结果[0]["cnt"] + " 平均年龄=" + 聚合结果[0]["avg_age"]);
    断言(聚合结果[0]["cnt"] == "3", "6.5 COUNT=3");
}

// ─── 7. UPDATE 测试 ─────────────────────────────
变量 更新结果 = PG执行(conn, "UPDATE cp_test_users SET age = 26 WHERE name = '张三'");
断言(更新结果 == 1, "7.1 更新张三年龄 (影响行数=1)");

// 验证更新
变量 更新后 = PG查询(conn, "SELECT age FROM cp_test_users WHERE name = '张三'");
断言(长度(更新后) == 1, "7.2 查到更新后记录");
断言(更新后[0]["age"] == "26", "7.3 年龄变为 26");

// ─── 8. DELETE 测试 ─────────────────────────────
变量 删除结果 = PG执行(conn, "DELETE FROM cp_test_users WHERE name = '王五'");
断言(删除结果 == 1, "8.1 删除王五 (影响行数=1)");

变量 删除后 = PG查询(conn, "SELECT COUNT(*) AS cnt FROM cp_test_users");
打印("    剩余记录数=" + 删除后[0]["cnt"]);
断言(删除后[0]["cnt"] == "2", "8.2 剩余 2 条记录");

// ─── 9. RETURNING 子句测试 (PG 特有) ────────────
打印("");
打印("  --- PostgreSQL 特性测试 ---");

变量 returning结果 = PG查询(conn,
    "INSERT INTO cp_test_users (name, age, email) " +
    "VALUES ('赵六', 35, 'zhaoliu@test.com') " +
    "RETURNING id, name"
);
断言(长度(returning结果) == 1, "9.1 RETURNING 返回 1 行");
如果 (长度(returning结果) >= 1) {
    打印("    RETURNING id=" + returning结果[0]["id"] + " name=" + returning结果[0]["name"]);
    断言(returning结果[0]["name"] == "赵六", "9.2 RETURNING name=赵六");
}

// ─── 10. 错误处理测试 ───────────────────────────
打印("");
打印("  --- 错误处理测试 ---");

变量 错误SQL = PG查询(conn, "SELECT * FROM 不存在的表");
断言(错误SQL == nil, "10.1 错误SQL 返回 nil");

变量 错误Exec = PG执行(conn, "BAD SQL SYNTAX HERE");
断言(错误Exec == -1, "10.2 错误执行 返回 -1");

// ─── 11. 列出表 ─────────────────────────────────
变量 表列表 = PG列出表(conn);
断言非空(表列表, "11.1 列出表");
断言(长度(表列表) > 0, "11.2 表列表非空");

// ─── 12. 清理 ───────────────────────────────────
PG执行(conn, "DROP TABLE IF EXISTS cp_test_users");

// ─── 13. 关闭连接 ───────────────────────────────
断言(PG关闭(conn), "13.1 关闭连接");

// ─── 打印汇总 ─────────────────────────────────
打印("");
打印("═══════════════════════════════════════════");
打印("  PostgreSQL 测试结果: " + 通过 + "/" + (通过 + 失败) + " 通过");
如果 (失败 == 0) {
    打印("  [全部通过] PostgreSQL 数据库集成测试通过!");
} 否则 {
    打印("  [有失败] " + 失败 + " 个测试失败");
}
打印("═══════════════════════════════════════════");

如果 (通过 >= 10) {
    打印("  状态: 通过");
} 否则 {
    打印("  状态: 失败");
}