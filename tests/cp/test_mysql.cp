// ═══════════════════════════════════════════════════
//  MySQL 数据库集成测试
//  测试: 连接、CRUD、错误处理、表查询
// ═══════════════════════════════════════════════════

变量 通过 = 0;
变量 失败 = 0;

函数 断言(条件, 名称) {
    如果 (条件) {
        通过 = 通过 + 1;
        打印("  [通过] " + 名称);
    } 否则 {
        失败 = 失败 + 1;
        打印("  [失败] " + 名称);
    }
}

函数 断言非空(值, 名称) {
    断言(值 != nil, 名称 + " (非空)");
}

函数 断言相等(实际, 期望, 名称) {
    断言(实际 == 期望, 名称 + " (期望 " + 期望 + " 实际 " + 实际 + ")");
}

打印("═══════════════════════════════════════════");
打印("  MySQL 数据库集成测试");
打印("═══════════════════════════════════════════");

// ─── 1. 连接测试 ─────────────────────────────────
变量 conn = MySQL连接("120.220.76.108", "root", "total.mysql.11", "ceshi", 3306);
断言非空(conn, "1.1 MySQL连接");

如果 (conn == nil) {
    打印("  [跳过] 无法连接 MySQL，终止测试");
    变量 错误信息 = MySQL错误(conn);
    打印("  错误: " + 错误信息);
    返回;
}

// ─── 2. 连接状态检查 ──────────────────────────────
断言(MySQL是否打开(conn), "2.1 连接是否打开");

// ─── 3. 切换数据库 ──────────────────────────────
断言(MySQL选库(conn, "ceshi"), "3.1 选择数据库 ceshi");

// ─── 4. 列出数据库 ──────────────────────────────
变量 库列表 = MySQL列出库(conn);
断言非空(库列表, "4.1 列出数据库");
断言(长度(库列表) > 0, "4.2 数据库列表非空");

// ─── 5. 创建测试表 ──────────────────────────────
打印("");
打印("  --- CRUD 测试 ---");

// 先清理旧表
MySQL执行(conn, "DROP TABLE IF EXISTS cp_test_users");

变量 建表结果 = MySQL执行(conn,
    "CREATE TABLE cp_test_users (" +
    "  id INT AUTO_INCREMENT PRIMARY KEY," +
    "  name VARCHAR(100) NOT NULL," +
    "  age INT DEFAULT 0," +
    "  email VARCHAR(200)" +
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
);
断言(建表结果, "5.1 创建测试表");

// ─── 6. INSERT 测试 ─────────────────────────────
变量 插入结果 = MySQL执行(conn,
    "INSERT INTO cp_test_users (name, age, email) VALUES " +
    "('张三', 25, 'zhangsan@test.com')," +
    "('李四', 30, 'lisi@test.com')," +
    "('王五', 28, 'wangwu@test.com')"
);
断言(插入结果, "6.1 批量插入 3 条记录");

变量 插入ID = MySQL插入标识(conn);
变量 影响行 = MySQL影响行数(conn);
打印("    插入标识=" + 插入ID + " 影响行数=" + 影响行);
断言(影响行 == 3, "6.2 影响行数=3");

// ─── 7. SELECT 查询测试 ─────────────────────────
变量 查询结果 = MySQL查询(conn, "SELECT * FROM cp_test_users ORDER BY id");
断言非空(查询结果, "7.1 查询所有用户");
断言(长度(查询结果) == 3, "7.2 返回 3 行");

如果 (长度(查询结果) >= 1) {
    变量 第一行 = 查询结果[0];
    打印("    姓名=" + 第一行["name"] + " 年龄=" + 第一行["age"] + " 邮箱=" + 第一行["email"]);
    断言(第一行["name"] == "张三", "7.3 第一行 name=张三");
}

// 条件查询
变量 条件结果 = MySQL查询(conn, "SELECT * FROM cp_test_users WHERE age > 26 ORDER BY age");
断言(长度(条件结果) == 2, "7.4 年龄>26 返回 2 行");

// ─── 8. UPDATE 测试 ─────────────────────────────
变量 更新结果 = MySQL执行(conn, "UPDATE cp_test_users SET age = 26 WHERE name = '张三'");
断言(更新结果, "8.1 更新张三年龄");
断言(MySQL影响行数(conn) == 1, "8.2 更新 1 行");

// 验证更新
变量 更新后 = MySQL查询(conn, "SELECT age FROM cp_test_users WHERE name = '张三'");
断言(长度(更新后) == 1, "8.3 查到更新后记录");
断言(更新后[0]["age"] == "26", "8.4 年龄变为 26");

// ─── 9. DELETE 测试 ─────────────────────────────
变量 删除结果 = MySQL执行(conn, "DELETE FROM cp_test_users WHERE name = '王五'");
断言(删除结果, "9.1 删除王五");
断言(MySQL影响行数(conn) == 1, "9.2 删除 1 行");

变量 删除后 = MySQL查询(conn, "SELECT COUNT(*) AS cnt FROM cp_test_users");
打印("    剩余记录数=" + 删除后[0]["cnt"]);
断言(删除后[0]["cnt"] == "2", "9.3 剩余 2 条记录");

// ─── 10. 错误处理测试 ───────────────────────────
打印("");
打印("  --- 错误处理测试 ---");

变量 错误SQL = MySQL查询(conn, "SELECT * FROM 不存在的表");
断言(错误SQL == nil, "10.1 错误SQL 返回 nil");

变量 错误Exec = MySQL执行(conn, "BAD SQL SYNTAX HERE");
断言(错误Exec == false, "10.2 错误执行 返回 false");

// ─── 11. 字符串转义测试 ────────────────────────
变量 转义后 = MySQL转义(conn, "It's a \"test\"");
断言非空(转义后, "11.1 字符串转义");

// ─── 12. 列出表 ─────────────────────────────────
变量 表列表 = MySQL列出表(conn);
断言非空(表列表, "12.1 列出表");
断言(长度(表列表) > 0, "12.2 表列表非空");

// ─── 13. 清理 ───────────────────────────────────
MySQL执行(conn, "DROP TABLE IF EXISTS cp_test_users");

// ─── 14. 关闭连接 ───────────────────────────────
断言(MySQL关闭(conn), "13.1 关闭连接");

// ─── 打印汇总 ─────────────────────────────────
打印("");
打印("═══════════════════════════════════════════");
打印("  MySQL 测试结果: " + 通过 + "/" + (通过 + 失败) + " 通过");
如果 (失败 == 0) {
    打印("  [全部通过] MySQL 数据库集成测试通过!");
} 否则 {
    打印("  [有失败] " + 失败 + " 个测试失败");
}
打印("═══════════════════════════════════════════");

// 通过检查：至少通过了连接和基本 CRUD
如果 (通过 >= 10) {
    打印("  状态: 通过");
} 否则 {
    打印("  状态: 失败");
}