// ═══════════════════════════════════════════════════
//  Redis 数据库集成测试
//  测试: 连接、AUTH、SET/GET/DEL、KEYS、Pipeline
// ═══════════════════════════════════════════════════

// 触发 Winsock 初始化 (Redis 模块依赖此初始化,
// 通过调用任意 TCP 网络函数来确保 WSAStartup 已执行)
变量 _wsInit = TCP连接("120.48.128.250", 6379);
如果 (_wsInit >= 0) { TCP关闭(_wsInit); }

变量 通过 = 0;
变量 失败 = 0;

函数 断言(条件, 名称) {
    如果 (条件) {
        通过 = 通过 + 1;
        打印("  [通过] " + 名称);
    } 否则 {
        失败 = 失败 + 1;
        打印("  [失败] " + 名称);
    }
}

函数 断言非空(值, 名称) {
    断言(值 != nil, 名称 + " (非空)");
}

函数 断言相等(实际, 期望, 名称) {
    断言(实际 == 期望, 名称 + " (期望=" + 期望 + " 实际=" + 实际 + ")");
}

打印("═══════════════════════════════════════════");
打印("  Redis 数据库集成测试");
打印("═══════════════════════════════════════════");

// ─── 1. 连接测试 ─────────────────────────────────
变量 conn = Redis连接("120.48.128.250", 6379);
断言非空(conn, "1.1 Redis连接");

如果 (conn == nil) {
    打印("  [跳过] 无法连接 Redis，终止测试");
    返回;
}

// ─── 2. 连接状态检查 ──────────────────────────────
断言(Redis是否打开(conn), "2.1 连接是否打开");

// ─── 3. AUTH 认证 ─────────────────────────────────
变量 认证结果 = Redis命令(conn, "AUTH ClawMall_2026!");
打印("    认证结果=" + 认证结果);
断言(认证结果 == "OK", "3.1 AUTH 认证成功");

// ─── 4. PING 测试 ────────────────────────────────
变量 ping结果 = Redis命令(conn, "PING");
打印("    PING=" + ping结果);
断言(ping结果 == "PONG", "4.1 PING 返回 PONG");

// ─── 5. 数据清理 (避免上次残留) ──────────────────
Redis命令(conn, "DEL cp_test_str cp_test_num cp_test_json cp_test_counter");

// ─── 6. SET/GET 字符串测试 ──────────────────────
打印("");
打印("  --- SET/GET 测试 ---");

变量 set结果 = Redis命令(conn, "SET cp_test_str CPP-测试-你好世界");
打印("    SET=" + set结果);
断言(set结果 == "OK", "6.1 SET 字符串");

变量 get结果 = Redis命令(conn, "GET cp_test_str");
打印("    GET=" + get结果);
断言(get结果 == "CPP-测试-你好世界", "6.2 GET 字符串返回正确");  // bulk string → 值

// GET 不存在的 key
变量 get空 = Redis命令(conn, "GET cp_key_not_exist");
打印("    GET(不存在)=" + get空);
断言(get空 == nil, "6.3 GET 不存在返回 nil");

// ─── 7. SET/GET 数字测试 ────────────────────────
变量 setNum = Redis命令(conn, "SET cp_test_num 2026");
断言(setNum == "OK", "7.1 SET 数字");

变量 getNum = Redis命令(conn, "GET cp_test_num");
打印("    GET(数字)=" + getNum);
断言(getNum == "2026", "7.2 GET 数字返回 2026");  // Redis 返回字符串

// ─── 8. INCR/DECR 计数器测试 ────────────────────
变量 incr结果 = Redis命令(conn, "INCR cp_test_counter");
打印("    INCR=" + incr结果);
断言(incr结果 == 1, "8.1 INCR 返回 1");

变量 incr2 = Redis命令(conn, "INCR cp_test_counter");
断言(incr2 == 2, "8.2 INCR 返回 2");

变量 incrby = Redis命令(conn, "INCRBY cp_test_counter 98");
断言(incrby == 100, "8.3 INCRBY 98 返回 100");

// ─── 9. EXPIRE TTL 测试 ─────────────────────────
Redis命令(conn, "SET cp_test_ttl will-expire EX 10");
变量 ttl结果 = Redis命令(conn, "TTL cp_test_ttl");
打印("    TTL=" + ttl结果);
断言(ttl结果 > 0 && ttl结果 <= 10, "9.1 TTL 在 1-10 之间");

// ─── 10. KEYS 模式匹配 ──────────────────────────
变量 keys结果 = Redis命令(conn, "KEYS cp_test_*");
打印("    KEYS cp_test_* 返回类型=" + keys结果);
断言非空(keys结果, "10.1 KEYS 模式匹配返回非空");

// ─── 11. EXISTS 测试 ────────────────────────────
变量 exists1 = Redis命令(conn, "EXISTS cp_test_str");
断言(exists1 == 1, "11.1 EXISTS 已存在 key 返回 1");

变量 exists0 = Redis命令(conn, "EXISTS cp_no_such_key_zzz");
断言(exists0 == 0, "11.2 EXISTS 不存在 key 返回 0");

// ─── 12. Pipeline 批量测试 ──────────────────────
打印("");
打印("  --- Pipeline 测试 ---");

变量 管道命令 = [];
追加(管道命令, "SET cp_pipe_a 111");
追加(管道命令, "SET cp_pipe_b 222");
追加(管道命令, "GET cp_pipe_a");
追加(管道命令, "GET cp_pipe_b");

变量 管道结果 = Redis管道(conn, 管道命令);
断言非空(管道结果, "12.1 Pipeline 返回非空");

如果 (管道结果 != nil && 长度(管道结果) == 4) {
    打印("    管道第1个=" + 管道结果[0]);
    打印("    管道第2个=" + 管道结果[1]);
    打印("    管道第3个=" + 管道结果[2]);
    打印("    管道第4个=" + 管道结果[3]);
    断言(管道结果[0] == "OK", "12.2 Pipeline SET a");
    断言(管道结果[1] == "OK", "12.3 Pipeline SET b");
    断言(管道结果[2] == "111", "12.4 Pipeline GET a=111");
    断言(管道结果[3] == "222", "12.5 Pipeline GET b=222");
} 否则 {
    打印("    管道返回异常或长度不对");
    失败 = 失败 + 4;
}

// ─── 13. 清理测试数据 ───────────────────────────
Redis命令(conn, "DEL cp_test_str cp_test_num cp_test_json cp_test_counter cp_test_ttl cp_pipe_a cp_pipe_b");

// ─── 14. 关闭连接 ───────────────────────────────
断言(Redis关闭(conn), "14.1 关闭连接");

// ─── 打印汇总 ─────────────────────────────────
打印("");
打印("═══════════════════════════════════════════");
打印("  Redis 测试结果: " + 通过 + "/" + (通过 + 失败) + " 通过");
如果 (失败 == 0) {
    打印("  [全部通过] Redis 数据库集成测试通过!");
} 否则 {
    打印("  [有失败] " + 失败 + " 个测试失败");
}
打印("═══════════════════════════════════════════");

如果 (通过 >= 8) {
    打印("  状态: 通过");
} 否则 {
    打印("  状态: 失败");
}