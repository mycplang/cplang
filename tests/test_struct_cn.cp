// 测试结构体类型系统 - 中文版本

结构体 点 {
    x;
    y;
};

结构体 矩形 {
    左上角;
    右下角;
};

函数 主() {
    // 创建结构体变量
    变量 p = 点{x: 10, y: 20};
    
    // 访问成员
    打印(p.x);
    打印(p.y);
    
    // 修改成员
    p.x = 100;
    p.y = 200;
    
    打印(p.x);
    打印(p.y);
    
    // 嵌套结构体
    变量 r = 矩形{
        左上角: 点{x: 0, y: 0},
        右下角: 点{x: 100, y: 100}
    };
    
    打印(r.左上角.x);
    打印(r.右下角.y);
}
