// 测试双语运算符语法
// test_bilingual.cp

// 1. 测试 设...为... 变量声明
设 x 为 10;
设 y 为 20;

// 2. 测试关键词比较运算符
如果 x 大于 0 则 {
    打印("x 是正数");
}

如果 x 小于 100 且 y 大于 10 则 {
    打印("条件满足");
}

如果 x 等于 10 或 y 等于 20 则 {
    打印("x 是 10 或 y 是 20");
}

如果 非 (x 等于 0) 则 {
    打印("x 不是 0");
}

// 3. 测试 当...时 循环
设 i 为 0;
当 i 小于 5 时 {
    打印(i);
    i = i + 1;
}

// 4. 测试 遍历...在 循环
设 arr 为 [1, 2, 3, 4, 5];
遍历 n 在 arr {
    打印(n);
}

// 5. 测试混合使用（符号和关键词都可以）
如果 x >= 0 && y <= 100 则 {
    打印("符号运算符也工作");
}

// 6. 测试 大于等于 / 小于等于
设 a 为 10;
设 b 为 20;
如果 a 大于等于 10 且 b 小于等于 20 则 {
    打印("大于等于和小于等于工作正常");
}

// 7. 测试 不等于
如果 a 不等于 5 则 {
    打印("a 不等于 5");
}

// 8. 测试 不低于 / 不超过（别名）
如果 a 不低于 5 且 a 不超过 15 则 {
    打印("不低于/不超过 别名工作正常");
}

打印("所有测试完成！");
