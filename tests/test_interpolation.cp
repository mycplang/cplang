// ${} 字符串插值测试

函数 main() {
    变量 name = "世界";
    变量 count = 42;
    
    // 简单变量插值
    变量 s1 = "你好, ${name}!";
    打印(s1);
    
    // 多变量插值
    变量 s2 = "${name} × ${count}";
    打印(s2);
    
    // 纯字符串（无插值）
    变量 s3 = "Hello World";
    打印(s3);
    
    // 空字符串
    变量 s4 = "";
    打印("empty: '" + s4 + "'");
    
    // 表达式插值
    变量 s5 = "结果 = ${count + 1}";
    打印(s5);
    
    返回 0;
}