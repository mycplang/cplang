打印("=== before init ===");
初始化窗口(400, 300, "Test");
打印("=== after init ===");
开始绘图();
打印("=== after begin ===");
清空背景(红);
打印("=== after clear ===");
结束绘图();
打印("=== after end ===");
打印("=== ALL DONE - close window ===");

变量 帧数 = 0;
设置目标帧率(60);
当 (1 == 1) {
    帧数 = 帧数 + 1;
    如果 (帧数 > 120) { 跳出; }
    如果 (窗口应关闭()) { 跳出; }
}
关闭窗口();
打印("=== exit ===");
