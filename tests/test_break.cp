// break/continue 测试

函数 测试跳出() {
    变量 i = 0;
    当 (i < 100) {
        如果 (i == 50) {
            跳出;
        }
        i = i + 1;
    }
    返回 i;
}

函数 测试继续() {
    变量 sum = 0;
    变量 i = 0;
    当 (i < 10) {
        i = i + 1;
        如果 (i % 2 == 0) {
            继续;
        }
        sum = sum + i;
    }
    返回 sum;
}

函数 main() {
    返回 测试跳出() + 测试继续();
}
