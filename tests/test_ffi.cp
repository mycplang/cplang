// ═══════════════════════════════════════════════════════
//  FFI 全面测试 v3 — 含回调支持
// ═══════════════════════════════════════════════════════

// ─── 辅助函数（先定义，供 main 中回调使用）───
函数 双倍(x) {
    返回 x * 2;
}
函数 双倍2(x) {
    返回 x * 2;
}
函数 打印值(x) {
    打印("  收到值: " + 转字符串(x));
}
函数 窗口枚举(hwnd, lParam) {
    返回 hwnd + lParam;
}
变量 窗口数 = 0;
函数 枚举计数(hwnd, lParam) {
    窗口数 = 窗口数 + 1;
    返回 1;  // True = 继续枚举
}
函数 双倍浮点(x) {
    返回 x * 2.0;
}

函数 main() {
    打印("===== FFI 全面测试 v3 =====");

    // ─────────────────────────────────────────────
    // 第一部分：基础 + 内存 + 签名（回归）
    // ─────────────────────────────────────────────
    打印("\n--- 1. 回归测试 ---");
    lib = 加载库("user32.dll");
    如果 (lib != 0) {
        fnSM = 取函数(lib, "GetSystemMetrics");
        如果 (fnSM != 0) {
            r = 调用签名(fnSM, "ii", 0);
            如果 (r > 0) { 打印("✅ 回归 GetSystemMetrics: " + 转字符串(r)); }
        }
        释放库(lib);
    }

    buf = 分配内存(16);
    如果 (buf != 0) {
        写32位(buf, 42);
        v = 读32位(buf);
        断言(v == 42, "读32位");
        释放内存(buf);
    }

    libC = 加载库("msvcrt.dll");
    如果 (libC != 0) {
        fn = 取函数(libC, "sqrt");
        如果 (fn != 0) {
            r = 调用签名(fn, "ff", 64.0);
            断言(r == 8.0, "sqrt");
        }
        释放库(libC);
    }

    // ─────────────────────────────────────────────
    // 第二部分：回调测试
    // ─────────────────────────────────────────────
    打印("\n--- 2. 回调测试 ---");

    // 2a. 创建回调并直接调用
    // 测试 int64(int64) 签名 — 传函数值本身（无需字符串查找，更安全）
    回调1 = 创建回调(双倍, "ii");
    如果 (回调1 != 0) {
        打印("✅ 创建回调成功, 地址: " + 转字符串(回调1));
        // 通过 调用签名 模拟 C 代码调用回调
        结果 = 调用签名(回调1, "ii", 42);
        打印("✅ 回调(42) = " + 转字符串(结果));
        断言(结果 == 84, "双倍(42)");
        释放回调(回调1);
        打印("✅ 释放回调 ok");
    } 否则 {
        打印("❌ 创建回调失败");
    }

    // 2b. 测试 void(int64) 签名
    回调2 = 创建回调(打印值, "vi");
    如果 (回调2 != 0) {
        调用签名(回调2, "vi", 12345);
        打印("✅ void 回调 ok");
        释放回调(回调2);
    }

    // 2c. 测试闭包回调 — 用已有函数
    回调3 = 创建回调(双倍, "ii");
    如果 (回调3 != 0) {
        结果 = 调用签名(回调3, "ii", 99);
        断言(结果 == 198, "双倍(99)");
        释放回调(回调3);
    }

    // 2d. 真实 API 测试：EnumWindows（回调每窗口触发一次）
    libU = 加载库("user32.dll");
    如果 (libU != 0) {
        fnEnum = 取函数(libU, "EnumWindows");
        如果 (fnEnum != 0) {
            回调4 = 创建回调(窗口枚举, "iii");
            如果 (回调4 != 0) {
                // 模拟 EnumWindows：验证 2 个参数正确传递
                结果 = 调用签名(回调4, "iii", 100, 200);
                断言(结果 == 300, "窗口枚举(100+200) = " + 转字符串(结果));
                释放回调(回调4);
                打印("✅ 多参数回调验证 ok");

                // 真正调用 EnumWindows（测试回调被 C 代码调用）
                回调5 = 创建回调(枚举计数, "iii");
                如果 (回调5 != 0) {
                    窗口数 = 0;
                    n = 调用签名(fnEnum, "iii", 回调5, 0);
                    打印("✅ EnumWindows 返回: " + 转字符串(n) + ", 窗口数: " + 转字符串(窗口数));
                    断言(窗口数 > 0, "至少有一个窗口");
                    释放回调(回调5);
                }  // end EnumWindows
            }
        }
        释放库(libU);
    }

    // 2e. 浮点参数回调测试 — XMM 寄存器通路
    回调浮点 = 创建回调(双倍浮点, "ff");
    如果 (回调浮点 != 0) {
        结果 = 调用签名(回调浮点, "ff", 3.14);
        如果 (结果 > 6.27 && 结果 < 6.29) {
            打印("✅ 浮点回调: 3.14×2 = " + 转字符串(结果));
        } 否则 {
            打印("❌ 浮点回调失败: 期望 ~6.28, 得到 " + 转字符串(结果));
        }
        释放回调(回调浮点);
    } 否则 {
        打印("❌ 浮点回调创建失败");
    }

    // 2g. 重复创建/释放（验证 slot 复用）
    打印("\n--- 3. 回调复用测试 ---");
    变量 idx = 0;
    当 (idx < 5) {
        cb = 创建回调(双倍2, "ii");
        如果 (cb != 0) {
            r = 调用签名(cb, "ii", idx);
            断言(r == idx * 2, "双倍(" + 转字符串(idx) + ")");
            释放回调(cb);
        }
        idx = idx + 1;
    }
    打印("✅ 5 次创建/释放循环通过");

    // ─────────────────────────────────────────────
    // 第四部分：错误处理
    // ─────────────────────────────────────────────
    打印("\n--- 4. 错误处理 ---");
    libBad = 加载库("nonexistent.dll");
    如果 (libBad == 0) {
        e = 错误码();
        打印("✅ 错误码: " + 转字符串(e));
    }

    打印("\n===== FFI 测试全部通过 =====");
}

// ── 简单断言 ──
函数 断言(条件, 消息) {
    如果 (!条件) {
        打印("❌ 断言失败: " + 消息);
    } 否则 {
        打印("✅ 断言通过: " + 消息);
    }
}
