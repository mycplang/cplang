println("=== 循环语句完整性测试 ===");

// 1. 当 (while) + break + continue
变量 pass1 = 1;
变量 w1 = 0;
变量 ws = 0;
当 (w1 < 10) {
    如果 (w1 == 5) { break; }
    如果 (w1 == 3) { w1 = w1 + 1; continue; }
    ws = ws + w1;
    w1 = w1 + 1;
}
如果 (ws == 7) {
    打印("1. 当+break+continue 通过");   // 0+1+2+4 = 7, 跳过3, 到5时break
} 否则 {
    打印("1. 当+break+continue 失败: ws=" + ws);
}

// 2. for循环 + break + continue
变量 fs = 0;
变量 found = 0;
循环 (变量 i = 0; i < 10; i = i + 1) {
    如果 (i == 7) { break; }
    如果 (i >= 3 && i <= 5) { continue; }
    fs = fs + i;
}
如果 (fs == 9) {
    打印("2. for+break+continue 通过");  // 0+1+2+6 = 9, 跳过3/4/5, 到7时break
} 否则 {
    打印("2. for+break+continue 失败: fs=" + fs);
}

// 3. 当 (while) 嵌套 break
变量 活 = 1;
变量 层 = 0;
当 (活) {
    变量 内 = 0;
    当 (内 < 5) {
        内 = 内 + 1;
        如果 (内 == 3) { break; }  // 只跳出内层循环
    }
    层 = 层 + 1;
    如果 (层 >= 2) { break; }
}
如果 (层 == 2) {
    打印("3. 嵌套当+break 通过");
} 否则 {
    打印("3. 嵌套当+break 失败: 层=" + 层);
}

// 4. 当 (while) 条件求值
变量 c = 0;
变量 d = 3;
当 (d > 0) {
    c = c + d;
    d = d - 1;
}
如果 (c == 6) {
    打印("4. 当条件求值 通过");  // 3+2+1 = 6
} 否则 {
    打印("4. 当条件求值 失败: c=" + c);
}

// 5. for循环 条件求值
变量 fc = 0;
循环 (变量 j = 0; j < 5; j = j + 1) {
    fc = fc + j;
}
如果 (fc == 10) {
    打印("5. for条件求值 通过");  // 0+1+2+3+4 = 10
} 否则 {
    打印("5. for条件求值 失败: fc=" + fc);
}

// 6. 当+布尔条件
变量 真值 = 真;
变量 bc = 0;
当 (真值) {
    bc = bc + 1;
    如果 (bc >= 3) { 真值 = 假; }
}
如果 (bc == 3) {
    打印("6. 当+布尔条件 通过");
} 否则 {
    打印("6. 当+布尔条件 失败: bc=" + bc);
}

打印("");
打印("=== 所有循环语句测试完成 ===");
