// 函数内联测试

// 小函数 - 应该被内联
函数 add(a, b) {
    返回 a + b;
}

函数 square(x) {
    返回 x * x;
}

函数 double(n) {
    返回 n * 2;
}

// 较大函数 - 不应该被内联
函数 largeFunc(x) {
    a = x + 1;
    b = a * 2;
    c = b - 3;
    d = c / 4;
    e = d + 5;
    f = e * 6;
    g = f - 7;
    h = g + 8;
    返回 h;
}

// 主函数
函数 main() {
    // 这些调用应该被内联
    r1 = add(3, 4);        // 内联为 3 + 4
    r2 = square(5);        // 内联为 5 * 5
    r3 = double(10);       // 内联为 10 * 2
    
    // 嵌套调用 - 也应该内联
    r4 = add(square(2), double(3));  // 内联为 (2 * 2) + (3 * 2)
    
    // 较大函数 - 不内联
    r5 = largeFunc(100);
    
    打印(r1);  // 7
    打印(r2);  // 25
    打印(r3);  // 20
    打印(r4);  // 10
    打印(r5);
    
    返回 0;
}
