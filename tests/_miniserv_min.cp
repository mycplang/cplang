// 最小测试服务器
函数 主() {
    变量 s = TCP监听(8080);
    打印("监听=" + toString(s));
    当 (1 > 0) {
        变量 c = TCP接受(s);
        打印("客户=" + toString(c));
        如果 (c == -1) { 继续; }
        变量 r = TCP接收(c, 256);
        打印("请求=" + r);
        TCP发送(c, "HTTP/1.1 200 OK\r\n\r\nOK");
        TCP关闭(c);
     }
 }
主();
