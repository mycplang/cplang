// CP语言性能基准测试

// 1. 整数运算
打印("===== 整数运算 =====");
变量 sum = 0;
变量 i = 0;
循环 (i = 0; i < 100000; i = i + 1) {
    sum = sum + i;
}
打印("sum = ", sum);

// 2. 浮点运算
打印("===== 浮点运算 =====");
变量 pi = 3.14159265;
变量 area = 0.0;
变量 r = 0;
循环 (r = 1; r <= 1000; r = r + 1) {
    area = area + pi * r * r;
}
打印("area = ", area);

// 3. 函数调用
打印("===== 递归函数 =====");
函数 fib(n) {
    如果 (n <= 1) { 返回 n; }
    返回 fib(n - 1) + fib(n - 2);
}
打印("fib(30) = ", fib(30));

// 4. 数组操作
打印("===== 数组操作 =====");
变量 arr = [];
变量 j = 0;
循环 (j = 0; j < 1000; j = j + 1) {
    追加(arr, j);
}
打印("len(arr) = ", len(arr));
打印("完成");
