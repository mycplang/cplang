打印("=== 第六课：函数 ===")
打印("")

// 基础函数
函数 打招呼(名字) {
    打印("你好，" + 名字 + "！")
}

打招呼("小明")
打招呼("小红")
打印("")

// 返回值的函数
函数 平方(x) {
    返回 x * x;
}

打印("5的平方 = " + 平方(5))
打印("10的平方 = " + 平方(10))
打印("")

// 多参数函数
函数 三角形面积(底, 高) {
    返回 底 * 高 / 2;
}

打印("底10高5的三角形面积 = " + 三角形面积(10, 5))
打印("")

// 带类型的函数（更快！）
函数 斐波那契(n: 整数): 整数 {
    如果 (n < 2) { 返回 n; }
    返回 斐波那契(n-1) + 斐波那契(n-2);
}

打印("斐波那契(10) = " + 斐波那契(10))
