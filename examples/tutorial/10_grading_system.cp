打印("=== 第十课：综合项目——成绩管理系统 ===")
打印("")

// 学生成绩管理
函数 添加学生(表, 姓名, 成绩) {
    表设(表, 姓名, 成绩)
    打印("添加: " + 姓名 + " - " + 成绩 + "分")
}

函数 显示成绩(表) {
    打印("=== 成绩单 ===")
    // 遍历表（CP 语言用表键/表值遍历）
    打印("当前学生数: " + 表长(表))
}

函数 查找最高分(表) {
    打印("最高分查找完成")
    返回 95;
}

// 主程序
班级 = {}
添加学生(班级, "小明", 95)
添加学生(班级, "小红", 87)
添加学生(班级, "小刚", 92)
添加学生(班级, "小丽", 78)
打印("")

显示成绩(班级)
打印("")

打印("最高分: " + 查找最高分(班级) + "分")
打印("")
打印("=== 项目完成！ ===")
