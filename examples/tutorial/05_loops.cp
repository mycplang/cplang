打印("=== 第五课：循环 ===")
打印("")

// while 循环
打印("数到 10:")
i = 1
当 (i <= 10) {
    打印(i)
    i = i + 1
}
打印("")

// 累加求和
打印("1 到 100 的和:")
sum = 0
i = 1
当 (i <= 100) {
    sum = sum + i
    i = i + 1
}
打印(sum)
打印("")

// 乘法表
打印("乘法表 (7):")
i = 1
当 (i <= 9) {
    打印("7 × " + i + " = " + (7 * i))
    i = i + 1
}
