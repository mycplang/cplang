打印("=== 第九课：自动内存管理 ===")
打印("")

// CP 语言使用垃圾回收 (GC) 自动管理内存
// 你创建的对象会自动被 GC 追踪和清理

// 创建对象 — GC 自动管理
变量 数据 = [1, 2, 3, 4, 5]
打印("数据数组: " + 数据)
打印("")

// 创建表 — GC 也会管理
变量 信息 = 表创建(["名字", "年龄"], ["小明", "12"])
打印("名字: " + 表取(信息, "名字"))
打印("年龄: " + 表取(信息, "年龄"))
打印("")

// 函数可以安全地返回局部创建的对象
函数 创建数组() {
    变量 arr = [10, 20, 30]   // arr 由 GC 管理
    返回 arr                    // 安全返回，不会被释放
}
变量 结果 = 创建数组()
打印("返回的数组: " + 结果[0] + ", " + 结果[1] + ", " + 结果[2])
打印("")

// 对象可以安全地赋值和共享
变量 a = [1, 2, 3]
变量 b = a          // a 和 b 指向同一个数组
b[0] = 99           // 修改会反映到 a
打印("a[0] = " + a[0] + " (应为 99)")
打印("")

// 不需要手动释放 — GC 会在合适的时候自动清理
打印("CP 语言的内存管理是全自动的！")
打印("你只需专注于写代码，GC 会处理剩下的一切。")
