打印("=== 第九课：借用与所有权 ===")
打印("")

// 不可变借用
x = 10
a = &x          // 借用一个不可变引用
b = &x          // 可以多个不可变引用
打印("可以同时持有多个不可变引用")
打印("")

// 函数接收借用
函数 显示(y) {
    打印("y = " + y)   // y 是借用的，不拥有数据
}
显示(100)
打印("")

// 可信块
可信 {
    // 在可信块内，可以做普通不能做的事
    // 比如同时持有可变和不可变引用
    打印("可信块内的操作")
}
打印("")

// 借用规则（以下会报错，注释掉）:
// x2 = 10
// m = &可写 x2     // 可写借用
// n = &x2          // 错误！已有可写借用时不能不可变借用
