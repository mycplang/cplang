打印("=== 第三课：数学运算 ===")
打印("")

a = 10
b = 3

打印("a = " + a + ", b = " + b)
打印("a + b = " + (a + b))
打印("a - b = " + (a - b))
打印("a * b = " + (a * b))
打印("a / b = " + (a / b))
打印("")

// 内置数学函数
打印("平方根 of 16: " + sqrt(16))
打印("2的10次方: " + pow(2, 10))
打印("绝对值 of -5: " + abs(-5))
打印("最大值: " + 200)
打印("")

// 浮点数
pi = 3.14159
r = 5
打印("圆的面积: " + (pi * r * r))
