打印("=== 第七课：数组 ===")
打印("")

// 创建数组
水果 = ["苹果", "香蕉", "橘子", "葡萄"]
打印("水果数组: " + 水果)
打印("第一个水果: " + 水果[0])
打印("数组长度: " + 长度(水果))
打印("")

// 遍历数组
打印("遍历水果:")
i = 0
当 (i < 长度(水果)) {
    打印("  " + 水果[i])
    i = i + 1
}
打印("")

// 数字数组
成绩 = [95, 87, 92, 78, 88]
打印("成绩: " + 成绩)

// 算平均分
总和 = 0
i = 0
当 (i < 长度(成绩)) {
    总和 = 总和 + 成绩[i]
    i = i + 1
}
平均 = 总和 / 长度(成绩)
打印("平均分: " + 平均)
