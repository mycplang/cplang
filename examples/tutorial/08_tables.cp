打印("=== 第八课：表（字典） ===")
打印("")

// 创建表
学生 = {}
表设(学生, "姓名", "小明")
表设(学生, "年龄", 12)
表设(学生, "班级", "六年级")

打印("姓名: " + 表取(学生, "姓名"))
打印("年龄: " + 表取(学生, "年龄"))
打印("")

// 嵌套表
班级 = {}
表设(班级, "名称", "六年级一班")
表设(班级, "人数", 30)
表设(班级, "班主任", "王老师")

打印(表取(班级, "名称"))
打印(表取(班级, "班主任") + " 管理 " + 表取(班级, "人数") + " 名学生")
打印("")

// 检查键
如果 (表有(学生, "姓名")) {
    打印("学生表中有'姓名'")
}
如果 (!表有(学生, "地址")) {
    打印("学生表中没有'地址'")
}
