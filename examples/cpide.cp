导入 "@cp/graphics";  // 图形模块 (Raylib 2D/3D + ImGui)
// CP IDE v1.0 — 自举编辑器

变量 编辑器内容 = "";
变量 当前文件 = "未命名.cp";
变量 输出内容 = "欢迎使用 CP IDE v1.0";
变量 文件列表 = [];
变量 当前目录 = ".";
变量 应该退出 = 假;

函数 刷新列表() { 文件列表 = 列出目录(当前目录); }

函数 打开(full) {
    如果 (文件存在(full)) {
        编辑器内容 = 读取文件(full);
        当前文件 = full;
        输出内容 = "已打开: " + full;
        返回 真;
    }
    输出内容 = "文件不存在: " + full;
    返回 假;
}

函数 保存() {
    写入文件(当前文件, 编辑器内容);
    输出内容 = "已保存: " + 当前文件;
}

函数 运行() {
    保存();
    变量 cplang_home = 获取环境变量("CPLANG_HOME");
    如果 (cplang_home == "") { cplang_home = "C:\\cplang"; }
    变量 cmd = cplang_home + "\\build\\cplang.exe -c \"" + 当前文件 + "\"";
    输出内容 = 输出内容 + "\n--- 运行 ---\n" + 进程执行(cmd);
}

函数 主() {
    初始化窗口(1280, 800, "CP IDE v1.0");
    界面初始化(真);
    设置目标帧率(60);
    刷新列表();

    当 (窗口应关闭() == 假 && 应该退出 == 假) {
        开始绘制();
        清除背景(22, 22, 30, 255);
        界面开始绘制();

        // ── 菜单栏 ──
        如果 (菜单栏开始()) {
            如果 (菜单开始("文件")) {
                如果 (菜单项("新建")) { 编辑器内容 = ""; 当前文件 = "未命名.cp"; }
                如果 (菜单项("保存")) { 保存(); }
                分隔线();
                如果 (菜单项("退出")) { 应该退出 = 真; }
                菜单结束();
            }
            如果 (菜单开始("运行")) {
                如果 (菜单项("编译运行 F5")) { 运行(); }
                菜单结束();
            }
            菜单结束();
        }

        // ── 文件浏览器 ──
        窗口开始("文件");
        如果 (按钮(".. 上级目录")) {
            变量 sep = 倒查找(当前目录, "\\");
            如果 (sep == -1) { sep = 倒查找(当前目录, "/"); }
            如果 (sep > 0) { 当前目录 = 子串(当前目录, 0, sep); }
            否则 { 当前目录 = "."; }
            刷新列表();
        }
        文本("目录: " + 当前目录);
        分隔线();

        变量 fi = 0;
        当 (fi < 数组长(文件列表)) {
            变量 fn = 文件列表[fi];
            变量 fp = 当前目录 + "\\" + fn;
            如果 (是目录(fp)) {
                如果 (小按钮("> " + fn)) {
                    当前目录 = fp;
                    刷新列表();
                }
            } 否则 {
                如果 (小按钮("  " + fn)) {
                    打开(fp);
                }
            }
            fi = fi + 1;
        }
        窗口结束();

        // ── 编辑器 ──
        窗口开始("编辑器");
        变量 lc = 1;
        变量 p = 0;
        当 (p < 长度(编辑器内容)) {
            如果 (子串(编辑器内容, p, p + 1) == "\n") { lc = lc + 1; }
            p = p + 1;
        }
        文本("行:" + 转字符串(lc) + " | " + 当前文件);
        分隔线();

        变量 r = 多行输入文本("##code", 编辑器内容, -1, 500);
        如果 (表取(r, "changed")) {
            编辑器内容 = 表取(r, "v");
        }

        分隔线();
        如果 (可折叠标题("输出")) {
            如果 (按钮("清空")) { 输出内容 = ""; }
            同行();
            如果 (按钮("运行")) { 运行(); }
            分隔线();
            自动换行文本(输出内容);
        }
        窗口结束();

        界面结束绘制();
        结束绘制();
    }

    关闭窗口();
}

主();