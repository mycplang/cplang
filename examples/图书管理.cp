// ═══════════════════════════════════════════════════════
//  图书管理系统 — 纯中文 CP 语言示例
//  功能: 添加图书 / 查看列表 / 搜索 / 统计 / 保存读取
// ═══════════════════════════════════════════════════════

// ── 数据结构 ──
变量 图书库 = [];           // 每本图书: {书名, 作者, 年份, 价格, 已借}
变量 数据文件 = "图书数据.json";

// ── 辅助函数 ──
函数 显示标题(文字) {
    打印("╔══════════════════════════════════╗");
    打印("║  " + 文字);
    打印("╚══════════════════════════════════╝");
}

函数 显示分隔线() {
    打印("────────────────────────────────────");
}

// ── 核心功能 ──
函数 添加图书(书名, 作者, 年份, 价格) {
    变量 新书 = 表创建(["书名", "作者", "年份", "价格", "已借"], 
                       [书名, 作者, 年份, 价格, 假]);
    追加(图书库, 新书);
    打印("? 已添加: 《" + 书名 + "》 - " + 作者);
    保存数据();
}

函数 列出图书() {
    显示标题("?? 全部图书 (" + 转字符串(表长(图书库)) + " 本)");
    如果 (表长(图书库) == 0) {
        打印("  暂无图书，请添加。");
        返回;
    }
    
    变量 编号 = 1;
    变量 i = 0;
    当 (i < 表长(图书库)) {
        变量 书 = 图书库[i];
        变量 状态 = "?? 可借";
        如果 (表取(书, "已借")) {
            状态 = "?? 已借出";
        }
        打印("  " + 转字符串(编号) + ". 《" + 表取(书, "书名") + "》" + 
               " | " + 表取(书, "作者") + 
               " | " + 转字符串(表取(书, "年份")) + 
               " | ￥" + 转字符串(表取(书, "价格")) + 
               " | " + 状态);
        编号 = 编号 + 1;
        i = i + 1;
    }
    显示分隔线();
}

函数 搜索图书(关键词) {
    显示标题("?? 搜索: " + 关键词);
    变量 结果数 = 0;
    变量 i = 0;
    当 (i < 表长(图书库)) {
        变量 书 = 图书库[i];
        变量 书名 = 表取(书, "书名");
        变量 作者 = 表取(书, "作者");
        如果 (包含(书名, 关键词) || 包含(作者, 关键词)) {
            打印("  ?? 《" + 书名 + "》— " + 作者 + " (" + 转字符串(表取(书, "年份")) + ")");
            结果数 = 结果数 + 1;
        }
        i = i + 1;
    }
    如果 (结果数 == 0) {
        打印("  未找到匹配结果。");
    } 否则 {
        打印("  共找到 " + 转字符串(结果数) + " 本");
    }
    显示分隔线();
}

函数 统计信息() {
    显示标题("?? 图书馆统计");
    变量 总数 = 表长(图书库);
    变量 已借数 = 0;
    变量 总价 = 0;
    变量 最早年份 = 9999;
    变量 最晚年份 = 0;
    变量 最贵价格 = 0;
    变量 最贵书名 = "";
    
    变量 i = 0;
    当 (i < 总数) {
        变量 书 = 图书库[i];
        如果 (表取(书, "已借")) { 已借数 = 已借数 + 1; }
        变量 价格 = 表取(书, "价格");
        总价 = 总价 + 价格;
        变量 年份 = 表取(书, "年份");
        如果 (年份 < 最早年份) { 最早年份 = 年份; }
        如果 (年份 > 最晚年份) { 最晚年份 = 年份; }
        如果 (价格 > 最贵价格) {
            最贵价格 = 价格;
            最贵书名 = 表取(书, "书名");
        }
        i = i + 1;
    }
    
    打印("  藏书总数: " + 转字符串(总数) + " 本");
    打印("  可借数量: " + 转字符串(总数 - 已借数) + " 本");
    打印("  已借数量: " + 转字符串(已借数) + " 本");
    打印("  总价值: ￥" + 转字符串(总价));
    如果 (总数 > 0) {
        打印("  平均价格: ￥" + 转字符串(整除(总价, 总数)));
        打印("  年代跨度: " + 转字符串(最早年份) + " ~ " + 转字符串(最晚年份));
        打印("  最贵图书: 《" + 最贵书名 + "》(￥" + 转字符串(最贵价格) + ")");
    }
    显示分隔线();
}

函数 借书(书名) {
    变量 i = 0;
    当 (i < 表长(图书库)) {
        变量 书 = 图书库[i];
        如果 (表取(书, "书名") == 书名 && !表取(书, "已借")) {
            表设(书, "已借", 真);
            打印("?? 已借出: 《" + 书名 + "》");
            保存数据();
            返回;
        }
        i = i + 1;
    }
    打印("? 无法借出: 《" + 书名 + "》(不存在或已借出)");
}

函数 还书(书名) {
    变量 i = 0;
    当 (i < 表长(图书库)) {
        变量 书 = 图书库[i];
        如果 (表取(书, "书名") == 书名 && 表取(书, "已借")) {
            表设(书, "已借", 假);
            打印("?? 已归还: 《" + 书名 + "》");
            保存数据();
            返回;
        }
        i = i + 1;
    }
    打印("? 无法归还: 《" + 书名 + "》(不存在或未借出)");
}

函数 删除图书(书名) {
    变量 新库 = [];
    变量 i = 0;
    变量 删除计数 = 0;
    当 (i < 表长(图书库)) {
        如果 (表取(图书库[i], "书名") != 书名) {
            追加(新库, 图书库[i]);
        } 否则 {
            删除计数 = 删除计数 + 1;
        }
        i = i + 1;
    }
    图书库 = 新库;
    如果 (删除计数 > 0) {
        打印("??? 已删除 " + 转字符串(删除计数) + " 本《" + 书名 + "》");
        保存数据();
    } 否则 {
        打印("? 未找到: 《" + 书名 + "》");
    }
}

// ── 数据持久化 ──
函数 保存数据() {
    变量 json = 转JSON(图书库);
    写入文件(数据文件, json);
}

函数 加载数据() {
    如果 (文件存在(数据文件)) {
        变量 内容 = 读取文件(数据文件);
        如果 (内容 != "" && 长度(内容) > 2) {
            图书库 = JSON解析(内容);
            打印("?? 已加载 " + 转字符串(表长(图书库)) + " 条数据");
        }
    }
}

// ── 示例数据 ──
函数 初始化示例数据() {
    如果 (表长(图书库) > 0) { 返回; }
    
    打印("?? 正在加载示例数据...");
    
    添加图书("三体", "刘慈欣", 2008, 68);
    添加图书("百年孤独", "马尔克斯", 1967, 55);
    添加图书("活着", "余华", 1993, 39);
    添加图书("红楼梦", "曹雪芹", 1791, 128);
    添加图书("1984", "乔治·奥威尔", 1949, 45);
    添加图书("围城", "钱钟书", 1947, 42);
    添加图书("平凡的世界", "路遥", 1986, 88);
    添加图书("人类简史", "尤瓦尔·赫拉利", 2011, 68);
    
    打印("? 示例数据加载完成");
    显示分隔线();
}

// ── 主菜单 ──
函数 显示菜单() {
    打印("");
    打印("┌───── 图书管理系统 v1.0 ─────┐");
    打印("│ 1. ?? 列出全部图书           │");
    打印("│ 2. ? 添加图书               │");
    打印("│ 3. ?? 搜索图书               │");
    打印("│ 4. ?? 统计信息               │");
    打印("│ 5. ?? 借书                   │");
    打印("│ 6. ?? 还书                   │");
    打印("│ 7. ??? 删除图书               │");
    打印("│ 0. ?? 退出                   │");
    打印("└──────────────────────────────┘");
}

// ── 主程序 ──
函数 主程序() {
    显示标题("?? 图书管理系统 — CP 纯中文示例");
    加载数据();
    
    // 如果数据文件为空，加载示例数据
    如果 (表长(图书库) == 0) {
        初始化示例数据();
        保存数据();
    }
    
    变量 运行中 = 真;
    当 (运行中) {
        显示菜单();
        
        变量 用户选择 = "";
        打印("请选择操作 (0-7): ");
        用户选择 = 输入();
        用户选择 = 修剪(用户选择);
        
        如果 (用户选择 == "1") {
            列出图书();
        }
        否则 如果 (用户选择 == "2") {
            打印("请输入书名:");
            变量 书名 = 修剪(输入());
            打印("请输入作者:");
            变量 作者 = 修剪(输入());
            打印("请输入出版年份:");
            变量 年份 = 转整数(修剪(输入()));
            打印("请输入价格:");
            变量 价格 = 转整数(修剪(输入()));
            添加图书(书名, 作者, 年份, 价格);
        }
        否则 如果 (用户选择 == "3") {
            打印("请输入搜索关键词:");
            变量 关键词 = 修剪(输入());
            搜索图书(关键词);
        }
        否则 如果 (用户选择 == "4") {
            统计信息();
        }
        否则 如果 (用户选择 == "5") {
            打印("请输入要借的书名:");
            借书(修剪(输入()));
        }
        否则 如果 (用户选择 == "6") {
            打印("请输入要还的书名:");
            还书(修剪(输入()));
        }
        否则 如果 (用户选择 == "7") {
            打印("请输入要删除的书名:");
            删除图书(修剪(输入()));
        }
        否则 如果 (用户选择 == "0") {
            打印("?? 感谢使用，再见！");
            运行中 = 假;
        }
        否则 {
            打印("?? 无效选项，请重新选择。");
        }
    }
}

// ── 启动 ──
主程序();

