// 打砖块 — CP + Raylib 纯中文
// 鼠标/方向键移动挡板，反弹球打砖块

变量 屏幕宽 = 800;
变量 屏幕高 = 600;

变量 挡板宽 = 100;
变量 挡板高 = 15;
变量 挡板X = (屏幕宽 - 挡板宽) / 2;
变量 挡板Y = 屏幕高 - 40;

变量 球X = 屏幕宽 / 2;
变量 球Y = 屏幕高 / 2;
变量 球半径 = 8;
变量 球速X = 4;
变量 球速Y = -4;

变量 砖块行 = 5;
变量 砖块列 = 10;
变量 砖块宽 = 75;
变量 砖块高 = 20;
变量 砖块间距 = 3;
变量 砖块偏移X = (屏幕宽 - 砖块列 * (砖块宽 + 砖块间距)) / 2;
变量 砖块偏移Y = 60;

变量 砖块存活 = [];
变量 r = 0;
当 (r < 砖块行) {
    变量 c = 0;
    当 (c < 砖块列) {
        追加(砖块存活, 真);
        c = c + 1;
    }
    r = r + 1;
}

变量 分数 = 0;
变量 生命 = 3;
变量 游戏结束 = 假;

函数 重置球() {
    球X = 屏幕宽 / 2;
    球Y = 屏幕高 / 2;
    球速X = 随机值(3, 5);
    如果 (随机值(0, 1) == 1) { 球速X = -球速X; }
    球速Y = -4;
}

初始化窗口(屏幕宽, 屏幕高, "CP 打砖块");
设置目标帧率(60);

当 (窗口应关闭() == 假 && 游戏结束 == 假) {

    // ── 移动挡板 ──
    变量 鼠标Xval = 鼠标X();
    如果 (鼠标Xval > 挡板宽 / 2 && 鼠标Xval < 屏幕宽 - 挡板宽 / 2) {
        挡板X = 鼠标Xval - 挡板宽 / 2;
    }
    如果 (键盘按下(键_左)) { 挡板X = 挡板X - 8; }
    如果 (键盘按下(键_右)) { 挡板X = 挡板X + 8; }
    如果 (挡板X < 0) { 挡板X = 0; }
    如果 (挡板X > 屏幕宽 - 挡板宽) { 挡板X = 屏幕宽 - 挡板宽; }

    // ── 移动球 ──
    球X = 球X + 球速X;
    球Y = 球Y + 球速Y;

    // 撞墙
    如果 (球X - 球半径 <= 0) { 球X = 球半径; 球速X = -球速X; }
    如果 (球X + 球半径 >= 屏幕宽) { 球X = 屏幕宽 - 球半径; 球速X = -球速X; }
    如果 (球Y - 球半径 <= 0) { 球Y = 球半径; 球速Y = -球速Y; }

    // 掉底
    如果 (球Y + 球半径 >= 屏幕高) {
        生命 = 生命 - 1;
        如果 (生命 <= 0) {
            游戏结束 = 真;
        } 否则 {
            重置球();
        }
    }

    // 撞挡板
    变量 挡板矩形 = rectangle(挡板X, 挡板Y, 挡板宽, 挡板高);
    变量 球点 = vector2(球X, 球Y);
    如果 (碰撞检测点矩形(球点, 挡板矩形)) {
        球Y = 挡板Y - 球半径;
        球速Y = -球速Y;
        变量 hitX = (球X - 挡板X) / 挡板宽;
        球速X = (hitX - 0.5) * 10;
    }

    // 撞砖块
    变量 br = 0;
    当 (br < 砖块行) {
        变量 bc = 0;
        当 (bc < 砖块列) {
            变量 idx = br * 砖块列 + bc;
            如果 (砖块存活[idx]) {
                变量 bx = 砖块偏移X + bc * (砖块宽 + 砖块间距);
                变量 by_ = 砖块偏移Y + br * (砖块高 + 砖块间距);
                变量 砖块矩形 = rectangle(bx, by_, 砖块宽, 砖块高);
                变量 球点2 = vector2(球X, 球Y);
                如果 (碰撞检测点矩形(球点2, 砖块矩形)) {
                    砖块存活[idx] = 假;
                    分数 = 分数 + 10;
                    球速Y = -球速Y;
                }
            }
            bc = bc + 1;
        }
        br = br + 1;
    }

    // 检查是否全部消灭
    变量 还剩砖块 = 假;
    变量 ci = 0;
    当 (ci < 表长(砖块存活) && 还剩砖块 == 假) {
        如果 (砖块存活[ci]) { 还剩砖块 = 真; }
        ci = ci + 1;
    }
    如果 (还剩砖块 == 假) {
        游戏结束 = 真;
    }

    // ── 渲染 ──
    开始绘图();
    清空背景(黑);

    绘制文本("CP 打砖块", 10, 10, 24, 白);
    绘制文本("分数: " + 分数, 200, 12, 20, 金);
    绘制文本("生命: " + 生命, 400, 12, 20, 粉);
    如果 (生命 <= 0) {
        绘制文本("GAME OVER", 280, 280, 40, 红);
    }
    如果 (还剩砖块 == 假) {
        绘制文本("YOU WIN!", 280, 280, 40, 绿);
    }

    绘制矩形(挡板X, 挡板Y, 挡板宽, 挡板高, 天蓝);

    变量 dr = 0;
    变量 colors = [红, 橙, 金, 绿, 天蓝];
    当 (dr < 砖块行) {
        变量 dc = 0;
        当 (dc < 砖块列) {
            变量 didx = dr * 砖块列 + dc;
            如果 (砖块存活[didx]) {
                变量 dbx = 砖块偏移X + dc * (砖块宽 + 砖块间距);
                变量 dby = 砖块偏移Y + dr * (砖块高 + 砖块间距);
                变量 col = colors[dr];
                绘制矩形(dbx, dby, 砖块宽, 砖块高, col);
            }
            dc = dc + 1;
        }
        dr = dr + 1;
    }

    绘制圆形(球X, 球Y, 球半径, 白);

    结束绘图();
}

关闭窗口();
