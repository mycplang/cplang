导入 "@cp/graphics";  // 图形模块 (Raylib 2D/3D + ImGui)
// ═══════════════════════════════════════════════════════════════
//  CP 游戏大厅 — 独立游戏启动器
//  扫描 games/ 目录，双击启动独立进程
// ═══════════════════════════════════════════════════════════════

变量 屏宽 = 800;
变量 屏高 = 600;

变量 深蓝 = {r:15,g:15,b:35,a:255};
变量 卡片色 = {r:30,g:30,b:55,a:255};
变量 悬停色 = {r:50,g:50,b:80,a:255};
变量 亮蓝 = {r:80,g:140,b:255,a:255};
变量 白色 = {r:255,g:255,b:255,a:255};
变量 灰色 = {r:150,g:150,b:160,a:255};
变量 金色 = {r:255,g:215,b:0,a:255};
变量 红色 = {r:255,g:60,b:60,a:255};
变量 绿色 = {r:80,g:220,b:80,a:255};
变量 酸橙色 = {r:0,g:255,b:0,a:255};

函数 画图标(名称, px, py, s) {
    如果 (strContains(名称, "俄罗斯")) {
        变量 cx = px + s/2; 变量 cy = py + s/2 - 10;
        变量 u = 整除(s, 8);
        绘制矩形(cx - u*2, cy - u*2, u*4, u, 亮蓝);
        绘制矩形(cx - u, cy - u, u*2, u, 亮蓝);
    }
    如果 (strContains(名称, "贪吃")) {
        变量 k = 0; 当 (k < 5) {
            变量 dir = 1; 如果 (k%2==1) { dir = -1; }
            绘制矩形(px + 20 + k*8, py + s/2 + dir*5, 7, 7, 酸橙色);
            k = k + 1;
        }
    }
    如果 (strContains(名称, "2048")) {
        绘制矩形(px + 10, py + 10, s - 20, s - 20, {r:237,g:194,b:46,a:255});
        绘制文本("2048", px + s/2 - 28, py + s/2 - 12, 24, 白色);
    }
    如果 (strContains(名称, "打方块")) {
        绘制矩形(px + s/2 - 28, py + s - 30, 56, 8, 酸橙色);
        绘制矩形(px + s/2 - 6, py + s - 38, 12, 12, 红色);
    }
    如果 (strContains(名称, "扫雷")) {
        绘制矩形(px + 12, py + 12, s - 24, s - 24, {r:180,g:200,b:220,a:255});
        绘制矩形(px + s/2 - 3, py + 18, 6, s - 36, {r:80,g:80,b:80,a:255});
        绘制矩形(px + s/2 - 14, py + s - 20, 28, 10, 红色);
    }
}

函数 在区域内(mx, my, rx, ry, rw, rh) {
    如果 (mx >= rx && mx <= rx + rw && my >= ry && my <= ry + rh) { 返回 真; }
    返回 假;
}

// ═══ 主程序 ═══════════════════════════════════════════════════
初始化窗口(屏宽, 屏高, "CP 游戏大厅");
设置目标帧率(60);

变量 files = fileGlob("games/*.cp");
变量 上次选中 = -1;
变量 上次帧 = 0;
变量 帧 = 0;
变量 调试信息 = "启动中...";
变量 最后点击 = "";

当 (窗口应关闭() == 假) {
    开始绘制();
    清除背景(深蓝);
    
    变量 mx = 鼠标X();
    变量 my = 鼠标Y();
    变量 点击 = 鼠标刚按下();
    帧 = 帧 + 1;
    
    绘制文本("CP 游戏大厅", 280, 25, 36, 白色);
    变量 n = 数组长(files);
    如果 (n == 0) {
        绘制文本("ERROR: games/ 目录下没有找到 .cp 文件！", 150, 300, 20, 红色);
        绘制文本("请创建 C:\\cplang\\games\\ 并放入游戏 .cp 文件", 130, 330, 16, 金色);
    } 否则 {
    绘制文本("共 " + 转字符串(n) + " 个游戏 | 双击图标开始 [调试:" + 最后点击 + "]", 220, 66, 14, 灰色);
    绘制线条(60, 85, 屏宽 - 60, 85, 灰色);
    
    // 桌面快捷方式网格: 3列
    变量 图标宽 = 130;
    变量 图标高 = 150;
    变量 sx = 整除(屏宽 - (3*图标宽 + 2*40), 2);
    变量 sy = 100;
    
    变量 行 = 0;
    当 (行 < 10) {
        变量 列 = 0;
        当 (列 < 3) {
            变量 idx = 行 * 3 + 列;
            如果 (idx < n) {
                变量 fpath = files[idx];
                变量 name = fpath;
                
                变量 cx = sx + 列 * (图标宽 + 40);
                变量 cy = sy + 行 * (图标高 + 30);
                变量 on = 在区域内(mx, my, cx, cy, 图标宽, 图标高);
                
                如果 (on) {
                    绘制矩形(cx - 4, cy - 4, 图标宽 + 8, 图标高 + 8, 悬停色);
                }
                变量 is = 图标宽 - 20;
                绘制矩形(cx + 10, cy + 5, is, is, 卡片色);
                画图标(name, cx + 10, cy + 5, is);
                如果 (on) { 绘制矩形(cx + 10, cy + 5, is, is, {r:255,g:255,b:255,a:25}); }
                绘制文本(name, cx + 整除(图标宽 - 长度(name)*7, 2), cy + is + 12, 16, 白色);
                
                // 双击启动
                如果 (on && 点击) {
                    变量 gap = 帧 - 上次帧;
                    最后点击 = "卡" + 转字符串(idx) + ":" + name + " g=" + 转字符串(gap);
                    如果 (上次选中 == idx && gap > 3 && gap < 60) {
                        最后点击 = "启动 " + name + "!";
                        结束绘制();
                        procSystem("build_llvm\\bin\\Release\\cplang.exe -c " + fpath);
                        最后点击 = name + " 已退出";
                    }
                    上次选中 = idx;
                    上次帧 = 帧;
                }
            }
            列 = 列 + 1;
        }
        行 = 行 + 1;
        如果 (行 * 3 >= n) { 行 = 10; }
    }
    }  // 结束 否则
    
    // 底部
    绘制文本("拖入 .cp 文件到 games/ 目录即可添加新游戏", 200, 屏高 - 20, 14, 灰色);
    
    结束绘制();
}

关闭窗口();
