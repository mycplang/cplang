// 彩色文字示例 — 全中文版
函数 main() {
    初始化窗口(800, 600, "彩色文字示例");
    设置目标帧率(30);

    变量 y = 50;
    当 (!窗口应关闭()) {
        开始绘制();
        清空背景(深蓝);

        绘制文本("红色", 50, y, 40, 红色);
        绘制文本("金色", 200, y, 40, 金色);
        绘制文本("亮蓝", 350, y, 40, 亮蓝);
        绘制文本("绿色", 500, y, 40, 绿色);

        绘制文本("你好，", 50, y + 80, 36, 红色);
        绘制文本("恋语", 210, y + 80, 36, 亮蓝);
        绘制文本("♥", 370, y + 80, 36, 粉色);

        绘制文本("天蓝", 50, y + 160, 30, 天蓝);
        绘制文本("紫色", 200, y + 160, 30, 紫色);
        绘制文本("酸橙色", 350, y + 160, 30, 酸橙色);
        绘制文本("橙色", 500, y + 160, 30, 橙色);

        绘制文本("白色 灰色 金色 粉色", 50, y + 240, 28, 白色);
        绘制文本("灰色 灰色 灰色 灰色", 50, y + 300, 24, 灰色);
        绘制文本("小字测试 123 ABC", 50, y + 360, 20, 青色);

        绘制文本("按 ESC 退出", 50, y + 450, 18, 遮罩色);

        结束绘制();
    }
    关闭窗口();
}
