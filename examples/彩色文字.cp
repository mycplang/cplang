// 彩色文字示例 — 自定义字体
函数 main() {
    变量 y = 50;
    初始化窗口(800, 600, "彩色文字 - 自定义字体");
    设置目标帧率(30);

    // 加载系统字体（微软雅黑 / 黑体 / 宋体）
    变量 字体 = 加载字体("C:/Windows/Fonts/msyh.ttf", 36);
    变量 黑体 = 加载字体("C:/Windows/Fonts/simhei.ttf", 28);
    变量 宋体 = 加载字体("C:/Windows/Fonts/simsun.ttc", 24);

    当 (!窗口应关闭()) {
        开始绘制();
        清空背景(深蓝);

        // 先用默认字体显示标题
        绘制文本("彩色文字示例", 50, y, 40, 金色);

        // 使用自定义字体
        绘制文本("微软雅黑 36pt", 50, y + 80, 36, 亮蓝);
        绘制文本("黑体 28pt 你好", 50, y + 130, 28, 红色);
        绘制文本("宋体 24pt 恋语", 50, y + 180, 24, 绿色);

        // 各种颜色展示
        绘制文本("红色", 50, y + 250, 30, 红色);
        绘制文本("金色", 200, y + 250, 30, 金色);
        绘制文本("天蓝色", 350, y + 250, 30, 天蓝色);
        绘制文本("粉色", 500, y + 250, 30, 粉色);

        绘制文本("白色 灰色 酸橙色", 50, y + 320, 24, 白色);
        绘制文本("紫色 橙色 青色", 50, y + 380, 24, 青色);
        绘制文本("按 ESC 退出", 50, y + 480, 18, 遮罩色);

        结束绘制();
    }

    // 清理字体资源
    卸载字体(字体);
    卸载字体(黑体);
    卸载字体(宋体);
    关闭窗口();
}
