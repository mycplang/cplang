函数 main() {
    打印("你好，CP语言！");
    
    变量 书名 = "三体";
    变量 作者 = "刘慈欣";
    打印("《" + 书名 + "》作者: " + 作者);
    //打印("书名长度: " + 转字符串(长度(书名)));
    
    变量 分数 = [85, 92, 78, 95];
    变量 i = 0;
    当 (i < 长度(分数)) {
        打印("第" + 转字符串(i + 1) + "个分数: " + 转字符串(分数[i]));
        i = i + 1;
    }
    
    变量 结果 = 0;
    变量 j = 0;
    当 (j < 长度(分数)) {
        结果 = 结果 + 分数[j];
        j = j + 1;
    }
    打印("总分: " + 转字符串(结果));
    打印("平均分: " + 转字符串(结果 / 长度(分数)));
}