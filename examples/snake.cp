// 贪吃蛇 — CP + Raylib 纯中文
// 方向键控制，吃红方块成长

变量 格子大小 = 20;
变量 列数 = 40;
变量 行数 = 30;

变量 蛇X = [];
变量 蛇Y = [];
追加(蛇X, 10); 追加(蛇Y, 15);
追加(蛇X, 9);  追加(蛇Y, 15);
追加(蛇X, 8);  追加(蛇Y, 15);

变量 方向X = 1;
变量 方向Y = 0;
变量 食物X = 20;
变量 食物Y = 15;
变量 游戏结束 = 假;
变量 分数 = 0;
变量 帧计数 = 0;
变量 移动间隔 = 10;

函数 生成食物() {
    变量 ok = 假;
    当 (ok == 假) {
        食物X = 随机值(0, 列数 - 1);
        食物Y = 随机值(0, 行数 - 1);
        ok = 真;
        变量 长 = 表长(蛇X);
        变量 i = 0;
        当 (i < 长 && ok == 真) {
            如果 (蛇X[i] == 食物X && 蛇Y[i] == 食物Y) {
                ok = 假;
            }
            i = i + 1;
        }
    }
}

函数 重置游戏() {
    蛇X = []; 蛇Y = [];
    追加(蛇X, 10); 追加(蛇Y, 15);
    追加(蛇X, 9);  追加(蛇Y, 15);
    追加(蛇X, 8);  追加(蛇Y, 15);
    方向X = 1; 方向Y = 0;
    分数 = 0; 帧计数 = 0;
    游戏结束 = 假;
    生成食物();
}

初始化窗口(800, 620, "CP 贪吃蛇");
设置目标帧率(60);
生成食物();

当 (窗口应关闭() == 假) {
    如果 (键盘按下(键_上) && 方向Y == 0) { 方向X = 0; 方向Y = -1; }
    如果 (键盘按下(键_下) && 方向Y == 0) { 方向X = 0; 方向Y = 1; }
    如果 (键盘按下(键_左) && 方向X == 0) { 方向X = -1; 方向Y = 0; }
    如果 (键盘按下(键_右) && 方向X == 0) { 方向X = 1; 方向Y = 0; }
    如果 (键盘按下(键_R)) { 重置游戏(); }
    如果 (键盘按下(键_退出)) { 跳出; }

    帧计数 = 帧计数 + 1;
    如果 (游戏结束 == 假 && 帧计数 >= 移动间隔) {
        帧计数 = 0;

        变量 新头X = 蛇X[0] + 方向X;
        变量 新头Y = 蛇Y[0] + 方向Y;

        如果 (新头X < 0 || 新头X >= 列数 || 新头Y < 0 || 新头Y >= 行数) {
            游戏结束 = 真;
        }

        变量 长 = 表长(蛇X);
        变量 i = 0;
        当 (i < 长 && 游戏结束 == 假) {
            如果 (蛇X[i] == 新头X && 蛇Y[i] == 新头Y) {
                游戏结束 = 真;
            }
            i = i + 1;
        }

        如果 (游戏结束 == 假) {
            插入(蛇X, 0, 新头X);
            插入(蛇Y, 0, 新头Y);

            如果 (新头X == 食物X && 新头Y == 食物Y) {
                分数 = 分数 + 10;
                生成食物();
            } 否则 {
                弹出(蛇X);
                弹出(蛇Y);
            }
        }
    }

    开始绘图();
    清空背景(乳白);

    变量 cx = 0;
    当 (cx < 列数) {
        变量 cy = 0;
        当 (cy < 行数) {
            绘制矩形(cx * 格子大小, cy * 格子大小, 格子大小 - 1, 格子大小 - 1, 浅灰);
            cy = cy + 1;
        }
        cx = cx + 1;
    }

    变量 长 = 表长(蛇X);
    变量 idx = 0;
    当 (idx < 长) {
        变量 sx = 蛇X[idx] * 格子大小;
        变量 sy = 蛇Y[idx] * 格子大小;
        如果 (idx == 0) {
            绘制矩形(sx, sy, 格子大小 - 1, 格子大小 - 1, 深绿);
        } 否则 {
            绘制矩形(sx, sy, 格子大小 - 1, 格子大小 - 1, 绿);
        }
        idx = idx + 1;
    }

    绘制矩形(食物X * 格子大小, 食物Y * 格子大小, 格子大小 - 1, 格子大小 - 1, 红);

    绘制帧率(700, 10);
    绘制文本("CP 贪吃蛇", 10, 605, 20, 深灰);
    绘制文本("分数: " + 分数, 200, 605, 20, 蓝);
    如果 (游戏结束) {
        绘制文本("游戏结束! R重开 ESC退出", 400, 605, 20, 红);
    }

    结束绘图();
}

关闭窗口();
