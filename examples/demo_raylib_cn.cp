打印("=== CP纯中文游戏窗口 ===");
打印("用方向键移动红球，按空格画点");

初始化窗口(800, 600, "CP中文游戏 — 全中文API");
设置目标帧率(60);
初始化音频();

变量 圆X = 400;
变量 圆Y = 300;
变量 半径 = 50;
变量 速度 = 5;

当 (窗口应关闭() == 假) {
    如果 (键盘按下(键_左))  { 圆X = 圆X - 速度; }
    如果 (键盘按下(键_右))  { 圆X = 圆X + 速度; }
    如果 (键盘按下(键_上))  { 圆Y = 圆Y - 速度; }
    如果 (键盘按下(键_下))  { 圆Y = 圆Y + 速度; }

    开始绘图();
    清空背景(乳白);

    绘制文本("CP 全中文游戏开发", 10, 10, 28, 深灰);
    绘制文本("方向键←↑↓→移动 | 空格画点 | ESC退出", 10, 45, 18, 灰);
    绘制文本("鼠标: (" + 鼠标X() + "," + 鼠标Y() + ")", 10, 70, 16, 蓝);
    绘制帧率(700, 10);

    变量 鼠标位置 = 鼠标准位置();
    如果 (鼠标按下(鼠标_左键)) {
        绘制圆形(鼠标X(), 鼠标Y(), 8, 橙);
    }
    如果 (键盘按下(键_空格)) {
        绘制像素(圆X + 60, 圆Y, 红);
    }

    绘制圆形(圆X, 圆Y, 半径, 红);
    绘制圆形(圆X, 圆Y, 5, 黑);
    绘制圆形(圆X, 圆Y, 2, 白);

    结束绘图();
}

关闭音频();
关闭窗口();
打印("游戏窗口已关闭");
