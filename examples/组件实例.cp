// CP语言 raylib 常用组件实例
// 演示：窗口、绘制、输入、颜色、字体、纹理、声音

函数 main() {
    初始化窗口(960, 640, "CP语言 raylib 组件实例");
    设置目标帧率(60);

    // ── 加载资源 ──
    变量 字体 = 加载字体("C:/Windows/Fonts/msyh.ttf", 32);
    变量 纹理 = 加载纹理("资源/图标.png");  // 换成你自己的图片路径

    // ── 状态变量 ──
    变量 帧数 = 0;
    变量 点击次数 = 0;
    变量 滑块值 = 50;

    当 (!窗口应关闭()) {
        帧数 = 帧数 + 1;

        // ── 输入检测 ──
        变量 mx = 鼠标X();
        变量 my = 鼠标Y();
        如果 (鼠标刚按下(MOUSE_LEFT_BUTTON)) {
            点击次数 = 点击次数 + 1;
        }
        如果 (键盘按下(KEY_RIGHT)) { 滑块值 = 滑块值 + 5; }
        如果 (键盘按下(KEY_LEFT))  { 滑块值 = 滑块值 - 5; }
        如果 (键盘按下(KEY_SPACE)) { 滑块值 = 50; }
        滑块值 = 最大(0, 最小(100, 滑块值));

        开始绘制();
        清空背景(深蓝);

        // ════════════════════════════════════════════
        // 1. 文字绘制（默认字体 + 自定义字体）
        // ════════════════════════════════════════════
        绘制文本("CP语言 组件实例", 320, 20, 36, 金色);      // 默认字体
        绘制文本("FPS: " + 转字符串(获取帧率()), 20, 20, 20, 亮蓝);
        绘制文本("点击: " + 转字符串(点击次数), 20, 50, 20, 绿色);

        // ════════════════════════════════════════════
        // 2. 几何图形绘制
        // ════════════════════════════════════════════
        绘制文本("几何图形", 50, 100, 24, 白色);
        绘制矩形(50, 140, 80, 60, 红色);            // 实心矩形
        绘制矩形(150, 140, 80, 60, 金色);
        绘制圆形(300, 170, 35, 亮蓝);                // 实心圆
        绘制圆形(400, 170, 35, 绿色);
        绘制线条(500, 150, 580, 190, 粉色);          // 线段
        绘制线条(500, 190, 580, 150, 橙色);
        绘制三角形(650, 190, 700, 140, 750, 190, 紫色); // 三角形

        // ════════════════════════════════════════════
        // 3. 颜色展示
        // ════════════════════════════════════════════
        绘制文本("内置颜色", 50, 230, 24, 白色);
        绘制矩形(50, 270, 40, 30, 红色);
        绘制矩形(100, 270, 40, 30, 金色);
        绘制矩形(150, 270, 40, 30, 亮蓝);
        绘制矩形(200, 270, 40, 30, 绿色);
        绘制矩形(250, 270, 40, 30, 粉色);
        绘制矩形(300, 270, 40, 30, 紫色);
        绘制矩形(350, 270, 40, 30, 橙色);
        绘制矩形(400, 270, 40, 30, 天蓝色);
        绘制矩形(450, 270, 40, 30, 青色);
        绘制矩形(500, 270, 40, 30, 酸橙色);
        绘制矩形(550, 270, 40, 30, 白色);
        绘制矩形(600, 270, 40, 30, 灰色);

        // ════════════════════════════════════════════
        // 4. 自定义字体展示
        // ════════════════════════════════════════════
        绘制文本("自定义字体", 50, 330, 24, 白色);
        绘制文本("微软雅黑 32pt 中文", 50, 370, 32, 亮蓝);
        绘制文本("微软雅黑 24pt 红", 50, 410, 24, 红色);
        绘制文本("微软雅黑 18pt 绿", 50, 445, 18, 绿色);

        // ════════════════════════════════════════════
        // 5. 交互控件示例
        // ════════════════════════════════════════════
        绘制文本("交互控件", 500, 330, 24, 白色);

        // 滑块条（← → 键控制）
        绘制文本("滑块: " + 转字符串(滑块值), 500, 370, 20, 金色);
        绘制矩形(500, 400, 200, 12, 灰色);           // 轨道
        绘制矩形(500 + 滑块值 * 2 - 6, 395, 12, 22, 亮蓝); // 滑块

        // 动态圆（鼠标跟随）
        mx = 鼠标X();
        my = 鼠标Y();
        绘制文本("鼠标位置: " + 转字符串(mx) + ", " + 转字符串(my), 500, 440, 18, 青色);
        绘制圆形(mx, my, 8, 粉色);              // 鼠标跟随圆

        // ════════════════════════════════════════════
        // 6. 纹理绘制（如果有纹理）
        // ════════════════════════════════════════════
        绘制文本("纹理图片", 50, 490, 24, 白色);
        // 如果纹理加载成功就画出来
        // 绘制纹理(纹理, 50, 530, 白色);

        // ════════════════════════════════════════════
        // 7. FPS 和提示
        // ════════════════════════════════════════════
        绘制文本("帧数: " + 转字符串(帧数), 700, 600, 16, 灰色);
        绘制文本("← → 调节滑块 | 空格重置 | 点击计数", 300, 600, 16, 遮罩色);

        结束绘制();
    }

    // ── 释放资源 ──
    卸载字体(字体);
    // 卸载纹理(纹理);
    关闭窗口();
}
