// CP 常用组件实例 — 窗口、图形、颜色、输入、字体
函数 main() {
    初始化窗口(960, 640, "CP 组件实例");
    设置目标帧率(60);

    变量 帧数 = 0;
    变量 点击 = 0;
    变量 滑块 = 50;

    当 (!窗口应关闭()) {
        帧数 = 帧数 + 1;

        // 输入
        变量 mx = 鼠标X();
        变量 my = 鼠标Y();
        如果 (鼠标刚按下(MOUSE_LEFT_BUTTON)) { 点击 = 点击 + 1; }
        如果 (键盘按下(KEY_RIGHT)) { 滑块 = 滑块 + 5; }
        如果 (键盘按下(KEY_LEFT))  { 滑块 = 滑块 - 5; }
        如果 (键盘按下(KEY_SPACE)) { 滑块 = 50; }
        滑块 = max(0, min(100, 滑块));

        开始绘制();
        清空背景(深蓝);

        // 标题
        绘制文本("CP 组件实例", 350, 20, 36, 金色);
        绘制文本("FPS: " + 转字符串(获取帧率()), 20, 20, 20, 亮蓝);
        绘制文本("点击: " + 转字符串(点击), 20, 50, 20, 绿色);

        // 图形
        绘制文本("几何图形", 50, 100, 20, 白色);
        绘制矩形(50, 130, 70, 50, 红色);
        绘制矩形(140, 130, 70, 50, 金色);
        绘制圆形(280, 155, 30, 亮蓝);
        绘制圆形(380, 155, 30, 绿色);
        绘制线条(480, 140, 540, 170, 粉色);
        绘制线条(480, 170, 540, 140, 橙色);
        绘制三角形(620, 170, 670, 130, 720, 170, 紫色);

        // 颜色色板
        绘制文本("内置颜色", 50, 210, 20, 白色);
        绘制矩形(50, 240, 35, 25, 红色);
        绘制矩形(90, 240, 35, 25, 金色);
        绘制矩形(130, 240, 35, 25, 亮蓝);
        绘制矩形(170, 240, 35, 25, 绿色);
        绘制矩形(210, 240, 35, 25, 粉色);
        绘制矩形(250, 240, 35, 25, 紫色);
        绘制矩形(290, 240, 35, 25, 橙色);
        绘制矩形(330, 240, 35, 25, 天蓝色);
        绘制矩形(370, 240, 35, 25, 青色);
        绘制矩形(410, 240, 35, 25, 酸橙色);
        绘制矩形(450, 240, 35, 25, 白色);
        绘制矩形(490, 240, 35, 25, 灰色);

        // 滑块
        绘制文本("滑块: " + 转字符串(滑块), 500, 100, 20, 金色);
        绘制矩形(500, 130, 200, 10, 灰色);
        绘制矩形(500 + 滑块 * 2 - 5, 125, 10, 20, 亮蓝);

        // 鼠标
        my = 鼠标Y();
        mx = 鼠标X();
        绘制文本("鼠标: " + 转字符串(mx) + "," + 转字符串(my), 500, 170, 18, 青色);
        绘制圆形(mx, my, 6, 粉色);

        // 提示
        绘制文本("← → 滑块 | 空格重置 | 点击计数", 300, 620, 16, 遮罩色);

        结束绘制();
    }
    关闭窗口();
}
