// CP ImGui 组件实例 — 按钮、输入框、滑块、复选、单选、表格、颜色
函数 main() {
    初始化窗口(960, 640, "CP 界面组件");
    设置目标帧率(60);

    // ImGui 初始化
    界面初始化();
    变量 已打开 = true;
    变量 文本 = "";
    变量 数值 = 50;
    变量 浮点 = 0.5;
    变量 复选框 = true;
    变量 单选 = 0;
    变量 颜色 = {r: 255, g: 100, b: 100, a: 255};

    当 (!窗口应关闭()) {
        开始绘制();
        清空背景(深蓝);

        // 开始 ImGui 帧
        界面开始绘制();

        // ═══ 主窗口 ═══
        窗口开始("CP 组件演示", 已打开);
        文本("常用界面组件一览");

        分隔线();

        // ── 按钮 ──
        文本("按钮:");
        如果 (按钮("点我")) { 点击次数 = 点击次数 + 1; }
        同行(); 小按钮("小按钮");
        同行(); 箭头按钮("##ar", 1);  // 1=右方向

        // ── 复选框 ──
        复选框("启用选项", 复选框);

        // ── 单选框 ──
        单选框("选项 A", 单选, 0);
        同行(); 单选框("选项 B", 单选, 1);
        同行(); 单选框("选项 C", 单选, 2);

        // ── 滑块 ──
        整数滑块("数值: " + 转字符串(数值), 数值, 0, 100);
        浮点滑块("浮点: " + 转字符串(浮点), 浮点, 0.0, 1.0);

        // ── 输入框 ──
        输入文本("输入文字", 文本);
        输入整数("输入整数", 数值);
        输入浮点("输入浮点", 浮点);

        // ── 颜色 ──
        颜色编辑3("颜色 RGB", 颜色);

        // ── 下拉框 ──
        变量 选项 = "选项 A";
        下拉框("选择", 选项, "选项 A\0选项 B\0选项 C\0");

        分隔线();
        文本("点击次数: " + 转字符串(点击次数));

        窗口结束();

        // 结束 ImGui 帧
        界面结束绘制();
        结束绘制();
    }

    界面结束();
    关闭窗口();
}
