函数 main() {
    初始化窗口(960, 640, "CP 界面组件");
    设置目标帧率(60);
    界面初始化();
    界面加载字体("C:/Windows/Fonts/simhei.ttf", 18);
    当 (!窗口应关闭()) {
        开始绘制();
        清空背景(深蓝);
        界面开始绘制();
        窗口开始("组件演示", true);
        文本("按钮、输入框、滑块、复选框、单选");
        如果 (按钮("点我")) { 打印("点击"); }
        同行(); 小按钮("小按钮");
        复选框("启用选项", true);
        整数滑块("数值", 50, 0, 100);
        输入文本("输入文字", "CP");
        igCombo("选项", "A", "A\0B\0C\0");
        窗口结束();
        界面结束绘制();
        结束绘制();
    }
    界面结束();
    关闭窗口();
}
