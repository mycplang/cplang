// ==========================================
// CP语言 示例 8: 匿名表（键值对）
// ==========================================

函数 主() {
    // 创建匿名表
    变量 配置 = {};
    配置.语言 = "CP语言";
    配置.版本 = "1.0.0";
    配置.作者 = "QClaw";
    
    打印("项目配置:");
    打印("  语言: " + 配置.语言);
    打印("  版本: " + 配置.版本);
    打印("  作者: " + 配置.作者);
    
    // 用作参数传递
    变量 用户 = {};
    用户.名字 = "张三";
    用户.邮箱 = "zhangsan@example.com";
    用户.年龄 = 25;
    
    打印("用户信息:");
    打印("  名字: " + 用户.名字);
    打印("  邮箱: " + 用户.邮箱);
    
    返回 0;
}