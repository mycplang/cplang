// ==========================================
// CP语言 示例 7: 结构体
// ==========================================

结构体 学生 {
    姓名;
    年龄;
    分数;
}

函数 创建学生(姓名, 年龄, 分数) {
    变量 s = 学生{姓名: 姓名, 年龄: 年龄, 分数: 分数};
    返回 s;
}

函数 打印学生信息(s) {
    打印("姓名: " + s.姓名);
    打印("年龄: " + 字符串(s.年龄));
    打印("分数: " + 字符串(s.分数));
    打印("---");
}

函数 主() {
    变量 小明 = 创建学生("小明", 18, 95);
    变量 小红 = 创建学生("小红", 17, 88);
    变量 小刚 = 创建学生("小刚", 19, 72);
    
    打印学生信息(小明);
    打印学生信息(小红);
    打印学生信息(小刚);
    
    返回 0;
}