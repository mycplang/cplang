// ==========================================
// CP语言 示例 5: 函数与递归
// ==========================================

// 阶乘：递归实现
函数 阶乘(n) {
    如果 (n <= 1) {
        返回 1;
    }
    返回 n * 阶乘(n - 1);
}

// 斐波那契数列
函数 斐波那契(n) {
    如果 (n == 0) { 返回 0; }
    如果 (n == 1) { 返回 1; }
    返回 斐波那契(n - 1) + 斐波那契(n - 2);
}

函数 主() {
    打印("5! = " + 字符串(阶乘(5)));
    打印("10! = " + 字符串(阶乘(10)));
    
    打印("斐波那契(0-10):");
    变量 i = 0;
    当 (i <= 10) {
        打印("F(" + 字符串(i) + ") = " + 字符串(斐波那契(i)));
        i = i + 1;
    }
    返回 0;
}