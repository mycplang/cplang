// ==========================================
// CP语言 示例 3: 条件判断
// ==========================================

函数 成绩评定(分数) {
    如果 (分数 >= 90) {
        返回 "优秀";
    } 否则 如果 (分数 >= 80) {
        返回 "良好";
    } 否则 如果 (分数 >= 70) {
        返回 "中等";
    } 否则 如果 (分数 >= 60) {
        返回 "及格";
    } 否则 {
        返回 "不及格";
    }
}

函数 主() {
    打印("95分 → " + 成绩评定(95));
    打印("82分 → " + 成绩评定(82));
    打印("71分 → " + 成绩评定(71));
    打印("65分 → " + 成绩评定(65));
    打印("45分 → " + 成绩评定(45));
    返回 0;
}