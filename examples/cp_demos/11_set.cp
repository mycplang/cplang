// 集合类型演示
函数 主() {
    变量 s = 集合新建();
    集合添加(s, 1);
    集合添加(s, 2);
    集合添加(s, 3);
    集合添加(s, 2);  // 重复元素，不会添加

    打印("集合大小: " + 字符串(集合大小(s)));
    打印("包含2: " + 字符串(集合包含(s, 2)));
    打印("包含5: " + 字符串(集合包含(s, 5)));

    集合删除(s, 2);
    打印("删除2后大小: " + 字符串(集合大小(s)));
    打印("包含2: " + 字符串(集合包含(s, 2)));

    变量 s2 = 集合新建();
    集合添加(s2, 3);
    集合添加(s2, 4);
    集合添加(s2, 5);

    变量 u = 集合并集(s, s2);
    打印("并集大小: " + 字符串(集合大小(u)));

    变量 i = 集合交集(s, s2);
    打印("交集大小: " + 字符串(集合大小(i)));

    变量 d = 集合差集(s, s2);
    打印("差集大小: " + 字符串(集合大小(d)));
    
    返回 0;
}
