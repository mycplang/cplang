// ==========================================
// CP语言 示例 10: 综合 — 学生成绩管理系统
// ==========================================

结构体 学生 {
    学号;
    姓名;
    分数;
}

函数 计算平均分(学生列表) {
    变量 总分 = 0;
    循环 (s : 学生列表) {
        总分 = 总分 + s.分数;
    }
    返回 总分 / 长度(学生列表);
}

函数 查找最高分(学生列表) {
    变量 最高 = 学生列表[0];
    循环 (s : 学生列表) {
        如果 (s.分数 > 最高.分数) {
            最高 = s;
        }
    }
    返回 最高;
}

函数 主() {
    // 录入学生数据
    变量 s1 = 学生{学号: "001", 姓名: "张三", 分数: 92};
    变量 s2 = 学生{学号: "002", 姓名: "李四", 分数: 85};
    变量 s3 = 学生{学号: "003", 姓名: "王五", 分数: 78};
    变量 s4 = 学生{学号: "004", 姓名: "赵六", 分数: 96};
    
    变量 班级 = [s1, s2, s3, s4];
    
    打印("===== 学生成绩管理系统 =====");
    打印("学生总数: " + 转字符串(长度(班级)));
    打印("平均分: " + 转字符串(计算平均分(班级)));
    
    变量 第一名 = 查找最高分(班级);
    打印("最高分: " + 第一名.姓名 + " (" + 第一名.学号 + ") " + 字符串(第一名.分数) + "分");
    
    返回 0;
}