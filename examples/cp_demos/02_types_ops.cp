// ==========================================
// CP语言 示例 2: 变量、类型与运算
// ==========================================

函数 主() {
    // 整数运算
    变量 a = 10;
    变量 b = 3;
    打印("a + b = " + 字符串(a + b));
    打印("a - b = " + 字符串(a - b));
    打印("a * b = " + 字符串(a * b));
    打印("a / b = " + 字符串(a / b));
    
    // 浮点数
    变量 pi = 3.14159;
    打印("pi = " + 字符串(pi));
    
    // 布尔
    变量 真值 = 真;
    变量 假值 = 假;
    打印("真 and 假 = " + 字符串(真值 且 假值));
    打印("真 or 假 = " + 字符串(真值 或 假值));
    
    // 字符串
    变量 问候 = "你好";
    变量 对象 = "CP语言";
    打印(问候 + "，" + 对象 + "！");
    
    返回 0;
}