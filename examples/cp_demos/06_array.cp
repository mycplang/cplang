// ==========================================
// CP语言 示例 6: 数组操作
// ==========================================

函数 数组求和(arr) {
    变量 sum = 0;
    变量 i = 0;
    当 (i < 长度(arr)) {
        sum = sum + arr[i];
        i = i + 1;
    }
    返回 sum;
}

函数 数组最大值(arr) {
    变量 max = arr[0];
    变量 i = 1;
    当 (i < 长度(arr)) {
        如果 (arr[i] > max) {
            max = arr[i];
        }
        i = i + 1;
    }
    返回 max;
}

函数 主() {
    变量 数字 = [3, 7, 2, 9, 1, 5, 8, 4, 6];
    
    打印("数组: [3, 7, 2, 9, 1, 5, 8, 4, 6]");
    打印("长度: " + 字符串(长度(数字)));
    打印("求和: " + 字符串(数组求和(数字)));
    打印("最大值: " + 字符串(数组最大值(数字)));
    
    打印("第3个元素: " + 字符串(数字[2]));
    数字[2] = 100;
    打印("修改后第3个元素: " + 字符串(数字[2]));
    
    返回 0;
}