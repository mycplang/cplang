// ==========================================
// CP语言 示例 4: 循环
// ==========================================

函数 主() {
    打印("=== 计数循环 ===");
    变量 i = 0;
    当 (i < 5) {
        打印("第 " + 字符串(i + 1) + " 次");
        i = i + 1;
    }
    
    打印("=== 数组遍历 ===");
    变量 水果 = ["苹果", "香蕉", "橙子", "葡萄"];
    遍历 (水果 : 水果) {
        打印(水果);
    }
    
    返回 0;
}