打印("=== MINIMAL SNAKE DEBUG ===");

变量 格 = 20;
变量 列 = 40;
变量 行 = 30;

打印("vars ok");

变量 蛇X = []; 变量 蛇Y = [];
追加(蛇X, 10); 追加(蛇Y, 15);
追加(蛇X, 9);  追加(蛇Y, 15);
追加(蛇X, 8);  追加(蛇Y, 15);

打印("arrays ok");

变量 方向X = 1; 变量 方向Y = 0;
变量 食物X = 20; 变量 食物Y = 15;
变量 分数 = 0; 变量 帧 = 0; 变量 速度 = 12;
变量 活 = 1;

打印("vars2 ok");

// 颜色表（绕过颜色函数名解析 bug）
var 黑 = {r: 0, g: 0, b: 0, a: 255};
var 白 = {r: 255, g: 255, b: 255, a: 255};
var 红 = {r: 230, g: 41, b: 55, a: 255};
var 绿 = {r: 0, g: 158, b: 47, a: 255};
var 蓝 = {r: 0, g: 121, b: 241, a: 255};
var 金 = {r: 255, g: 203, b: 0, a: 255};
var 灰 = {r: 130, g: 130, b: 130, a: 255};
var 深灰 = {r: 80, g: 80, b: 80, a: 255};
var 浅灰 = {r: 200, g: 200, b: 200, a: 255};
var 深绿 = {r: 0, g: 117, b: 44, a: 255};
var 亮绿 = {r: 0, g: 228, b: 48, a: 255};
var 乳白 = {r: 245, g: 245, b: 245, a: 255};
var 青柠 = {r: 0, g: 228, b: 48, a: 255};

打印("calling initWindow...");
初始化窗口(列 * 格, 行 * 格 + 30, "CP Snake");
打印("初始化窗口 done");

打印("calling 设置目标帧率...");
设置目标帧率(60);
打印("设置目标帧率 done");

当 (活) {
    如果 (窗口应关闭()) { 活 = 0; }

    如果 (键盘按下(键_上) && 方向Y == 0) { 方向X = 0; 方向Y = -1; }
    如果 (键盘按下(键_下) && 方向Y == 0) { 方向X = 0; 方向Y = 1; }
    如果 (键盘按下(键_左) && 方向X == 0) { 方向X = -1; 方向Y = 0; }
    如果 (键盘按下(键_右) && 方向X == 0) { 方向X = 1; 方向Y = 0; }

    如果 (键盘按下(键_R)) {
        蛇X = []; 蛇Y = [];
        追加(蛇X, 10); 追加(蛇Y, 15);
        追加(蛇X, 9);  追加(蛇Y, 15);
        追加(蛇X, 8);  追加(蛇Y, 15);
        方向X = 1; 方向Y = 0; 分数 = 0; 帧 = 0; 速度 = 12;
        打印("RESTART");
    }
    如果 (键盘按下(键_退出)) { 活 = 0; }

    帧 = 帧 + 1;
    如果 (帧 >= 速度) {
        帧 = 0;
        变量 头X = 蛇X[0] + 方向X;
        变量 头Y = 蛇Y[0] + 方向Y;

        如果 (头X < 0 || 头X >= 列 || 头Y < 0 || 头Y >= 行) {
            打印("WALL! Score: " + 分数);
            活 = 0;
        }

        变量 长 = 表长(蛇X);
        变量 i = 0;
        当 (i < 长 && 活) {
            如果 (蛇X[i] == 头X && 蛇Y[i] == 头Y) {
                打印("SELF! Score: " + 分数);
                活 = 0;
            }
            i = i + 1;
        }

        如果 (活) {
            插入(蛇X, 0, 头X);
            插入(蛇Y, 0, 头Y);

            如果 (头X == 食物X && 头Y == 食物Y) {
                分数 = 分数 + 10;
                如果 (分数 % 50 == 0 && 速度 > 4) { 速度 = 速度 - 1; }
                变量 ok = 0;
                当 (ok == 0) {
                    食物X = 随机值(0, 列 - 1);
                    食物Y = 随机值(0, 行 - 1);
                    ok = 1;
                    变量 j = 0;
                    当 (j < 表长(蛇X)) {
                        如果 (蛇X[j] == 食物X && 蛇Y[j] == 食物Y) { ok = 0; }
                        j = j + 1;
                    }
                }
            } 否则 {
                弹出(蛇X);
                弹出(蛇Y);
            }
        }
    }

    开始绘图();
    清空背景(黑);

    变量 cx = 0;
    当 (cx < 列) {
        变量 cy = 0;
        当 (cy < 行) {
            绘制矩形(cx * 格, cy * 格, 格 - 1, 格 - 1, 深灰);
            cy = cy + 1;
        }
        cx = cx + 1;
    }

    变量 idx = 0;
    当 (idx < 表长(蛇X)) {
        变量 sx = 蛇X[idx] * 格;
        变量 sy = 蛇Y[idx] * 格;
        如果 (idx == 0) {
            绘制矩形(sx, sy, 格 - 1, 格 - 1, 绿);
        } 否则 {
            绘制矩形(sx, sy, 格 - 1, 格 - 1, 亮绿);
        }
        idx = idx + 1;
    }

    绘制矩形(食物X * 格, 食物Y * 格, 格 - 1, 格 - 1, 红);
    绘制帧率(700, 行 * 格 + 4);

    结束绘图();
}

打印("GAME OVER  Score: " + 分数);
关闭窗口();
