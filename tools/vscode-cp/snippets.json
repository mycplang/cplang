{
  "函数定义": {
    "prefix": ["函数", "function", "fn"],
    "body": ["函数 ${1:函数名}(${2:参数}) {", "\t${3:主体}", "}"],
    "description": "定义一个新函数"
  },
  "变量声明": {
    "prefix": ["变量", "var"],
    "body": ["变量 ${1:变量名} = ${2:值};"],
    "description": "声明一个变量"
  },
  "常量声明": {
    "prefix": ["常量", "const"],
    "body": ["常量 ${1:常量名} = ${2:值};"],
    "description": "声明一个常量"
  },
  "如果条件": {
    "prefix": ["如果", "if"],
    "body": ["如果 (${1:条件}) {", "\t${2:主体}", "}"],
    "description": "if 条件语句"
  },
  "如果否则": {
    "prefix": ["如果否则", "ifelse"],
    "body": ["如果 (${1:条件}) {", "\t${2:主体}", "} 否则 {", "\t${3:否则分支}", "}"],
    "description": "if-else 条件语句"
  },
  "当循环": {
    "prefix": ["当", "while"],
    "body": ["当 (${1:条件}) {", "\t${2:主体}", "}"],
    "description": "while 循环"
  },
  "循环": {
    "prefix": ["循环", "for"],
    "body": ["循环 (${1:初始化}; ${2:条件}; ${3:递增}) {", "\t${4:主体}", "}"],
    "description": "for 循环"
  },
  "遍历": {
    "prefix": ["遍历", "foreach"],
    "body": ["遍历 (${1:变量}) {", "\t${2:主体}", "}"],
    "description": "forEach 遍历"
  },
  "选择语句": {
    "prefix": ["选择", "switch"],
    "body": ["选择 (${1:表达式}) {", "\t情况 ${2:值}: {", "\t\t${3:主体}", "\t}", "\t其他: {", "\t\t${4:默认}", "\t}", "}"],
    "description": "switch 选择语句"
  },
  "类声明": {
    "prefix": ["类", "class"],
    "body": ["类 ${1:类名} {", "\t${2:字段}", "}"],
    "description": "类定义"
  },
  "结构体": {
    "prefix": ["结构体", "struct"],
    "body": ["结构体 ${1:结构体名} {", "\t${2:字段}", "}"],
    "description": "结构体定义"
  },
  "导入模块": {
    "prefix": ["导入", "import"],
    "body": ["导入 \"${1:模块名}\";"],
    "description": "导入模块"
  },
  "打印输出": {
    "prefix": ["打印", "print"],
    "body": ["打印(${1:内容});"],
    "description": "打印输出"
  },
  "返回语句": {
    "prefix": ["返回", "return"],
    "body": ["返回 ${1:值};"],
    "description": "函数返回"
  },
  "主函数": {
    "prefix": ["main"],
    "body": ["函数 main() {", "\t${1:主体}", "}"],
    "description": "程序入口 main 函数"
  }
}