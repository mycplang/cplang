{
  "函数定义": {
    "prefix": ["函数", "function", "fn"],
    "body": ["函数 ${1:函数名}(${2:参数}) {", "\t${3:主体}", "}"],
    "description": "定义一个新函数"
  },
  "异步函数": {
    "prefix": ["异步", "async"],
    "body": ["异步 函数 ${1:函数名}(${2:参数}) {", "\t${3:主体}", "}"],
    "description": "定义异步函数"
  },
  "变量声明": {
    "prefix": ["变量", "var"],
    "body": ["变量 ${1:变量名} = ${2:值};"],
    "description": "声明变量"
  },
  "常量声明": {
    "prefix": ["常量", "const"],
    "body": ["常量 ${1:常量名} = ${2:值};"],
    "description": "声明常量"
  },
  "let绑定": {
    "prefix": ["设", "let"],
    "body": ["设 ${1:变量名} = ${2:值};"],
    "description": "let 绑定"
  },
  "如果条件": {
    "prefix": ["如果", "if"],
    "body": ["如果 (${1:条件}) {", "\t${2:主体}", "}"],
    "description": "if 条件语句"
  },
  "如果否则": {
    "prefix": ["ifelse"],
    "body": ["如果 (${1:条件}) {", "\t${2:主体}", "} 否则 {", "\t${3:否则分支}", "}"],
    "description": "if-else 条件语句"
  },
  "当循环": {
    "prefix": ["当", "while"],
    "body": ["当 (${1:条件}) {", "\t${2:主体}", "}"],
    "description": "while 循环"
  },
  "循环": {
    "prefix": ["循环", "for"],
    "body": ["循环 (${1:初始化}; ${2:条件}; ${3:递增}) {", "\t${4:主体}", "}"],
    "description": "for 循环"
  },
  "遍历": {
    "prefix": ["遍历", "foreach"],
    "body": ["遍历 (${1:变量} : ${2:容器}) {", "\t${3:主体}", "}"],
    "description": "forEach 遍历"
  },
  "选择语句": {
    "prefix": ["选择", "switch"],
    "body": ["选择 (${1:表达式}) {", "\t情况 ${2:值}: {", "\t\t${3:主体}", "\t\t跳出;", "\t}", "\t其他: {", "\t\t${4:默认}", "\t}", "}"],
    "description": "switch 选择语句"
  },
  "匹配表达式": {
    "prefix": ["匹配", "match"],
    "body": ["匹配 (${1:表达式}) {", "\t${2:模式1} => ${3:结果1};", "\t${4:模式2} => ${5:结果2};", "\t其他 => ${6:默认值};", "}"],
    "description": "match 模式匹配"
  },
  "类声明": {
    "prefix": ["类", "class"],
    "body": ["类 ${1:类名} {", "\t${2:成员}", "}"],
    "description": "类定义"
  },
  "结构体": {
    "prefix": ["结构体", "struct"],
    "body": ["结构体 ${1:结构体名} {", "\t${2:字段}", "}"],
    "description": "结构体定义"
  },
  "枚举": {
    "prefix": ["枚举", "enum"],
    "body": ["枚举 ${1:枚举名} {", "\t${2:变体1},", "\t${3:变体2}", "}"],
    "description": "枚举定义"
  },
  "接口": {
    "prefix": ["接口", "interface"],
    "body": ["接口 ${1:接口名} {", "\t${2:方法名}(${3:参数});", "}"],
    "description": "接口定义"
  },
  "尝试捕获": {
    "prefix": ["尝试", "try"],
    "body": ["尝试 {", "\t${1:主体}", "} 捕获 (${2:异常变量}) {", "\t${3:处理}", "}"],
    "description": "try-catch 异常处理"
  },
  "抛出异常": {
    "prefix": ["抛出", "throw"],
    "body": ["抛出 \"${1:异常消息}\";"],
    "description": "抛出异常"
  },
  "推迟执行": {
    "prefix": ["推迟", "defer"],
    "body": ["推迟 ${1:表达式};"],
    "description": "defer 延迟执行"
  },
  "导入模块": {
    "prefix": ["导入", "import"],
    "body": ["导入 \"${1:模块名}\";"],
    "description": "导入模块"
  },
  "打印输出": {
    "prefix": ["打印", "print"],
    "body": ["打印(${1:内容});"],
    "description": "打印输出"
  },
  "返回语句": {
    "prefix": ["返回", "return"],
    "body": ["返回 ${1:值};"],
    "description": "函数返回"
  },
  "主函数": {
    "prefix": ["main"],
    "body": ["函数 main() {", "\t${1:主体}", "}"],
    "description": "程序入口 main 函数"
  }
}
