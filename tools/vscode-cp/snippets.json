{
  "函数定义": {
    "prefix": ["函数", "function", "fn"],
    "body": ["函数 ${1:函数名}(${2:参数}) {", "\t${3:主体}", "}"],
    "description": "定义一个新函数"
  },
  "异步函数": {
    "prefix": ["异步", "async"],
    "body": ["异步 函数 ${1:函数名}(${2:参数}) {", "\t${3:主体}", "}"],
    "description": "定义异步函数"
  },
  "变量声明": {
    "prefix": ["变量", "var"],
    "body": ["变量 ${1:变量名} = ${2:值};"],
    "description": "声明变量"
  },
  "常量声明": {
    "prefix": ["常量", "const"],
    "body": ["常量 ${1:常量名} = ${2:值};"],
    "description": "声明常量"
  },
  "let绑定": {
    "prefix": ["设", "let"],
    "body": ["设 ${1:变量名} = ${2:值};"],
    "description": "let 绑定"
  },
  "如果条件": {
    "prefix": ["如果", "if"],
    "body": ["如果 (${1:条件}) {", "\t${2:主体}", "}"],
    "description": "if 条件语句"
  },
  "如果否则": {
    "prefix": ["ifelse"],
    "body": ["如果 (${1:条件}) {", "\t${2:主体}", "} 否则 {", "\t${3:否则分支}", "}"],
    "description": "if-else 条件语句"
  },
  "当循环": {
    "prefix": ["当", "while"],
    "body": ["当 (${1:条件}) {", "\t${2:主体}", "}"],
    "description": "while 循环"
  },
  "循环": {
    "prefix": ["循环", "for"],
    "body": ["循环 (${1:初始化}; ${2:条件}; ${3:递增}) {", "\t${4:主体}", "}"],
    "description": "for 循环"
  },
  "遍历": {
    "prefix": ["遍历", "foreach"],
    "body": ["遍历 (${1:变量} : ${2:容器}) {", "\t${3:主体}", "}"],
    "description": "forEach 遍历"
  },
  "选择语句": {
    "prefix": ["选择", "switch"],
    "body": ["选择 (${1:表达式}) {", "\t情况 ${2:值}: {", "\t\t${3:主体}", "\t\t跳出;", "\t}", "\t其他: {", "\t\t${4:默认}", "\t}", "}"],
    "description": "switch 选择语句"
  },
  "匹配表达式": {
    "prefix": ["匹配", "match"],
    "body": ["匹配 (${1:表达式}) {", "\t${2:模式1} => ${3:结果1};", "\t${4:模式2} => ${5:结果2};", "\t其他 => ${6:默认值};", "}"],
    "description": "match 模式匹配"
  },
  "类声明": {
    "prefix": ["类", "class"],
    "body": ["类 ${1:类名} {", "\t${2:成员}", "}"],
    "description": "类定义"
  },
  "结构体": {
    "prefix": ["结构体", "struct"],
    "body": ["结构体 ${1:结构体名} {", "\t${2:字段}", "}"],
    "description": "结构体定义"
  },
  "枚举": {
    "prefix": ["枚举", "enum"],
    "body": ["枚举 ${1:枚举名} {", "\t${2:变体1},", "\t${3:变体2}", "}"],
    "description": "枚举定义"
  },
  "接口": {
    "prefix": ["接口", "interface"],
    "body": ["接口 ${1:接口名} {", "\t${2:方法名}(${3:参数});", "}"],
    "description": "接口定义"
  },
  "尝试捕获": {
    "prefix": ["尝试", "try"],
    "body": ["尝试 {", "\t${1:主体}", "} 捕获 (${2:异常变量}) {", "\t${3:处理}", "}"],
    "description": "try-catch 异常处理"
  },
  "抛出异常": {
    "prefix": ["抛出", "throw"],
    "body": ["抛出 \"${1:异常消息}\";"],
    "description": "抛出异常"
  },
  "推迟执行": {
    "prefix": ["推迟", "defer"],
    "body": ["推迟 ${1:表达式};"],
    "description": "defer 延迟执行"
  },
  "导入模块": {
    "prefix": ["导入", "import"],
    "body": ["导入 \"${1:模块名}\";"],
    "description": "导入模块"
  },
  "打印输出": {
    "prefix": ["打印", "print"],
    "body": ["打印(${1:内容});"],
    "description": "打印输出"
  },
  "返回语句": {
    "prefix": ["返回", "return"],
    "body": ["返回 ${1:值};"],
    "description": "函数返回"
  },
  "主函数": {
    "prefix": ["main"],
    "body": ["函数 main() {", "\t${1:主体}", "}"],
    "description": "程序入口 main 函数"
  },
  "初始化窗口": {
    "prefix": ["初始化窗口", "initWindow"],
    "body": ["初始化窗口(${1:宽度}, ${2:高度}, \"${3:标题}\");"],
    "description": "创建 raylib 窗口"
  },
  "窗口应关闭": {
    "prefix": ["窗口应关闭", "windowShouldClose"],
    "body": ["窗口应关闭()"],
    "description": "检查窗口是否应该关闭"
  },
  "关闭窗口": {
    "prefix": ["关闭窗口", "closeWindow"],
    "body": ["关闭窗口();"],
    "description": "关闭 raylib 窗口"
  },
  "设置目标帧率": {
    "prefix": ["设置目标帧率", "setTargetFPS"],
    "body": ["设置目标帧率(${1:帧率});"],
    "description": "设置目标帧率"
  },
  "开始绘制": {
    "prefix": ["开始绘制", "beginDrawing"],
    "body": ["开始绘制();"],
    "description": "开始帧绘制"
  },
  "结束绘制": {
    "prefix": ["结束绘制", "endDrawing"],
    "body": ["结束绘制();"],
    "description": "结束帧绘制"
  },
  "清空背景": {
    "prefix": ["清空背景", "clearBackground"],
    "body": ["清空背景(${1:颜色});"],
    "description": "清空窗口背景"
  },
  "绘制文本": {
    "prefix": ["绘制文本", "drawText"],
    "body": ["绘制文本(\"${1:文字}\", ${2:x}, ${3:y}, ${4:大小}, ${5:颜色});"],
    "description": "在窗口上绘制文字"
  },
  "绘制矩形": {
    "prefix": ["绘制矩形", "drawRectangle"],
    "body": ["绘制矩形(${1:x}, ${2:y}, ${3:宽}, ${4:高}, ${5:颜色});"],
    "description": "绘制实心矩形"
  },
  "绘制圆形": {
    "prefix": ["绘制圆形", "drawCircle"],
    "body": ["绘制圆形(${1:cx}, ${2:cy}, ${3:半径}, ${4:颜色});"],
    "description": "绘制实心圆"
  },
  "绘制三角形": {
    "prefix": ["绘制三角形", "drawTriangle"],
    "body": ["绘制三角形(${1:x1}, ${2:y1}, ${3:x2}, ${4:y2}, ${5:x3}, ${6:y3}, ${7:颜色});"],
    "description": "绘制实心三角形"
  },
  "绘制线条": {
    "prefix": ["绘制线条", "drawLine"],
    "body": ["绘制线条(${1:x1}, ${2:y1}, ${3:x2}, ${4:y2}, ${5:颜色});"],
    "description": "绘制线段"
  },
  "键盘按下": {
    "prefix": ["键盘按下", "keyPressed"],
    "body": ["键盘按下(${1:键码});"],
    "description": "检测按键是否被按下"
  },
  "获取帧率": {
    "prefix": ["获取帧率", "getFPS"],
    "body": ["获取帧率();"],
    "description": "获取当前帧率"
  },
  "颜色函数": {
    "prefix": ["颜色", "color"],
    "body": ["颜色(${1:r}, ${2:g}, ${3:b}, ${4:a});"],
    "description": "创建颜色值"
  },
  "hex转rgb": {
    "prefix": ["hexToRgb"],
    "body": ["hexToRgb(${1:0xRRGGBB});"],
    "description": "十六进制转 RGB 表"
  },
  "控制台颜色": {
    "prefix": ["控制台颜色", "conColor"],
    "body": ["控制台颜色(${1:颜色});"],
    "description": "设置控制台文字颜色"
  },
  "控制台重置": {
    "prefix": ["控制台重置", "conReset"],
    "body": ["控制台重置();"],
    "description": "重置控制台颜色"
  },
  "控制台清屏": {
    "prefix": ["控制台清屏", "conClear"],
    "body": ["控制台清屏();"],
    "description": "清空控制台"
  }
}
