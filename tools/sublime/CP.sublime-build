{
  "file_patterns": ["*.cp"],
  "selector": "source.cp",
  "variants": [
    {
      "name": "编译运行 (VM)",
      "cmd": ["C:/cplang/build/cplang.exe", "-c", "$file"],
      "working_dir": "$file_path",
      "file_regex": "第([0-9]+)行第([0-9]+)列: (.*)"
    },
    {
      "name": "语法检查",
      "cmd": ["C:/cplang/build/cplang.exe", "-p", "$file"],
      "working_dir": "$file_path",
      "file_regex": "第([0-9]+)行第([0-9]+)列: (.*)"
    },
    {
      "name": "JIT 编译运行",
      "cmd": ["C:/cplang/build/cplang.exe", "-j", "$file"],
      "working_dir": "$file_path"
    },
    {
      "name": "热点 JIT",
      "cmd": ["C:/cplang/build/cplang.exe", "-c", "--hotspot", "$file"],
      "working_dir": "$file_path"
    },
    {
      "name": "AOT 编译为 EXE",
      "cmd": ["C:/cplang/build/cplang.exe", "-a", "-o", "${file/\\.cp/\\.exe}", "$file"],
      "working_dir": "$file_path"
    },
    {
      "name": "调试运行",
      "cmd": ["powershell", "-ExecutionPolicy", "Bypass", "-File", "C:/cplang/tools/sublime/cp_debug.ps1", "$file"],
      "working_dir": "$file_path",
      "shell": true
    }
  ]
}
