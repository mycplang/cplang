namespace path {

static std::string getStr(const Value& v) {
    if (!v.isString()) return "";
    return std::string(v.asString()->data, v.asString()->length);
}

Value basename(std::vector<Value>& args) {
    if (args.empty() || !args[0].isString()) return Value::nil();
    std::string p = getStr(args[0]);
    // 鍘绘湯灏炬枩鏉?
    while (!p.empty() && (p.back() == '/' || p.back() == '\\')) p.pop_back();
    size_t pos = p.find_last_of("/\\");
    if (pos != std::string::npos) return makeStringVal(VMString::create(p.substr(pos + 1)));
    return makeStringVal(VMString::create(p));
}

Value dirname(std::vector<Value>& args) {
    if (args.empty() || !args[0].isString()) return Value::nil();
    std::string p = getStr(args[0]);
    while (!p.empty() && (p.back() == '/' || p.back() == '\\')) p.pop_back();
    size_t pos = p.find_last_of("/\\");
    if (pos != std::string::npos) return makeStringVal(VMString::create(p.substr(0, pos)));
    return makeStringVal(VMString::create("."));
}

Value extname(std::vector<Value>& args) {
    if (args.empty() || !args[0].isString()) return Value::nil();
    std::string p = getStr(args[0]);
    size_t slash = p.find_last_of("/\\");
    size_t dot = p.find_last_of('.');
    if (dot == std::string::npos || (slash != std::string::npos && dot < slash)) return makeStringVal(VMString::create(""));
    return makeStringVal(VMString::create(p.substr(dot)));
}

Value join(std::vector<Value>& args) {
    if (args.empty()) return makeStringVal(VMString::create(""));
    std::string out;
    for (size_t i = 0; i < args.size(); i++) {
        if (!args[i].isString()) continue;
        std::string part = getStr(args[i]);
        if (part.empty()) continue;
        if (!out.empty()) {
            char last = out.back();
            if (last != '/' && last != '\\' && part[0] != '/' && part[0] != '\\') out += '\\';
        }
        out += part;
    }
    return makeStringVal(VMString::create(out));
}

