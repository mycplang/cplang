Value tupGet(std::vector<Value>& args) {
    if (args.size() < 2 || !args[0].isTable() || !args[1].isInt()) return Value::nil();
    VMTable* t = args[0].asTable();
    Int32 idx = static_cast<Int32>(args[1].asInt());
    Int32 n = 0;
    Value sizeV = t->get(makeStringVal(VMString::create("_size")));
    if (sizeV.isInt()) n = static_cast<Int32>(sizeV.asInt());
    if (idx < 0) idx += n;
    if (idx < 0 || idx >= n) return Value::nil();
    char buf[32];
    snprintf(buf, sizeof(buf), "_%d", idx);
    return t->get(makeStringVal(VMString::create(buf)));
}

Value tupSize(std::vector<Value>& args) {
    if (args.empty() || !args[0].isTable()) return Value::Int(0);
    return args[0].asTable()->get(makeStringVal(VMString::create("_size")));
}

Value tupCat(std::vector<Value>& args) {
    if (args.size() < 2 || !args[0].isTable() || !args[1].isTable()) return Value::nil();
    VMTable* t1 = args[0].asTable();
    VMTable* t2 = args[1].asTable();
    Int32 n1 = 0, n2 = 0;
    Value sv = t1->get(makeStringVal(VMString::create("_size")));
    if (sv.isInt()) n1 = static_cast<Int32>(sv.asInt());
    sv = t2->get(makeStringVal(VMString::create("_size")));
    if (sv.isInt()) n2 = static_cast<Int32>(sv.asInt());
    
    auto t = VMTable::create();
    Int32 total = n1 + n2;
    t->set(makeStringVal(VMString::create("_size")), Value::Int(total));
    char buf[32];
    for (Int32 i = 0; i < n1; i++) {
        snprintf(buf, sizeof(buf), "_%d", i);
        t->set(makeStringVal(VMString::create(buf)),
            t1->get(makeStringVal(VMString::create(buf))));
    }
    for (Int32 i = 0; i < n2; i++) {
        snprintf(buf, sizeof(buf), "_%d", i);
        Value v = t2->get(makeStringVal(VMString::create(buf)));
        snprintf(buf, sizeof(buf), "_%d", n1 + i);
        t->set(makeStringVal(VMString::create(buf)), v);
    }
    return Value::Table(t);
}

Value tupSlice(std::vector<Value>& args) {
    if (args.empty() || !args[0].isTable()) return Value::nil();
    VMTable* src = args[0].asTable();
    Int32 n = 0;
    Value sv = src->get(makeStringVal(VMString::create("_size")));
    if (sv.isInt()) n = static_cast<Int32>(sv.asInt());
    
    Int32 start = 0, end = n;
    if (args.size() >= 2 && args[1].isInt()) start = static_cast<Int32>(args[1].asInt());
    if (args.size() >= 3 && args[2].isInt()) end = static_cast<Int32>(args[2].asInt());
    if (start < 0) start += n;
    if (end < 0) end += n;
    if (start < 0) start = 0;
    if (end > n) end = n;
    if (start >= end) start = end = 0;
    
    auto t = VMTable::create();
    Int32 sz = end - start;
    t->set(makeStringVal(VMString::create("_size")), Value::Int(sz));
    char buf[32];
    for (Int32 i = 0; i < sz; i++) {
        snprintf(buf, sizeof(buf), "_%d", start + i);
        Value v = src->get(makeStringVal(VMString::create(buf)));
        snprintf(buf, sizeof(buf), "_%d", i);
        t->set(makeStringVal(VMString::create(buf)), v);
    }
    return Value::Table(t);
}

