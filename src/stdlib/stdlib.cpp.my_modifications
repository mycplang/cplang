Value tupMake(std::vector<Value>& args) {
    auto t = VMTable::create();
    Int32 n = static_cast<Int32>(args.size());
    t->set(makeStringVal(VMString::create("_size")), Value::Int(n));
    char buf[32];
    for (Int32 i = 0; i < n; i++) {
