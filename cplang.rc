// CP Language 编译器资源文件
// 嵌入应用主图标

#include <windows.h>

// 应用主图标（资源 ID 1 = 默认应用图标）
1 ICON "icon\\app.ico"

// 版本信息
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "CP Language"
            VALUE "FileDescription",  "CP Language Compiler"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "cplang"
            VALUE "LegalCopyright",   "Copyright (C) 2025"
            VALUE "OriginalFilename", "cplang.exe"
            VALUE "ProductName",      "CP Language"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
