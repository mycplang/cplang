// ═══════════════════════════════════════════════════════════════
// @cp/http — CP HTTP 路由框架 v0.5.0
// ═══════════════════════════════════════════════════════════════
//
// 依赖: cplang v0.5.0+ (需要 服务.回调 C++ 桥接)
//
// 快速使用:
//   导入 "@cp/http"
//
//   变量 app = 路由.创建()
//
//   app:get("/", 函数(req)
//       返回 { status = 200, content_type = "text/html",
//               body = "<h1>你好 CP!</h1>" })
//
//   app:get("/api/users/:id", 函数(req)
//       变量 id = req.params["id"]
//       返回 { status = 200, content_type = "application/json",
//               body = jsonStringify({ id = id, name = "用户" + id }) })
//
//   app:post("/api/users", 函数(req)
//       变量 data = jsonParse(req.body)
//       返回 { status = 201,
//               body = jsonStringify({ created = data.name }) })
//
//   app:启动(8080)
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════
// 路由类型
// ═══════════════════════════════════════

类型 路由条目 = {
    方法,    // GET/POST/PUT/DELETE/PATCH
    模式,    // 如 "/api/users/:id"
    处理器,  // function(req) → {status, content_type, body}
};

类型 路由器 = {
    路由列表,   // 路由条目数组
    中间件列表, // 全局中间件数组
    端口,       // 监听端口
};

// ═══════════════════════════════════════
// 路由器 API
// ═══════════════════════════════════════

// 路由.创建() → 路由器
函数 创建() {
    变量 r = {
        路由列表 = [],
        中间件列表 = [],
        端口 = 0
    };
    返回 r;
}

// 注册路由（通用）
函数 注册(r, 方法, 模式, 处理器) {
    变量 条目 = {
        方法 = 方法,
        模式 = 模式,
        处理器 = 处理器
    };
    追加(r.路由列表, 条目);
    返回 r;
}

// 便捷方法
函数 get(r, 模式, 处理器)    { 返回 注册(r, "GET", 模式, 处理器); }
函数 post(r, 模式, 处理器)   { 返回 注册(r, "POST", 模式, 处理器); }
函数 put(r, 模式, 处理器)    { 返回 注册(r, "PUT", 模式, 处理器); }
函数 del(r, 模式, 处理器)    { 返回 注册(r, "DELETE", 模式, 处理器); }
函数 patch(r, 模式, 处理器)  { 返回 注册(r, "PATCH", 模式, 处理器); }

// 添加中间件
函数 中间件(r, 处理器) {
    追加(r.中间件列表, 处理器);
    返回 r;
}

// ═══════════════════════════════════════
// 路由匹配
// ═══════════════════════════════════════

// 匹配路径模式，提取路径参数
// "/api/users/:id" 匹配 "/api/users/123" → {params: {id: "123"}}
函数 匹配路径(模式, 路径) {
    变量 模式部分 = 分割字符串(模式, "/");
    变量 路径部分 = 分割字符串(路径, "/");
    
    如果 (长度(模式部分) != 长度(路径部分)) {
        返回 空;
    }
    
    变量 params = {};
    变量 i = 0;
    当 (i < 长度(模式部分)) {
        变量 p = 模式部分[i];
        如果 (子串(p, 0, 1) == ":") {
            // 动态参数
            变量 键 = 子串(p, 1, 长度(p) - 1);
            params[键] = 路径部分[i];
        } 否则 如果 (p != 路径部分[i]) {
            返回 空;
        }
        i = i + 1;
    }
    
    返回 params;
}

// 分割字符串
函数 分割字符串(s, 分隔符) {
    变量 结果 = [];
    变量 当前 = "";
    变量 i = 0;
    当 (i < 长度(s)) {
        变量 ch = 子串(s, i, 1);
        如果 (ch == 分隔符) {
            如果 (当前 != "") {
                追加(结果, 当前);
                当前 = "";
            }
        } 否则 {
            当前 = 当前 + ch;
        }
        i = i + 1;
    }
    如果 (当前 != "") {
        追加(结果, 当前);
    }
    返回 结果;
}

// ═══════════════════════════════════════
// 请求处理主入口
// ═══════════════════════════════════════

// 创建请求处理器回调（传给 服务.回调）
函数 创建处理器(r) {
    返回 函数(req) {
        // 1. 执行中间件链
        变量 i = 0;
        当 (i < 长度(r.中间件列表)) {
            变量 mw = r.中间件列表[i];
            变量 result = mw(req);
            如果 (result != 空) {
                返回 result;  // 中间件直接返回（短路由）
            }
            i = i + 1;
        }
        
        // 2. 匹配路由
        变量 method = req["method"];
        变量 path = req["path"];
        变量 j = 0;
        
        当 (j < 长度(r.路由列表)) {
            变量 route = r.路由列表[j];
            
            如果 (route.方法 == method || route.方法 == "ALL") {
                变量 params = 匹配路径(route.模式, path);
                如果 (params != 空) {
                    // 将路径参数注入请求
                    req["params"] = params;
                    
                    // 调用处理器
                    返回 route.处理器(req);
                }
            }
            j = j + 1;
        }
        
        // 3. 404
        返回 {
            status = 404,
            content_type = "text/plain; charset=utf-8",
            body = "404 Not Found: " + method + " " + path
        };
    };
}

// ═══════════════════════════════════════
// 启动
// ═══════════════════════════════════════

// r:启动(端口)
函数 启动(r, 端口) {
    r.端口 = 端口;
    变量 handler = 创建处理器(r);
    服务.回调(端口, handler);
    打印("HTTP 路由已启动: http://localhost:" + 转字符串(端口));
}

// ═══════════════════════════════════════
// 静态文件服务
// ═══════════════════════════════════════

函数 静态文件(端口, 目录) {
    服务.文件(端口, 目录);
}

// ═══════════════════════════════════════
// 辅助函数
// ═══════════════════════════════════════

函数 响应JSON(数据, 状态码) {
    如果 (状态码 == 空) { 状态码 = 200; }
    返回 {
        status = 状态码,
        content_type = "application/json; charset=utf-8",
        body = jsonStringify(数据)
    };
}

函数 响应HTML(html, 状态码) {
    如果 (状态码 == 空) { 状态码 = 200; }
    返回 {
        status = 状态码,
        content_type = "text/html; charset=utf-8",
        body = html
    };
}

函数 响应文本(文本, 状态码) {
    如果 (状态码 == 空) { 状态码 = 200; }
    返回 {
        status = 状态码,
        content_type = "text/plain; charset=utf-8",
        body = 文本
    };
}

函数 响应错误(消息, 状态码) {
    如果 (状态码 == 空) { 状态码 = 400; }
    返回 {
        status = 状态码,
        content_type = "application/json; charset=utf-8",
        body = jsonStringify({ error = 消息 })
    };
}