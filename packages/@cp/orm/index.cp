// ═══════════════════════════════════════════════════════════════
// @cp/orm — CP ORM 框架 v0.5.0
// ═══════════════════════════════════════════════════════════════
//
// 使用方式:
//   导入 "@cp/orm"
//   模型.定义("users", { id: "整数", name: "字符串", age: "整数" })
//   模型.创建("users", { name: "张三", age: 25 })
//   模型.查询("users").where("age > ?", [18]).all()
//   模型.更新("users", { age: 26 }).where("id = ?", [1]).执行()
//   模型.删除("users").where("id = ?", [1]).执行()
//
// 设计理念: 零依赖、纯CP实现、中文API优先、SQLite 内置支持
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════
// 模型定义
// ═══════════════════════════════════════

类型 模型定义 = {
    名称,           // 表名
    字段,           // 字段定义 { 字段名: 类型名 }
    主键,           // 主键字段名
    自动时间戳,     // 是否自动添加 created_at / updated_at
};

类型 查询构建器 = {
    表名,           // 表名
    选择字段,       // SELECT 字段列表
    条件列表,       // WHERE 条件列表
    条件参数,       // WHERE 参数值列表
    排序列表,       // ORDER BY 列表
    限制数量,       // LIMIT 数量
    偏移数量,       // OFFSET 数量
    连表列表,       // JOIN 列表
};

// ═══════════════════════════════════════
// 模型管理
// ═══════════════════════════════════════

变量 模型注册表 = {};

// 模型.定义(表名, 字段定义, 选项)
函数 模型定义(表名, 字段, 选项) {
    如果 (选项 == 空) {
        选项 = {};
    }
    
    变量 定义 = {
        名称: 表名,
        字段: 字段,
        主键: 表取(选项, "主键", "id"),
        自动时间戳: 表取(选项, "自动时间戳", 真)
    };
    
    模型注册表[表名] = 定义;
    
    // 自动建表
    变量 列定义 = [];
    遍历 (字段 的键值对) {
        变量 列名 = 键;
        变量 列类型 = 值;
        变量 sql类型 = 映射类型(列类型);
        追加(列定义, 列名 + " " + sql类型);
    }
    
    如果 (定义.自动时间戳) {
        追加(列定义, "created_at DATETIME DEFAULT CURRENT_TIMESTAMP");
        追加(列定义, "updated_at DATETIME DEFAULT CURRENT_TIMESTAMP");
    }
    
    变量 主键列 = 定义.主键;
    变量 sql = "CREATE TABLE IF NOT EXISTS " + 表名 + " (" +
               拼接(列定义, ", ") +
               ", PRIMARY KEY (" + 主键列 + "))";
    
    sqliteExec(sql);
    返回 定义;
}

// 映射 CP 类型到 SQLite 类型
函数 映射类型(类型名) {
    如果 (类型名 == "整数" || 类型名 == "int" || 类型名 == "i64") {
        返回 "INTEGER";
    }
    如果 (类型名 == "浮点" || 类型名 == "float" || 类型名 == "f64") {
        返回 "REAL";
    }
    如果 (类型名 == "字符串" || 类型名 == "string") {
        返回 "TEXT";
    }
    如果 (类型名 == "布尔" || 类型名 == "bool") {
        返回 "INTEGER";
    }
    返回 "TEXT";
}

// ═══════════════════════════════════════
// 查询构建器
// ═══════════════════════════════════════

// 模型.查询(表名) → 查询构建器
函数 查询(表名) {
    变量 qb = {
        表名: 表名,
        选择字段: ["*"],
        条件列表: [],
        条件参数: [],
        排序列表: [],
        限制数量: 0,
        偏移数量: 0,
        连表列表: []
    };
    返回 qb;
}

// qb.选择(字段列表)
函数 选择字段(qb, 字段) {
    qb.选择字段 = 字段;
    返回 qb;
}

// qb.where(条件, 参数)
函数 添加条件(qb, 条件, 参数) {
    追加(qb.条件列表, 条件);
    如果 (参数 != 空) {
        遍历 (参数 遍历 元素) {
            追加(qb.条件参数, 转字符串(元素));
        }
    }
    返回 qb;
}

// qb.排序(字段, 方向)
函数 添加排序(qb, 字段, 方向) {
    如果 (方向 == 空) { 方向 = "ASC"; }
    追加(qb.排序列表, 字段 + " " + 方向);
    返回 qb;
}

// qb.限制(数量)
函数 限制(qb, 数量) {
    qb.限制数量 = 数量;
    返回 qb;
}

// qb.偏移(数量)
函数 偏移(qb, 数量) {
    qb.偏移数量 = 数量;
    返回 qb;
}

// qb.连表(表名, 条件)
函数 连表(qb, 表名, 条件) {
    追加(qb.连表列表, { 表: 表名, 条件: 条件 });
    返回 qb;
}

// 构建 SQL 查询
function 构建查询(qb) {
    变量 sql = "SELECT " + 拼接(qb.选择字段, ", ") + " FROM " + qb.表名;
    
    // JOIN
    遍历 (qb.连表列表 遍历 连接) {
        sql = sql + " INNER JOIN " + 连接.表 + " ON " + 连接.条件;
    }
    
    // WHERE
    如果 (长度(qb.条件列表) > 0) {
        sql = sql + " WHERE " + 拼接(qb.条件列表, " AND ");
    }
    
    // ORDER BY
    如果 (长度(qb.排序列表) > 0) {
        sql = sql + " ORDER BY " + 拼接(qb.排序列表, ", ");
    }
    
    // LIMIT
    如果 (qb.限制数量 > 0) {
        sql = sql + " LIMIT " + qb.限制数量;
    }
    
    // OFFSET
    如果 (qb.偏移数量 > 0) {
        sql = sql + " OFFSET " + qb.偏移数量;
    }
    
    返回 sql;
}

// qb.全部() → 结果数组
function 全部(qb) {
    变量 sql = 构建查询(qb);
    返回 sqliteQuery(sql);
}

// qb.首个() → 单条结果
function 首个(qb) {
    qb.限制(1);
    变量 结果 = 全部(qb);
    如果 (长度(结果) > 0) {
        返回 结果[0];
    }
    返回 空;
}

// qb.计数() → 数量
function 计数(qb) {
    变量 原字段 = qb.选择字段;
    qb.选择字段 = ["COUNT(*) as cnt"];
    变量 结果 = 全部(qb);
    qb.选择字段 = 原字段;
    
    如果 (长度(结果) > 0 && 表有(结果[0], "cnt")) {
        返回 整数(结果[0]["cnt"]);
    }
    返回 0;
}

// ═══════════════════════════════════════
// CRUD 操作
// ═══════════════════════════════════════

// 模型.创建(表名, 数据)
function 创建(表名, 数据) {
    变量 列 = [];
    变量 值 = [];
    
    遍历 (数据 的键值对) {
        追加(列, 键);
        变量 原始值 = 值;
        如果 (类型(原始值) == "string") {
            追加(值, "'" + 替换(原始值, "'", "''") + "'");
        } 否则 {
            追加(值, 转字符串(原始值));
        }
    }
    
    变量 sql = "INSERT INTO " + 表名 + " (" + 拼接(列, ", ") + ") VALUES (" + 拼接(值, ", ") + ")";
    sqliteExec(sql);
    
    // 返回最后插入的ID
    变量 结果 = sqliteQuery("SELECT last_insert_rowid() as id");
    如果 (长度(结果) > 0 && 表有(结果[0], "id")) {
        返回 整数(结果[0]["id"]);
    }
    返回 0;
}

// 模型.更新(表名, 数据) → 查询构建器
function 更新(表名, 数据) {
    变量 赋值列表 = [];
    
    遍历 (数据 的键值对) {
        变量 原始值 = 值;
        如果 (类型(原始值) == "string") {
            追加(赋值列表, 键 + " = '" + 替换(原始值, "'", "''") + "'");
        } 否则 {
            追加(赋值列表, 键 + " = " + 转字符串(原始值));
        }
    }
    
    变量 qb = {
        表名: 表名,
        选择字段: [],
        条件列表: [],
        条件参数: [],
        排序列表: [],
        限制数量: 0,
        偏移数量: 0,
        连表列表: [],
        赋值列表: 赋值列表  // 扩展字段
    };
    返回 qb;
}

// qb.执行() → 受影响行数
function 执行(qb) {
    如果 (长度(qb.赋值列表) > 0) {
        // UPDATE 语句
        变量 sql = "UPDATE " + qb.表名 + " SET " + 拼接(qb.赋值列表, ", ");
        
        如果 (长度(qb.条件列表) > 0) {
            sql = sql + " WHERE " + 拼接(qb.条件列表, " AND ");
        }
        
        sqliteExec(sql);
        返回 真;
    }
    
    // DELETE 语句
    变量 sql = "DELETE FROM " + qb.表名;
    
    如果 (长度(qb.条件列表) > 0) {
        sql = sql + " WHERE " + 拼接(qb.条件列表, " AND ");
    }
    
    sqliteExec(sql);
    返回 真;
}

// 模型.删除(表名) → 查询构建器
function 删除(表名) {
    变量 qb = {
        表名: 表名,
        选择字段: [],
        条件列表: [],
        条件参数: [],
        排序列表: [],
        限制数量: 0,
        偏移数量: 0,
        连表列表: [],
        赋值列表: []
    };
    返回 qb;
}

// ═══════════════════════════════════════
// v0.5.0: 事务支持
// ═══════════════════════════════════════

// 模型.开始事务()
function 开始事务() {
    sqliteExec("BEGIN TRANSACTION");
    返回 真;
}

// 模型.提交()
function 提交() {
    sqliteExec("COMMIT");
    返回 真;
}

// 模型.回滚()
function 回滚() {
    sqliteExec("ROLLBACK");
    返回 真;
}

// 模型.事务(回调) — 自动事务包装
//   模型.事务(函数()
//       模型.创建("users", { name = "张三" })
//       模型.创建("users", { name = "李四" })
//       返回 真  -- 返回真则提交，返回假则回滚
//   )
function 事务(回调) {
    开始事务();
    变量 ok = 回调();
    如果 (ok) {
        提交();
    } 否则 {
        回滚();
    }
    返回 ok;
}

// ═══════════════════════════════════════
// v0.5.0: 批量操作
// ═══════════════════════════════════════

// 模型.批量创建(表名, 数据数组)
function 批量创建(表名, 数据数组) {
    如果 (长度(数据数组) == 0) { 返回 0; }
    
    变量 列 = [];
    遍历 (数据数组[0] 的键值对) {
        追加(列, 键);
    }
    
    变量 sql = "INSERT INTO " + 表名 + " (" + 拼接(列, ", ") + ") VALUES ";
    变量 值行列表 = [];
    
    遍历 (数据数组 遍历 行) {
        变量 值列表 = [];
        遍历 (列 遍历 列名) {
            变量 原始值 = 行[列名];
            如果 (类型(原始值) == "string") {
                追加(值列表, "'" + 替换(原始值, "'", "''") + "'");
            } 否则 {
                追加(值列表, 转字符串(原始值));
            }
        }
        追加(值行列表, "(" + 拼接(值列表, ", ") + ")");
    }
    
    sql = sql + 拼接(值行列表, ", ");
    sqliteExec(sql);
    
    变量 结果 = sqliteQuery("SELECT changes() as cnt");
    如果 (长度(结果) > 0 && 表有(结果[0], "cnt")) {
        返回 整数(结果[0]["cnt"]);
    }
    返回 长度(数据数组);
}

// 模型.批量更新(表名, 条件, 数据) — 批量更新满足条件的行
function 批量更新(表名, 条件, 数据) {
    变量 赋值列表 = [];
    遍历 (数据 的键值对) {
        变量 原始值 = 值;
        如果 (类型(原始值) == "string") {
            追加(赋值列表, 键 + " = '" + 替换(原始值, "'", "''") + "'");
        } 否则 {
            追加(赋值列表, 键 + " = " + 转字符串(原始值));
        }
    }
    
    变量 sql = "UPDATE " + 表名 + " SET " + 拼接(赋值列表, ", ") + " WHERE " + 条件;
    sqliteExec(sql);
    
    变量 结果 = sqliteQuery("SELECT changes() as cnt");
    如果 (长度(结果) > 0 && 表有(结果[0], "cnt")) {
        返回 整数(结果[0]["cnt"]);
    }
    返回 0;
}

// ═══════════════════════════════════════
// 迁移与工具
// ═══════════════════════════════════════

// 模型.迁移(表名, 新字段)
function 迁移(表名, 新字段) {
    遍历 (新字段 的键值对) {
        变量 列名 = 键;
        变量 列类型 = 映射类型(值);
        sqliteExec("ALTER TABLE " + 表名 + " ADD COLUMN " + 列名 + " " + 列类型);
    }
    返回 真;
}

// 模型.删除表(表名) — 危险操作！
function 删除表(表名) {
    sqliteExec("DROP TABLE IF EXISTS " + 表名);
    返回 真;
}

// 模型.列出表() → 表名数组
function 列出表() {
    返回 sqliteQuery("SELECT name FROM sqlite_master WHERE type='table'");
}