# ============================================
# CP Language — Git 忽略规则
# ============================================

# --- 系统文件（误捕获） ---
%SystemDrive%/

# --- 构建产物 ---
/build/
/build_llvm/
# 第三方构建目录
/third_party/raylib/build_release/
/third_party/raylib/build/
/build_cmake*/
/build_clang/
/artifacts/
/workspace_artifacts/
*.exe
*.lib
*.exp
*.obj
*.pdb
*.ilk
*.sbr
*.o
*.a
*.so
*.dylib

# --- LLVM 开发 ---
/llvm-dev/
/llvm-dev.tar*

# --- IDE / 编辑器 ---
.vscode/
*.vsix
tools/electron-ide/
tools/vscode-cp/node_modules/
*.suo
*.user
*.wsp

# --- DeepSeek TUI（独立工具） ---
/deepseek-tui/

# --- 包注册表（独立仓库） ---
/registry/

# --- 开发工具脚本（内部使用） ---
/_tools/

# --- 临时文件（通用模式，避免逐个列举） ---
/tmp/
*.tmp
*.bak
*.my_modifications
*_err.txt
*_out.txt
*_debug.txt
*_log.txt
*_raw.bin
*_last.bin
*_diag.txt
*_full.txt
*_dbg.txt
*_verbose.txt
build_log.txt
build_log_err.txt
*.dat
*.bin

# --- 以下划线前缀的临时文件 ---
_[a-z]*.cmd
_[a-z]*.bat
_[a-z]*.ps1
_[a-z]*.txt
_[a-z]*.bin
_[a-z]*.exe
_[a-z]*.dat
_[a-z]*.cp

# --- 上传缓存 ---
/.uploads/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- 凭据 ---
.git-credentials*
push_to_github.bat

# --- 测试临时文件 ---
_test_fs_dir/
tests/_t*.cp
tests/_tmp*.cp
tests/_tbind*.cp
tests/_tmysql*.cp
tests/_tpg.cp
examples/*.exe

# --- 数据目录 ---
/data/
/data_admin/
/mysql-tmp/
/pg-tmp/

# --- 工具二进制 ---
/tools/cplang.exe
/tools/__pycache__/

# --- 图标源文件（非源码） ---
/icon/

# --- 第三方库编译产物 ---
third_party/raylib/src/*.obj
third_party/raylib/src/*.lib
third_party/raylib/src/*.o
third_party/raylib/src/*.a

# --- 压缩包 / 数据库文件 ---
*.zip
*.tar
*.tar.gz
*.tar.xz
*.7z
*.rar
*.iso

# --- DLL（第三方运行时） ---
/libmysql.dll
/libpq.dll

# --- 历史存档（已纳入版本控制） ---
