# ============================================
# CP Language — Git 忽略规则
# ============================================

# --- 系统文件 ---
%SystemDrive%/
.DS_Store
Thumbs.db
desktop.ini

# --- 构建产物 ---
/build/
/build_llvm/
/build_aot/
/build_msvc/
/build_clang/
/build_linux/
/build_android/
/build_cmake*/
/workspace_artifacts/
/artifacts/
/third_party/raylib/build_release/
/third_party/raylib/build/
/third_party/raylib/build_vs/
/third_party/raylib/src/*.obj
/third_party/raylib/src/*.lib
third_party/raylib/src/*.o
third_party/raylib/src/*.a

# --- 模块构建产物（源码会被追踪） ---
modules/*/win-x64/
*.exe
*.lib
*.exp
*.obj
*.pdb
*.ilk
*.sbr
*.o
*.a
*.so
*.dylib

# --- LLVM 开发包 ---
/llvm-dev/
/llvm-dev.tar*

# --- IDE / 编辑器 ---
.vscode/
*.vsix
tools/electron-ide/
tools/vscode-cp/node_modules/
*.suo
*.user
*.wsp

# --- 工具目录 ---
/deepseek-tui/
/registry/
/_tools/
/tools/cplang.exe
/tools/__pycache__/

# --- 临时文件 ---
/tmp/
*.tmp
*.bak
*.my_modifications
*_err.txt
*_out.txt
*_debug.txt
*_log.txt
*_raw.bin
*_last.bin
*_diag.txt
*_full.txt
*_dbg.txt
*_verbose.txt
build_log.txt
build_log_err.txt
*.dat
*.bin

# --- 以下划线开头的临时文件 ---
_[a-z]*.cmd
_[a-z]*.bat
_[a-z]*.ps1
_[a-z]*.txt
_[a-z]*.bin
_[a-z]*.exe
_[a-z]*.dat
_[a-z]*.cp

# --- 上传缓存 ---
/.uploads/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/

# --- 凭据 ---
.git-credentials*
push_to_github.bat

# --- 测试临时文件 ---
_test_fs_dir/
tests/_t*.cp
tests/_tmp*.cp
tests/_tbind*.cp
tests/_tmysql*.cp
tests/_tpg.cp
examples/*.exe
imgui.ini
aot_debug.log

# --- 数据目录 ---
/data/
/data_admin/
/mysql-tmp/
/pg-tmp/

# --- 图标文件 ---
/icon/

# --- 压缩包/数据库 ---
*.zip
*.tar
*.tar.gz
*.tar.xz
*.7z
*.rar
*.iso

# --- DLL（第三方运行时） ---
/libmysql.dll
/libpq.dll
